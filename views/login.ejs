<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Login - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<body>
    <div class="zr-authpage">
        <div class="zr-authpage__glow" aria-hidden="true"></div>

        <%- include('partials/shell/theme-toggle', { extraClass: 'zr-authpage__theme' }) %>

        <section class="zr-authcard" aria-labelledby="loginTitle">
            <header class="zr-authcard__head">
                <img src="/mascot-animated.svg" class="zr-authcard__mascot no-invert" alt="">
                <span class="zr-wordmark">Zettelrobbe</span>
                <h1 id="loginTitle" class="zr-authcard__title">
                    <%= mfaRequired ? 'Verify your identity' : 'Welcome back' %>
                </h1>
                <p class="zr-sm zr-muted">
                    <%= mfaRequired
                        ? 'Enter the code from your authenticator app to finish signing in.'
                        : 'Sign in to continue processing your documents.' %>
                </p>
            </header>

            <% if (typeof loginCookieSecurityWarning === 'string' && loginCookieSecurityWarning) { %>
                <div class="zr-alert zr-alert--warn" role="alert">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                    <div class="zr-alert__body">
                        <div class="zr-alert__title">Connection warning</div>
                        <p class="zr-sm"><%= loginCookieSecurityWarning %></p>
                        <p class="zr-sm">
                            <a href="https://zettelrob.be/getting-started/configuration/#cookie-and-proxy-flags-all-supported-values"
                                target="_blank" rel="noopener noreferrer" class="zr-link zr-link--underline">Cookie and proxy flags documentation</a>
                        </p>
                    </div>
                </div>
            <% } %>

            <% const isMfaStep = !!mfaRequired; %>
            <% const prefilledUsername = typeof username === 'string' ? username : ''; %>

            <form class="zr-col zr-col--loose" action="/login" method="POST" id="loginForm" data-login-form>
                <% if (typeof csrfToken !== 'undefined') { %>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>
                <input type="hidden" name="mfaStep" id="mfaStep" value="<%= isMfaStep ? '1' : '0' %>">
                <input type="hidden" name="theme" id="themePreference" value="<%= theme || 'light' %>">

                <div class="zr-steppane <%= isMfaStep ? '' : 'is-active' %>" data-step="credentials"
                    aria-hidden="<%= isMfaStep ? 'true' : 'false' %>">
                    <div class="zr-field zr-field--stacked">
                        <label for="username" class="zr-field__name">Username</label>
                        <input id="username" name="username" type="text" class="zr-input"
                            <%= isMfaStep ? '' : 'required' %>
                            placeholder="Enter your username" autocomplete="username"
                            value="<%= prefilledUsername %>">
                    </div>

                    <div class="zr-field zr-field--stacked">
                        <label for="password" class="zr-field__name">Password</label>
                        <input id="password" name="password" type="password" class="zr-input"
                            <%= isMfaStep ? '' : 'required' %>
                            placeholder="Enter your password" autocomplete="current-password">
                    </div>
                </div>

                <div class="zr-steppane <%= isMfaStep ? 'is-active' : '' %>" data-step="mfa"
                    aria-hidden="<%= isMfaStep ? 'false' : 'true' %>">
                    <div class="zr-field zr-field--stacked">
                        <label for="mfaToken" class="zr-field__name">Authentication code</label>
                        <input id="mfaToken" name="mfaToken" type="text" inputmode="numeric" class="zr-input"
                            placeholder="6-digit code" autocomplete="one-time-code"
                            <%= isMfaStep ? 'required' : '' %>>
                        <p class="zr-field__hint">From the authenticator app you paired with this account.</p>
                    </div>
                </div>

                <% if (error) { %>
                    <div class="zr-alert zr-alert--danger" role="alert">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                        <div class="zr-alert__body">
                            <p><%= error %></p>
                            <% if (typeof error === 'string' && error.includes('Invalid CSRF token')) { %>
                                <p class="zr-sm">
                                    <a href="https://zettelrob.be/getting-started/configuration/#cookie-and-proxy-flags-all-supported-values"
                                        target="_blank" rel="noopener noreferrer" class="zr-link zr-link--underline">Cookie and proxy flags documentation</a>
                                </p>
                            <% } %>
                            <% if (mfaRequired) { %>
                                <p class="zr-sm">
                                    <a href="https://zettelrob.be/getting-started/troubleshooting/#mfa-lockout-recovery"
                                        target="_blank" rel="noopener noreferrer" class="zr-link zr-link--underline">MFA troubleshooting guide</a>
                                </p>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <div class="zr-col">
                    <button type="submit" class="zr-btn zr-btn--primary zr-btn--lg zr-btn--block login-submit"
                        id="submitButton" data-submit-button>
                        <span class="submit-idle">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-login"/></svg>
                            <span><%= isMfaStep ? 'Verify and continue' : 'Sign in' %></span>
                        </span>
                        <span class="submit-loading" aria-hidden="true">
                            <svg class="zr-icon zr-icon--sm zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                            <span><%= isMfaStep ? 'Verifying…' : 'Signing in…' %></span>
                        </span>
                    </button>

                    <button type="button" class="zr-btn zr-btn--ghost login-back-button <%= isMfaStep ? '' : 'hidden' %>"
                        data-back-button>
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-arrow-left"/></svg>
                        Back to credentials
                    </button>
                </div>
            </form>

            <% const ssoButton = typeof sso === 'object' && sso ? sso : { enabled: false }; %>
            <% if (ssoButton.enabled && !isMfaStep) { %>
                <div class="zr-col login-sso" data-login-sso>
                    <div class="login-sso__divider zr-sm"><span>or</span></div>
                    <a href="/auth/oidc/login" id="ssoButton"
                        class="zr-btn zr-btn--lg zr-btn--block login-sso__button"
                        <% if (ssoButton.style) { %>style="<%= ssoButton.style %>"<% } %>>
                        <% if (ssoButton.icon.type === 'image') { %>
                            <img class="login-sso__icon" src="<%= ssoButton.icon.src %>" alt="" aria-hidden="true">
                        <% } else if (ssoButton.icon.type === 'default') { %>
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                        <% } %>
                        <span><%= ssoButton.text %></span>
                    </a>
                </div>
            <% } %>
        </section>
    </div>

    <script type="module" src="/js/zr.js"></script>
    <script src="/js/login.js" defer></script>
</body>
</html>
