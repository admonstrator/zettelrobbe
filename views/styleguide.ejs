                                    <span class="zr-tokenbar__key"><span class="zr-tokenbar__dot zr-tokenbar__dot--answer"></span>6k answer</span>
                                    <span class="zr-tokenbar__key"><span class="zr-tokenbar__dot zr-tokenbar__dot--thinking"></span>8k thinking</span>
                                </div>
                                <span class="zr-tokenbar__limit">200k limit</span>
                            </div>
                        </div>
