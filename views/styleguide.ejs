<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Styleguide - Zettelrobbe' }) %>
    <%# window.zrDialog lives in this classic script; the settings and setup pages load it the same way. %>
    <script src="/js/dialogs.js"></script>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Styleguide',
    version: typeof version !== 'undefined' ? version : ''
}) %>

<div class="zr-viewhead">
    <h2 class="zr-viewhead__title">Framework reference</h2>
    <p class="zr-viewhead__sub">
        Every zr component the framework ships, rendered once with the markup the app actually uses.
        Look here before writing a new class. Development build only — this page is not registered in production.
    </p>
</div>

<div class="zr-settings">
    <aside class="zr-only-desktop">
        <nav class="zr-sectionnav" data-module="section-nav">
            <a href="#sg-buttons" aria-current="true">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-grip"/></svg>
                Buttons
            </a>
            <a href="#sg-badges">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-tag"/></svg>
                Badges &amp; chips
            </a>
            <a href="#sg-forms">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                Forms
            </a>
            <a href="#sg-alerts">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                Alerts
            </a>
            <a href="#sg-progress">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-activity"/></svg>
                Meter &amp; spinner
            </a>
            <a href="#sg-review">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                Review surfaces
            </a>
            <a href="#sg-toasts">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-comment"/></svg>
                Toasts
            </a>
            <a href="#sg-dialogs">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-layers"/></svg>
                Dialogs
            </a>
            <a href="#sg-modules">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-panel"/></svg>
                Modules &amp; grid
            </a>
            <a href="#sg-charts">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trend-up"/></svg>
                Charts
            </a>
            <a href="#sg-tables">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-database"/></svg>
                Tables
            </a>
            <a href="#sg-auth">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-login"/></svg>
                Auth &amp; steps
            </a>
            <a href="#sg-actionbar">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                Action bar
            </a>
        </nav>
    </aside>

    <div>
        <!-- ── buttons ─────────────────────────────────────────────────── -->
        <section class="zr-module" id="sg-buttons">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Buttons</h3>
                <span class="zr-module__meta">css/buttons.css</span>
            </div>
            <div class="zr-module__body zr-col zr-col--loose">
                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Variants</span>
                    <div class="zr-row zr-row--wrap">
                        <button type="button" class="zr-btn">Default</button>
                        <button type="button" class="zr-btn zr-btn--primary">Primary</button>
                        <button type="button" class="zr-btn zr-btn--danger">Danger</button>
                        <button type="button" class="zr-btn zr-btn--ghost">Ghost</button>
                        <button type="button" class="zr-btn zr-btn--icon" aria-label="More actions">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-dots"/></svg>
                        </button>
                        <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" aria-label="Close">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                        </button>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">With an icon</span>
                    <div class="zr-row zr-row--wrap">
                        <button type="button" class="zr-btn zr-btn--primary">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-play"/></svg>
                            Start scan
                        </button>
                        <button type="button" class="zr-btn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                            Refresh
                        </button>
                        <button type="button" class="zr-btn zr-btn--danger">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                            Delete
                        </button>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Sizes and states</span>
                    <div class="zr-row zr-row--wrap">
                        <button type="button" class="zr-btn">Base, 30px</button>
                        <button type="button" class="zr-btn zr-btn--lg">Large, 36px</button>
                        <button type="button" class="zr-btn" disabled>Disabled</button>
                        <button type="button" class="zr-btn zr-btn--primary" disabled>Disabled primary</button>
                    </div>
                    <button type="button" class="zr-btn zr-btn--primary zr-btn--lg zr-btn--block">Block</button>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Button bar</span>
                    <p class="zr-sm zr-muted">
                        <code class="zr-mono">.zr-btnbar</code> becomes a grid below 860px. With
                        <code class="zr-mono">data-module="toolbar-menu"</code> the buttons move into one popover
                        instead; the empty <code class="zr-mono">.zr-grow</code> spacer becomes the separator.
                    </p>
                    <div class="zr-row zr-row--wrap zr-btnbar" data-module="toolbar-menu">
                        <button type="button" class="zr-btn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                            Rescan selected
                        </button>
                        <button type="button" class="zr-btn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-filter"/></svg>
                            Refresh filters
                        </button>
                        <span class="zr-grow"></span>
                        <button type="button" class="zr-btn zr-btn--danger">Reset selected</button>
                        <button type="button" class="zr-btn zr-btn--danger">Reset all</button>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Segmented control</span>
                    <div class="zr-row">
                        <div class="zr-segment" id="sgSegment">
                            <button type="button" aria-selected="true">Day</button>
                            <button type="button" aria-selected="false">Week</button>
                            <button type="button" aria-selected="false">Month</button>
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Icons</span>
                    <div class="zr-row zr-row--wrap">
                        <span class="zr-row"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-file"/></svg> sm, 14px</span>
                        <span class="zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-file"/></svg> base, 16px</span>
                        <span class="zr-row"><svg class="zr-icon zr-icon--lg" aria-hidden="true"><use href="/icons.svg#i-file"/></svg> lg, 20px</span>
                        <span class="zr-row"><svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> spin</span>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Links</span>
                    <p class="zr-sm zr-muted">
                        <a href="#sg-buttons" class="zr-link">.zr-link</a> underlines on hover,
                        <a href="#sg-buttons" class="zr-link zr-link--underline">.zr-link--underline</a> always —
                        the second is for links inside a paragraph.
                    </p>
                </div>
            </div>
        </section>

        <!-- ── badges, dots, chips ─────────────────────────────────────── -->
        <section class="zr-module" id="sg-badges">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Badges, dots and chips</h3>
                <span class="zr-module__meta">css/badges.css</span>
            </div>
            <div class="zr-module__body zr-col zr-col--loose">
                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Badges</span>
                    <div class="zr-row zr-row--wrap">
                        <span class="zr-badge">Neutral</span>
                        <span class="zr-badge zr-badge--ok">Processed</span>
                        <span class="zr-badge zr-badge--warn">Queued</span>
                        <span class="zr-badge zr-badge--danger">Failed</span>
                        <span class="zr-badge zr-badge--info">Update</span>
                        <span class="zr-badge zr-badge--brand">Brand</span>
                        <span class="zr-badge zr-badge--ok">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                            With icon
                        </span>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Status dots</span>
                    <p class="zr-sm zr-muted">
                        Semantic tones plus the eight categorical chart colours — the donut and bar list hand out a
                        tone name and the dot class follows it mechanically.
                    </p>
                    <div class="zr-row zr-row--wrap">
                        <span class="zr-row"><span class="zr-dot"></span> default</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--ok"></span> ok</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--warn"></span> warn</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--danger"></span> danger</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--info"></span> info</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--brand"></span> brand</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--text-faint"></span> text-faint</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--live"></span> live</span>
                    </div>
                    <div class="zr-row zr-row--wrap">
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-1"></span> cat-1</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-2"></span> cat-2</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-3"></span> cat-3</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-4"></span> cat-4</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-5"></span> cat-5</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-6"></span> cat-6</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-7"></span> cat-7</span>
                        <span class="zr-row"><span class="zr-dot zr-dot--cat-8"></span> cat-8</span>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Chips</span>
                    <div class="zr-chips">
                        <div class="zr-chip">
                            <span>invoice</span>
                            <button type="button" class="zr-link" aria-label="Remove invoice">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                            </button>
                        </div>
                        <div class="zr-chip">
                            <span>household</span>
                            <button type="button" class="zr-link" aria-label="Remove household">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                            </button>
                        </div>
                        <div class="zr-chip">
                            <span>tax-2026</span>
                            <button type="button" class="zr-link" aria-label="Remove tax-2026">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Text utilities</span>
                    <div class="zr-row zr-row--wrap">
                        <span>base</span>
                        <span class="zr-sm">.zr-sm</span>
                        <span class="zr-xs">.zr-xs</span>
                        <span class="zr-strong">.zr-strong</span>
                        <span class="zr-muted">.zr-muted</span>
                        <span class="zr-faint">.zr-faint</span>
                        <span class="zr-ok-text">.zr-ok-text</span>
                        <span class="zr-warn-text">.zr-warn-text</span>
                        <span class="zr-danger-text">.zr-danger-text</span>
                        <span class="zr-mono">.zr-mono</span>
                        <span class="zr-num">1 234 567</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── forms ───────────────────────────────────────────────────── -->
        <section class="zr-module" id="sg-forms">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Form fields</h3>
                <span class="zr-module__meta">css/forms.css</span>
            </div>
            <div class="zr-module__body zr-col zr-col--loose">
                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Label column — .zr-field</span>
                    <div>
                        <div class="zr-field">
                            <div class="zr-field__label">
                                <span class="zr-field__name">Scan interval</span>
                                <span class="zr-field__hint">Cron syntax. Applies on the next tick.</span>
                                <span class="zr-field__env">SCAN_INTERVAL</span>
                            </div>
                            <div class="zr-field__control">
                                <input type="text" class="zr-input zr-input--mono" value="*/30 * * * *">
                            </div>
                        </div>
                        <div class="zr-field" data-dirty>
                            <div class="zr-field__label">
                                <span class="zr-field__name">Token limit</span>
                                <span class="zr-field__hint">An edited field is marked until it is saved.</span>
                            </div>
                            <div class="zr-field__control">
                                <input type="number" class="zr-input" value="128000">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Stacked — .zr-field--stacked</span>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgInput" class="zr-field__name">Paperless API URL</label>
                        <input id="sgInput" type="text" class="zr-input" placeholder="https://paperless.example.com/api">
                        <p class="zr-field__hint">The base URL including <code class="zr-mono">/api</code>.</p>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgSelect" class="zr-field__name">AI provider</label>
                        <select id="sgSelect" class="zr-select">
                            <option>openai</option>
                            <option>ollama</option>
                            <option>custom</option>
                            <option>azure</option>
                        </select>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgTextarea" class="zr-field__name">System prompt</label>
                        <textarea id="sgTextarea" class="zr-textarea">You are a document analyst. Return JSON only.</textarea>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgGroupInput" class="zr-field__name">Tag</label>
                        <div class="zr-inputgroup">
                            <input id="sgGroupInput" type="text" class="zr-input" placeholder="Enter a tag and press Enter">
                            <button type="button" class="zr-btn zr-btn--primary">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                Add
                            </button>
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Validation and disabled states</span>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgValid" class="zr-field__name">API token</label>
                        <input id="sgValid" type="text" class="zr-input zr-input--valid zr-input--mono" value="tok_live_9f3a…">
                        <p class="zr-field__hint zr-ok-text">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                            Connected as admin.
                        </p>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgInvalid" class="zr-field__name">Custom base URL</label>
                        <input id="sgInvalid" type="text" class="zr-input zr-input--invalid" value="htp://localhost:1234/v1">
                        <p class="zr-field__hint zr-danger-text">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-alert-circle"/></svg>
                            Not a valid URL. The colour never carries the meaning on its own.
                        </p>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <label for="sgDisabled" class="zr-field__name">Pinned by the operator</label>
                        <input id="sgDisabled" type="text" class="zr-input" value="ollama" disabled>
                        <p class="zr-field__hint">Set through the environment, so the form cannot change it.</p>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <span class="zr-field__name">Reported value — .zr-input--static</span>
                        <div class="zr-inputgroup">
                            <div class="zr-input zr-input--static zr-grow">https://paperless.example.com/api/documents/</div>
                            <button type="button" class="zr-btn">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                Refresh
                            </button>
                        </div>
                        <p class="zr-field__hint">Nobody types this one — the page reports it. It keeps the field box so it lines up with the button, and grows instead of clipping.</p>
                    </div>
                    <div class="zr-field zr-field--stacked">
                        <span class="zr-field__name">Masked key — .zr-apikey</span>
                        <div class="zr-input zr-mono zr-apikey" tabindex="0">zr_4f1c9b0e7a2d5843bc6188e07a2d5843bc6199f31c9b0e7a2d5843bc6104e7a2d5843bc6199f31c9b0e</div>
                        <p class="zr-field__hint">Blurred until hovered or focused. One line: a key too long for the box ends in an ellipsis rather than outside it.</p>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Two-column grid — .zr-formgrid</span>
                    <div class="zr-formgrid">
                        <div class="zr-field zr-field--stacked">
                            <label for="sgGridA" class="zr-field__name">Host</label>
                            <input id="sgGridA" type="text" class="zr-input" value="localhost">
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="sgGridB" class="zr-field__name">Port</label>
                            <input id="sgGridB" type="number" class="zr-input" value="11434">
                        </div>
                        <div class="zr-field zr-field--stacked zr-formgrid__wide">
                            <label for="sgGridC" class="zr-field__name">Full row — .zr-formgrid__wide</label>
                            <input id="sgGridC" type="text" class="zr-input zr-input--wide" value="http://localhost:11434">
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Tick — .zr-check</span>
                    <p class="zr-sm zr-muted">Selecting rows. The third box is set to indeterminate by the page script.</p>
                    <div class="zr-row zr-row--wrap">
                        <label class="zr-row"><input type="checkbox" class="zr-check"> unchecked</label>
                        <label class="zr-row"><input type="checkbox" class="zr-check" checked> checked</label>
                        <label class="zr-row"><input type="checkbox" class="zr-check" id="sgIndeterminate"> indeterminate</label>
                        <label class="zr-row"><input type="checkbox" class="zr-check" disabled> disabled</label>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Switch — .zr-toggle</span>
                    <p class="zr-sm zr-muted">Turning something on or off. Rows that get selected keep <code class="zr-mono">.zr-check</code>.</p>
                    <div class="zr-row zr-row--wrap">
                        <input type="checkbox" class="zr-toggle" aria-label="Off">
                        <input type="checkbox" class="zr-toggle" checked aria-label="On">
                        <input type="checkbox" class="zr-toggle" disabled aria-label="Disabled off">
                        <input type="checkbox" class="zr-toggle" checked disabled aria-label="Disabled on">
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Switch row — .zr-switchrow</span>
                    <div class="zr-switchrow">
                        <div class="zr-grow">
                            <label for="sgSwitchRow" class="zr-field__name">Disable automatic processing</label>
                            <p class="zr-field__hint">Scans are not processed by AI automatically · ENV: DISABLE_AUTOMATIC_PROCESSING</p>
                        </div>
                        <input type="checkbox" class="zr-toggle" id="sgSwitchRow" checked>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Check tiles — .zr-checktile</span>
                    <div class="zr-formgrid">
                        <label for="sgTileA" class="zr-checktile">
                            <input type="checkbox" id="sgTileA" class="zr-check" checked>
                            <span>Restrict to existing tags</span>
                        </label>
                        <label for="sgTileB" class="zr-checktile">
                            <input type="checkbox" id="sgTileB" class="zr-check">
                            <span>Restrict to existing correspondents</span>
                        </label>
                        <label for="sgTileC" class="zr-checktile">
                            <span>Tag assignment</span>
                            <input type="checkbox" id="sgTileC" class="zr-toggle" checked>
                        </label>
                        <label for="sgTileD" class="zr-checktile">
                            <span>Title generation</span>
                            <input type="checkbox" id="sgTileD" class="zr-toggle">
                        </label>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── alerts ──────────────────────────────────────────────────── -->
        <section class="zr-module" id="sg-alerts">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Alerts</h3>
                <span class="zr-module__meta">css/feedback.css</span>
            </div>
            <div class="zr-module__body zr-col">
                <div class="zr-alert zr-alert--info">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
                    <div class="zr-alert__body">
                        <p class="zr-sm">History is reconciled automatically. To run it by hand, go to
                            <a href="/settings#troubleshooting-tab" class="zr-link">Settings &rarr; Maintenance</a>.</p>
                    </div>
                </div>
                <div class="zr-alert zr-alert--ok">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                    <div class="zr-alert__body">
                        <div class="zr-alert__title">Connection verified</div>
                        <p class="zr-sm">Paperless-ngx answered in 84 ms.</p>
                    </div>
                </div>
                <div class="zr-alert zr-alert--warn" role="alert">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                    <div class="zr-alert__body">
                        <div class="zr-alert__title">Connection warning</div>
                        <p class="zr-sm">The login cookie cannot be marked Secure over plain HTTP.</p>
                    </div>
                </div>
