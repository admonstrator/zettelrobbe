                <div class="zr-col zr-col--tight">
                    <span class="zr-label">One decision</span>
                    <div class="zr-decision">
                        <div class="zr-decision__head">
                            <span class="zr-badge">Correspondent</span>
                            <span class="zr-badge zr-badge--info">Found by the model</span>
