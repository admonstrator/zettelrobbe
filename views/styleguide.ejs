        <section class="zr-module" id="sg-actionbar">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Sticky action bar</h3>
                <span class="zr-module__meta">css/modules.css</span>
            </div>
            <div class="zr-module__body zr-col">
                <p class="zr-sm zr-muted">
                    The settings save row. It sticks to the bottom of its scroll container and turns brand-coloured
                    while there are unsaved changes; below 860px it docks onto the tab bar.
                </p>
                <div class="zr-actionbar" data-dirty="true">
                    <span class="zr-actionbar__status">3 unsaved changes</span>
                    <button type="button" class="zr-btn">Discard</button>
                    <button type="button" class="zr-btn zr-btn--primary">
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                        Save
                    </button>
                </div>
            </div>
        </section>
    </div>
</div>

<dialog class="zr-dialog" id="sgStaticDialog" aria-labelledby="sgStaticDialogTitle">
    <div class="zr-dialog__head">
        <span class="zr-badge zr-badge--info">
            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
        </span>
        <span class="zr-grow" id="sgStaticDialogTitle">Tag details</span>
        <button class="zr-btn zr-btn--ghost zr-btn--icon" type="button" data-sg-close-dialog aria-label="Close">
            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
        </button>
    </div>
    <div class="zr-dialog__body zr-prose">
        <p>The dashboard fills this body over fetch. Head, body and foot are the three slots.</p>
        <ul>
            <li><code>.zr-dialog__head</code> lays out its own contents</li>
            <li><code>.zr-dialog__foot</code> right-aligns its buttons</li>
            <li><code>.zr-dialog--wide</code> widens it to 600px, for content that sets its own line
                length — the OCR run log uses it</li>
        </ul>
    </div>
    <div class="zr-dialog__foot">
        <button class="zr-btn" type="button" data-sg-close-dialog>Close</button>
        <button class="zr-btn zr-btn--primary" type="button" data-sg-close-dialog>Got it</button>
    </div>
</dialog>

<script src="/js/styleguide.js"></script>
<%- include('partials/shell/body-close') %>
