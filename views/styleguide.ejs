                                        <div class="zr-meter__fill zr-meter__fill--ok" style="width: 16%"></div>
                                    </div>
                                </div>
                                <div class="zr-barrow">
                                    <span class="zr-barrow__label">French</span>
                                    <span class="zr-barrow__value">24</span>
                                    <div class="zr-meter zr-barrow__track">
                                        <div class="zr-meter__fill zr-meter__fill--warn" style="width: 3%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </section>

        <!-- ── tables ──────────────────────────────────────────────────── -->
        <section class="zr-module" id="sg-tables">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Tables</h3>
                <span class="zr-module__meta">css/tables.css · js/modules/data-table.js</span>
            </div>
            <div class="zr-module__body zr-col zr-col--loose">
                <p class="zr-sm zr-muted">
                    Two mechanisms, one look on a phone. <code class="zr-mono">createTable()</code> renders a second
                    copy of every row as a card; pages that render rows themselves add
                    <code class="zr-mono">.zr-table--stack</code> plus a <code class="zr-mono">data-label</code> per
                    cell and the table stacks into the same cards without duplicating the DOM.
                </p>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Full host — toolbar, table, foot</span>
                    <div class="zr-module zr-table-host" data-module="row-menu">
                        <div class="zr-table-toolbar">
                            <div class="zr-table-search">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                <input class="zr-input" type="search" placeholder="Search…" aria-label="Search">
                            </div>
                            <div class="zr-grow"></div>
                            <label class="zr-row zr-sm zr-faint">
                                Rows
                                <select class="zr-select" aria-label="Rows per page">
                                    <option>10</option>
                                    <option selected>25</option>
                                    <option>50</option>
                                    <option>100</option>
                                </select>
                            </label>
                        </div>
                        <div class="zr-table-wrap">
                            <table class="zr-table zr-table--stack">
                                <thead>
                                    <tr>
                                        <th style="width: 1%"><input type="checkbox" class="zr-check" aria-label="Select all"></th>
                                        <th class="zr-th-sortable" data-dir="desc" tabindex="0" role="button">Doc ID<span class="zr-th-arrow" aria-hidden="true"></span></th>
                                        <th class="zr-th-sortable" tabindex="0" role="button">Title<span class="zr-th-arrow" aria-hidden="true"></span></th>
                                        <th>Source</th>
                                        <th>Updated</th>
                                        <th class="zr-table__actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td data-label=""><input type="checkbox" class="zr-check" aria-label="Select row 1281"></td>
                                        <td data-label="Doc ID">1281</td>
                                        <td data-label="Title" class="zr-truncate">Utility statement August 2026 — a title long enough to need the ellipsis</td>
                                        <td data-label="Source"><span class="zr-warn-text">OCR</span></td>
                                        <td data-label="Updated" class="zr-table__date">2026-08-12 06:41</td>
                                        <td data-label="" class="zr-table__actions">
                                            <div class="zr-row">
                                                <button type="button" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg>
                                                    Reset
                                                </button>
                                                <button type="button" class="zr-btn"
                                                    popovertarget="sgRowMenu" title="More actions" aria-haspopup="menu">
                                                    <span>Actions</span>
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                                </button>
                                                <div id="sgRowMenu" popover class="zr-menu">
                                                    <button type="button" class="zr-menu__item">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-external"/></svg>
                                                        Open in Paperless
                                                    </button>
                                                    <button type="button" class="zr-menu__item">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
                                                        Show OCR output
                                                    </button>
                                                    <div class="zr-menu__sep"></div>
                                                    <button type="button" class="zr-menu__item zr-menu__item--danger">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                                        Remove from queue
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td data-label=""><input type="checkbox" class="zr-check" aria-label="Select row 1280" checked></td>
                                        <td data-label="Doc ID">1280</td>
                                        <td data-label="Title" class="zr-truncate">Insurance policy renewal — household</td>
                                        <td data-label="Source">AI</td>
                                        <td data-label="Updated" class="zr-table__date">2026-08-11 18:12</td>
                                        <td data-label="" class="zr-table__actions">
                                            <div class="zr-row">
                                                <button type="button" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg>
                                                    Reset
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="zr-table-foot">
                            <span class="zr-sm zr-faint">1–2 of 1 284</span>
                            <div class="zr-row">
                                <button type="button" class="zr-btn zr-btn--icon" aria-label="Previous page" disabled>
                                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-left"/></svg>
                                </button>
                                <span class="zr-sm zr-num">1 / 52</span>
                                <button type="button" class="zr-btn zr-btn--icon" aria-label="Next page">
                                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Card list — what data-table.js writes into .zr-table-cards</span>
                    <p class="zr-sm zr-muted">
                        Hidden above 860px by the framework, so it is shown here inside a plain panel to make the
                        shape visible on a desktop as well.
                    </p>
                    <div class="zr-panel zr-col">
                        <article class="zr-table-card">
                            <div class="zr-table-card__row">
                                <span class="zr-table-card__label">Doc ID</span>
                                <span class="zr-table-card__value">1281</span>
                            </div>
                            <div class="zr-table-card__row">
                                <span class="zr-table-card__label">Title</span>
                                <span class="zr-table-card__value">Utility statement August 2026</span>
                            </div>
                            <div class="zr-table-card__row">
                                <span class="zr-table-card__label"></span>
                                <span class="zr-table-card__value">
                                    <button type="button" class="zr-btn">Reset</button>
                                </span>
                            </div>
                        </article>
                    </div>
                </div>

                <div class="zr-col zr-col--tight">
                    <span class="zr-label">Loading and empty rows</span>
                    <div class="zr-module">
                        <div class="zr-table-wrap">
                            <table class="zr-table zr-table--stack">
                                <thead>
                                    <tr><th>Doc ID</th><th>Title</th><th>Reason</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="3" class="zr-empty">
                                            <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            Loading permanently failed queue…
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="zr-module">
                        <div class="zr-table-wrap">
                            <table class="zr-table zr-table--stack">
                                <thead>
                                    <tr><th>Doc ID</th><th>Title</th><th>Reason</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td colspan="3" class="zr-empty zr-danger-text">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                                            Could not load the queue.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── auth card and step panes ────────────────────────────────── -->
        <section class="zr-module" id="sg-auth">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Auth card and step panes</h3>
                <span class="zr-module__meta">css/pages/auth.css</span>
            </div>
            <div class="zr-module__body zr-col zr-col--loose">
                <p class="zr-sm zr-muted">
                    The login page renders <code class="zr-mono">.zr-authcard</code> inside a full-screen
                    <code class="zr-mono">.zr-authpage</code>; the card is shown here on its own.
                    <code class="zr-mono">.zr-steppane</code> is shared with the setup wizard — only the pane
                    carrying <code class="zr-mono">.is-active</code> is displayed.
                </p>

                <section class="zr-authcard" aria-labelledby="sgLoginTitle">
                    <header class="zr-authcard__head">
                        <img src="/mascot-animated.svg" class="zr-authcard__mascot no-invert" alt="">
                        <span class="zr-wordmark">Zettelrobbe</span>
                        <h4 id="sgLoginTitle" class="zr-authcard__title">Welcome back</h4>
                        <p class="zr-sm zr-muted">Sign in to continue processing your documents.</p>
                    </header>

                    <div class="zr-alert zr-alert--danger" role="alert">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                        <div class="zr-alert__body">
                            <p>Invalid username or password.</p>
                        </div>
                    </div>

                    <form class="zr-col zr-col--loose" id="sgLoginForm">
                        <div class="zr-steppane is-active" data-step="credentials">
                            <div class="zr-field zr-field--stacked">
                                <label for="sgUsername" class="zr-field__name">Username</label>
                                <input id="sgUsername" type="text" class="zr-input" placeholder="Enter your username"
                                    autocomplete="off">
                            </div>
                            <div class="zr-field zr-field--stacked">
                                <label for="sgPassword" class="zr-field__name">Password</label>
                                <input id="sgPassword" type="password" class="zr-input" placeholder="Enter your password"
                                    autocomplete="off">
                            </div>
                        </div>

                        <div class="zr-steppane" data-step="mfa" id="sgMfaPane">
                            <div class="zr-field zr-field--stacked">
                                <label for="sgMfaToken" class="zr-field__name">Authentication code</label>
                                <input id="sgMfaToken" type="text" inputmode="numeric" class="zr-input"
                                    placeholder="6-digit code" autocomplete="off">
                                <p class="zr-field__hint">From the authenticator app you paired with this account.</p>
                            </div>
                        </div>

                        <div class="zr-col">
                            <button type="submit" class="zr-btn zr-btn--primary zr-btn--lg zr-btn--block">Sign in</button>
                            <button type="button" class="zr-btn zr-btn--ghost login-back-button" id="sgTogglePane">
                                Toggle the second step pane
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        </section>

        <!-- ── quick start rows ────────────────────────────────────────── -->
        <section class="zr-module" id="sg-quick-start">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Quick start rows</h3>
                <span class="zr-module__meta">css/pages/settings.css</span>
            </div>
            <div class="zr-module__body zr-col">
                <p class="zr-sm zr-muted">
                    The decisions of the settings Quick start: one row per step, the mark says done
                    (<code>data-state="done"</code>), open, <code>problem</code> or <code>skipped</code>; the row
                    is a button with <code>aria-expanded</code> and opens its controls in place. On the settings
                    page each control mirrors a real field (<code>data-mirror</code>) and carries no
                    <code>name</code>; <code>js/modules/settings-quick-start.js</code> keeps both in step.
                    Here the rows are static.
                </p>
                <div class="zr-qs">
                    <div class="zr-module zr-qs__list">
                        <div class="zr-qs__step" data-state="done">
                            <h3 class="zr-qs__heading">
                                <button type="button" class="zr-qs__toggle" aria-expanded="false">
                                    <span class="zr-qs__mark" aria-hidden="true">
                                        <svg class="zr-icon zr-icon--sm zr-qs__icon zr-qs__icon--done"><use href="/icons.svg#i-check"/></svg>
                                        <span class="zr-qs__number">1</span>
                                    </span>
                                    <span class="zr-qs__text">
                                        <span class="zr-qs__title">Paperless-ngx</span>
                                        <span class="zr-qs__summary">http://paperless:8000 · user admin · connected</span>
                                    </span>
                                    <span class="zr-qs__action">Change</span>
                                </button>
                            </h3>
                        </div>
                        <div class="zr-qs__step zr-qs__step--open" data-state="open" data-dirty>
                            <h3 class="zr-qs__heading">
                                <button type="button" class="zr-qs__toggle" aria-expanded="true" aria-controls="sgQuickStartBody">
                                    <span class="zr-qs__mark" aria-hidden="true">
                                        <span class="zr-qs__number">2</span>
                                    </span>
                                    <span class="zr-qs__text">
                                        <span class="zr-qs__title">What the AI fills in</span>
                                        <span class="zr-qs__summary">Nothing switched on</span>
                                    </span>
                                    <span class="zr-qs__dirty"><span class="zr-sr">Unsaved changes.</span></span>
                                    <span class="zr-qs__action">Close</span>
                                </button>
                            </h3>
                            <div class="zr-qs__body" id="sgQuickStartBody">
                                <div class="zr-qs__switches">
                                    <div class="zr-qs__field zr-qs__switch">
                                        <div class="zr-qs__switchtext">
                                            <label for="sgQuickStartTitle" class="zr-field__name">Title</label>
                                            <p class="zr-field__hint">A title from the content instead of the file name.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="sgQuickStartTitle">
                                    </div>
                                    <div class="zr-qs__field zr-qs__switch">
                                        <div class="zr-qs__switchtext">
                                            <label for="sgQuickStartTags" class="zr-field__name">Tags</label>
                                            <p class="zr-field__hint">Set by the environment (ACTIVATE_TAGGING).</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="sgQuickStartTags" disabled>
                                    </div>
                                </div>
                                <p class="zr-qs__more"><a class="zr-link zr-link--underline" href="#sg-quick-start">All options in Restrictions and limits</a></p>
                            </div>
                        </div>
                        <div class="zr-qs__step" data-state="skipped">
                            <h3 class="zr-qs__heading">
                                <button type="button" class="zr-qs__toggle" aria-expanded="false">
                                    <span class="zr-qs__mark" aria-hidden="true">
                                        <span class="zr-qs__number">3</span>
                                    </span>
                                    <span class="zr-qs__text">
                                        <span class="zr-qs__title">OCR for scans <span class="zr-badge">Optional</span></span>
                                        <span class="zr-qs__summary">Off</span>
                                    </span>
                                    <span class="zr-qs__action">Change</span>
                                </button>
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── action bar ──────────────────────────────────────────────── -->
        <section class="zr-module" id="sg-actionbar">
            <div class="zr-module__head">
                <h3 class="zr-module__title">Save bar</h3>
                <span class="zr-module__meta">css/modules.css</span>
            </div>
            <div class="zr-module__body zr-col">
                <p class="zr-sm zr-muted">
                    The settings save bar. It is a row of the page layout under the region that scrolls, there only while a change
                    is not saved, so it never lies over the form. It counts the changed settings and names them by their labels,
                    cut with an ellipsis (the whole list stays in the text and in the title), and says when saving restarts
                    Zettelrobbe. On a phone it sits on the tab bar and steps aside while the on-screen keyboard is open.
                </p>
                <div class="zr-actionbar" role="region" aria-label="Unsaved changes" style="--zr-actionbar-measure: 720px">
                    <div class="zr-actionbar__inner">
                        <div class="zr-actionbar__status">
                            <p class="zr-actionbar__title">
                                <span>3 unsaved changes</span>
                                <span class="zr-badge zr-badge--warn">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                    Restart needed
                                </span>
                            </p>
                            <p class="zr-actionbar__list" title="Custom fields, Remove the inbox tags, Scan schedule (cron)">Custom fields, Remove the inbox tags, Scan schedule (cron)</p>
                        </div>
                        <div class="zr-actionbar__actions">
                            <button type="button" class="zr-btn">Discard</button>
                            <button type="button" class="zr-btn zr-btn--primary">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                Save settings
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
</div>

<dialog class="zr-dialog" id="sgStaticDialog" aria-labelledby="sgStaticDialogTitle">
    <div class="zr-dialog__head">
        <span class="zr-badge zr-badge--info">
            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
        </span>
        <span class="zr-grow" id="sgStaticDialogTitle">Tag details</span>
        <button class="zr-btn zr-btn--ghost zr-btn--icon" type="button" data-sg-close-dialog aria-label="Close">
            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
        </button>
    </div>
    <div class="zr-dialog__body zr-prose">
        <p>The dashboard fills this body over fetch. Head, body and foot are the three slots.</p>
        <ul>
            <li><code>.zr-dialog__head</code> lays out its own contents</li>
            <li><code>.zr-dialog__foot</code> right-aligns its buttons</li>
            <li><code>.zr-dialog--wide</code> widens it to 600px, for content that sets its own line
                length — the OCR run log uses it</li>
        </ul>
    </div>
    <div class="zr-dialog__foot">
        <button class="zr-btn" type="button" data-sg-close-dialog>Close</button>
        <button class="zr-btn zr-btn--primary" type="button" data-sg-close-dialog>Got it</button>
    </div>
</dialog>

<script src="/js/styleguide.js"></script>
<%- include('partials/shell/body-close') %>
