<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Initial Setup - Zettelrobbe' }) %>
<script src="/js/dialogs.js"></script>
<%- include('partials/shell/head-end') %>
<body>
    <div class="zr-setup">
        <header class="zr-setup__head">
            <img src="/logo.png" class="zr-rail__logo no-invert" alt="">
            <span class="zr-wordmark">Zettelrobbe</span>
            <span class="zr-badge">Initial setup</span>
            <span class="zr-topbar__spacer"></span>
            <%- include('partials/shell/theme-toggle') %>
        </header>

        <% if (typeof success === 'string' && success) { %>
            <div class="zr-alert zr-alert--ok">
                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                <div class="zr-alert__body"><p><%= success %></p></div>
            </div>
        <% } %>
        <% if (typeof error === 'string' && error) { %>
            <div class="zr-alert zr-alert--danger">
                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                <div class="zr-alert__body"><p><%= error %></p></div>
            </div>
        <% } %>

        <div class="zr-setup__body">
            <aside class="zr-setup__aside">
                <div class="zr-col zr-col--tight" style="margin-bottom: var(--zr-3)">
                    <div id="setupStepLabel" class="zr-sm zr-strong" aria-live="polite">Step 1 of 7: Admin account</div>
                    <div id="setupProgressBar" class="zr-meter" role="progressbar"
                         aria-label="Setup progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div id="setupProgressFill" class="zr-meter__fill" style="width: 0%;"></div>
                    </div>
                </div>

                <div class="zr-stepper">
                    <button class="zr-step" type="button" data-step-marker data-status="active">
                        <span class="zr-step__marker">
                            <span data-marker-text>1</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">Admin account</span>
                            <span class="zr-step__hint">Username and password</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>2</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">Two-factor auth</span>
                            <span class="zr-step__hint">Optional</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>3</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">Paperless connection</span>
                            <span class="zr-step__hint">URL, token, test</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>4</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">Document scope</span>
                            <span class="zr-step__hint">Metadata and tags</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>5</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">AI provider</span>
                            <span class="zr-step__hint">Model and API key</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>6</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">OCR fallback</span>
                            <span class="zr-step__hint">Optional</span>
                        </span>
                    </button>
                    <button class="zr-step" type="button" data-step-marker data-status="todo">
                        <span class="zr-step__marker">
                            <span data-marker-text>7</span>
                            <svg class="zr-icon zr-icon--sm" data-marker-check hidden><use href="/icons.svg#i-check"/></svg>
                        </span>
                        <span class="zr-col zr-col--tight" style="gap: 0">
                            <span class="zr-step__name">Review and finish</span>
                            <span class="zr-step__hint">Confirm and start</span>
                        </span>
                    </button>
                </div>

                <div class="zr-alert zr-alert--info zr-only-desktop" style="margin-top: var(--zr-4)">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
                    <div class="zr-alert__body">
                        <p class="zr-sm">Everything here maps to an environment variable and can be changed
                        later under Settings.</p>
                    </div>
                </div>
            </aside>

            <section class="zr-module zr-setup__panel" aria-labelledby="setupStepLabel">
                <form id="setupWizardForm" class="zr-module__body zr-col zr-col--loose" novalidate>
                <section class="zr-steppane is-active" data-step-index="0" data-step-title="Admin account">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg> Admin account</h3>
                    <p class="zr-sm zr-muted">Create the initial Zettelrobbe administrator account.</p>

                    <div class="zr-formgrid">
                        <div class="zr-field zr-field--stacked zr-formgrid__wide">
                            <label for="adminUsername" class="zr-field__name">Username</label>
                            <input id="adminUsername" name="adminUsername" type="text" class="zr-input" required autocomplete="username">
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="adminPassword" class="zr-field__name">Password</label>
                            <input id="adminPassword" name="adminPassword" type="password" class="zr-input" required autocomplete="new-password" minlength="8">
                            <p id="passwordHint" class="zr-field__hint">Use at least 8 characters.</p>
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="confirmPassword" class="zr-field__name">Confirm password</label>
                            <input id="confirmPassword" name="confirmPassword" type="password" class="zr-input" required autocomplete="new-password" minlength="8">
                        </div>
                    </div>
                </section>

                <section class="zr-steppane" data-step-index="1" data-step-title="Two-factor auth">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg> Multi-factor authentication (MFA)</h3>
                    <p class="zr-sm zr-muted">Would you like to enable MFA for the admin account?</p>

                    <div class="zr-field zr-field--stacked">
                        <label for="enableMfa" class="zr-field__name">Enable MFA</label>
                        <select id="enableMfa" name="enableMfa" class="zr-input">
                            <option value="no">No</option>
                            <option value="yes">Yes</option>
                        </select>
                    </div>

                    <div id="mfaSetupPanel" class="zr-col zr-col--loose hidden">
                        <button type="button" id="startMfaSetupBtn" class="zr-btn">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-qr"/></svg>
                            Generate QR code
                        </button>

                        <div id="mfaProvisioningBox" class="setup-provisioning hidden">
                            <div class="zr-col">
                                <div class="setup-qr-box">
                                    <img id="setupMfaQrImage" class="hidden no-invert" alt="MFA setup QR code">
                                </div>
                                <div class="zr-grow zr-col">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="setupMfaSecret" class="zr-field__name">Secret key</label>
                                        <input id="setupMfaSecret" type="text" class="zr-input" readonly>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="setupMfaCode" class="zr-field__name">Authenticator code</label>
                                        <div class="zr-inputgroup">
                                            <input id="setupMfaCode" type="text" inputmode="numeric" autocomplete="one-time-code" class="zr-input" placeholder="Enter 6-digit code">
                                            <button type="button" id="confirmMfaCodeBtn" class="zr-btn">Confirm</button>
                                        </div>
                                        <p id="mfaStatusHint" class="zr-field__hint"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="zr-steppane" data-step-index="2" data-step-title="Paperless connection">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-link"/></svg> Paperless-ngx connection</h3>
                    <p class="zr-sm zr-muted">Enter your Paperless-ngx API credentials and run a connectivity test.</p>

                    <div class="zr-formgrid">
                        <div class="zr-field zr-field--stacked zr-formgrid__wide">
                            <label for="paperlessUrl" class="zr-field__name">Paperless-ngx API URL</label>
                            <input id="paperlessUrl" name="paperlessUrl" type="text" class="zr-input" placeholder="http://your-paperless-instance:8000" required value="<%= config.PAPERLESS_API_URL || '' %>">
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="paperlessUsername" class="zr-field__name">Paperless username</label>
                            <input id="paperlessUsername" name="paperlessUsername" type="text" class="zr-input" required value="<%= config.PAPERLESS_USERNAME || '' %>">
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="paperlessToken" class="zr-field__name">API token</label>
                            <input id="paperlessToken" name="paperlessToken" type="password" class="zr-input" required value="<%= config.PAPERLESS_API_TOKEN || '' %>">
                        </div>
                    </div>

                    <div class="zr-row zr-row--wrap">
                        <button type="button" id="testPaperlessBtn" class="zr-btn">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-plug"/></svg>
                            Test Paperless connection
                        </button>
                        <span id="paperlessTestState" class="zr-badge">Not tested</span>
                    </div>
                </section>

                <section class="zr-steppane" data-step-index="3" data-step-title="Document scope">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-database"/></svg> Paperless metadata</h3>
                    <p class="zr-sm zr-muted">Statistics come straight from your Paperless-ngx instance. Choose which documents Zettelrobbe should work on.</p>

                    <div class="zr-row zr-row--wrap">
                        <span id="metadataLoadState" class="zr-badge">Waiting for the connection test</span>
                    </div>

                    <div class="zr-formgrid zr-formgrid--3">
                        <article class="zr-stat">
                            <p class="zr-stat__label">Documents</p>
                            <p id="documentsCount" class="zr-stat__value">-</p>
                        </article>
                        <article class="zr-stat">
                            <p class="zr-stat__label">Correspondents</p>
                            <p id="correspondentsCount" class="zr-stat__value">-</p>
                        </article>
                        <article class="zr-stat">
                            <p class="zr-stat__label">Tags</p>
                            <p id="tagsCount" class="zr-stat__value">-</p>
                        </article>
                    </div>

                    <div class="zr-col zr-col--loose">
                        <label class="zr-row">
                            <input id="scanAllDocuments" type="checkbox" class="zr-toggle">
                            <span>
                                <strong>Always scan all documents</strong>
                                <span class="zr-field__hint">If enabled, no include-tag filter is used.</span>
                            </span>
                        </label>

                        <!-- Hidden while "scan all documents" is on, since an
                             include filter has no effect in that mode. -->
                        <div id="includeTagsSection" class="zr-field zr-field--stacked">
                            <label for="includeTag" class="zr-field__name">Tags used to select documents for processing</label>
                            <div class="zr-inputgroup">
                                <input id="includeTag" type="text" class="zr-input" list="paperlessTagsDatalist" placeholder="Type a tag and press Enter">
                                <button type="button" id="addIncludeTagBtn" class="zr-btn zr-btn--primary">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                    Add
                                </button>
                            </div>
                            <p class="zr-field__hint">Press Enter to confirm a tag.</p>
                            <div id="includeTagsContainer" class="zr-chips"></div>
                        </div>

                        <div class="zr-field zr-field--stacked">
                            <label for="excludeTagInput" class="zr-field__name">Excluded tags</label>
                            <div class="zr-inputgroup">
                                <input id="excludeTagInput" type="text" class="zr-input" list="paperlessTagsDatalist" placeholder="Select a tag to exclude">
                                <button type="button" id="addExcludeTagBtn" class="zr-btn zr-btn--primary">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                    Add
                                </button>
                            </div>
                            <div id="excludeTagsContainer" class="zr-chips"></div>
                        </div>

                        <div class="zr-field zr-field--stacked">
                            <label for="processedTag" class="zr-field__name">Tag applied after Zettelrobbe finishes</label>
                            <div class="zr-inputgroup">
                                <input id="processedTag" type="text" class="zr-input" list="paperlessTagsDatalist" placeholder="e.g. ai-processed" value="<%= config.AI_PROCESSED_TAG_NAME || 'ai-processed' %>">
                            </div>
                            <p class="zr-field__hint">This tag is automatically added to excluded tags during setup finalization.</p>
                        </div>

                        <label class="zr-row">
                            <input id="removeInboxTagsAfterProcessing" type="checkbox" class="zr-toggle" <%= config.REMOVE_INBOX_TAGS_AFTER_PROCESSING === 'yes' ? 'checked' : '' %>>
                            <span>
                                <strong>Remove the inbox tag when a document is done</strong>
                                <span class="zr-field__hint">Paperless-ngx marks the tags it uses as inbox; every one of them is taken off a document once the analysis was written. Use it when you let the analysis file documents on its own.</span>
                            </span>
                        </label>

                        <div class="zr-formgrid">
                            <div class="zr-field zr-field--stacked">
                                <label for="automaticScanEnabled" class="zr-field__name">Automatic scanning</label>
                                <select id="automaticScanEnabled" class="zr-input">
                                    <option value="yes" <%= config.DISABLE_AUTOMATIC_PROCESSING === 'yes' ? '' : 'selected' %>>Yes</option>
                                    <option value="no" <%= config.DISABLE_AUTOMATIC_PROCESSING === 'yes' ? 'selected' : '' %>>No</option>
                                </select>
                            </div>
                            <div class="zr-field zr-field--stacked">
                                <label for="scanInterval" class="zr-field__name">Scan interval (cron)</label>
                                <input id="scanInterval" type="text" class="zr-input" value="<%= config.SCAN_INTERVAL || (defaults && defaults.scanInterval) || '*/30 * * * *' %>">
                            </div>
                        </div>
                    </div>

                    <datalist id="paperlessTagsDatalist"></datalist>
                </section>

                <section class="zr-steppane" data-step-index="4" data-step-title="AI provider">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-cpu"/></svg> AI access credentials</h3>
                    <p class="zr-sm zr-muted">Quickstart points at a local AI server and configures itself from the
                        models it finds. Switch to manual configuration for a hosted provider, or to enter the values
                        yourself.</p>

                    <div class="zr-row" role="group" aria-label="AI configuration mode">
                        <button type="button" id="aiModeQuickstartBtn" class="zr-btn setup-mode-btn" aria-pressed="true">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>
                            <span>Quickstart (auto-detect)</span>
                        </button>
                        <button type="button" id="aiModeManualBtn" class="zr-btn setup-mode-btn" aria-pressed="false">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-filter"/></svg>
                            <span>Manual configuration</span>
                        </button>
                    </div>

                    <!-- Open by default, matching the mode the wizard starts in,
                         so the panel does not flash into place after the script
                         runs. setAiConfigMode() owns both panels from then on. -->
                    <div id="aiQuickstartPanel" class="zr-col zr-col--loose">
                        <div class="zr-field zr-field--stacked">
                            <label for="quickstartBaseUrl" class="zr-field__name">AI server URL</label>
                            <input id="quickstartBaseUrl" type="text" class="zr-input" placeholder="http://192.168.1.5:1234">
                            <p class="zr-field__hint">Base URL of your LM Studio, Ollama, or OpenAI-compatible server — for example http://192.168.1.5:1234 or http://host:11434.</p>
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="quickstartApiKey" class="zr-field__name">API key (optional)</label>
                            <input id="quickstartApiKey" type="password" class="zr-input" placeholder="Only needed if your endpoint requires a token">
                        </div>
                        <div class="zr-row zr-row--wrap">
                            <button type="button" id="quickstartDetectBtn" class="zr-btn">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                <span>Detect models</span>
                            </button>
                            <span id="quickstartDetectState" class="zr-badge">Not detected</span>
                        </div>
                        <p id="quickstartHint" class="zr-field__hint hidden"></p>
                        <div class="zr-field zr-field--stacked">
                            <label for="quickstartAiModel" class="zr-field__name">Suggested AI model</label>
                            <select id="quickstartAiModel" class="zr-input" disabled>
                                <option value="">Run detection first</option>
                            </select>
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="quickstartOcrModel" class="zr-field__name">OCR model</label>
                            <select id="quickstartOcrModel" class="zr-input" disabled>
                                <option value="">Run detection first</option>
                            </select>
                        </div>
                        <div class="zr-row">
                            <input id="quickstartEnableOcr" type="checkbox" class="zr-toggle" disabled>
                            <label for="quickstartEnableOcr" class="zr-field__name">Use this service for OCR</label>
                        </div>
                        <p id="quickstartOcrHint" class="zr-field__hint hidden"></p>
                        <div class="zr-row hidden zr-row--wrap" id="quickstartSaveRow">
                            <button type="button" id="quickstartSaveBtn" class="zr-btn zr-btn--primary">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                <span>Test models &amp; finish setup</span>
                            </button>
                            <span class="zr-field__hint">Tests the selected models, then saves and restarts.</span>
                        </div>
                    </div>

                    <div id="aiManualPanel" class="hidden">
                        <div class="zr-formgrid">
                            <div class="zr-field zr-field--stacked zr-formgrid__wide">
                                <label for="aiPreset" class="zr-field__name">Provider preset</label>
                                <select id="aiPreset" class="zr-input"></select>
                                <p id="aiPresetHint" class="zr-field__hint"></p>
                            </div>
                            <div class="zr-field zr-field--stacked zr-formgrid__wide">
                                <label for="aiApiUrl" class="zr-field__name">API URL</label>
                                <input id="aiApiUrl" type="text" class="zr-input" required>
                                <p id="aiApiUrlHint" class="zr-field__hint hidden">Only for a proxy; leave empty for api.anthropic.com.</p>
                            </div>
                            <div class="zr-field zr-field--stacked zr-formgrid__wide">
                                <label for="aiToken" class="zr-field__name">API key</label>
                                <input id="aiToken" type="password" class="zr-input" placeholder="Enter token if required">
                                <p class="zr-field__hint">For Ollama and custom endpoints, this field can stay empty if the API does not require authentication.</p>
                            </div>
                            <div class="zr-field zr-field--stacked zr-formgrid__wide">
                                <label for="aiModel" class="zr-field__name">Model</label>
                                <div class="zr-inputgroup">
                                    <select id="aiModel" class="zr-input" required>
                                        <option value="">Select a model</option>
                                    </select>
                                    <button type="button" id="fetchAiModelsBtn" class="zr-btn">
                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                        <span>Fetch models</span>
                                    </button>
                                </div>
                            </div>
                            <div class="zr-field zr-field--stacked zr-formgrid__wide">
                                <label for="aiValidationTimeout" class="zr-field__name">Timeout</label>
                                <div class="zr-row">
                                    <input id="aiValidationTimeout" type="number" min="1" max="120" step="1" class="zr-input" value="30" required>
                                    <span class="zr-field__hint">seconds</span>
                                </div>
                                <p class="zr-field__hint">Used for model discovery and connection tests. Default: 30s.</p>
                            </div>
                        </div>
                    </div>

                    <input id="aiProvider" type="hidden">

                    <div class="zr-row zr-row--wrap">
                        <button type="button" id="testAiBtn" class="zr-btn">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                            Test AI connection
                        </button>
                        <span id="aiTestState" class="zr-badge">Not tested</span>
                    </div>
                </section>

                <section class="zr-steppane" data-step-index="5" data-step-title="OCR fallback">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-file"/></svg> OCR fallback</h3>
                    <p class="zr-sm zr-muted">Configure OCR fallback for documents where AI extraction needs OCR assistance.</p>

                    <div id="ocrQuickstartNotice" class="zr-alert zr-alert--ok hidden"></div>

                    <div class="zr-field zr-field--stacked">
                        <label for="mistralOcrEnabled" class="zr-field__name">Enable OCR</label>
                        <select id="mistralOcrEnabled" class="zr-input">
                            <option value="no" <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'selected' %>>No</option>
                            <option value="yes" <%= config.MISTRAL_OCR_ENABLED === 'yes' ? 'selected' : '' %>>Yes</option>
                        </select>
                    </div>

                    <div id="mistralFields" class="hidden zr-col zr-col--loose">
                        <div class="zr-field zr-field--stacked">
                            <label for="ocrProvider" class="zr-field__name">OCR provider</label>
                            <select id="ocrProvider" class="zr-input">
                                <option value="mistral" <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'selected' : '' %>>Mistral OCR API</option>
                                <option value="custom" <%= ((config.OCR_PROVIDER || 'mistral') === 'custom' || (config.OCR_PROVIDER || 'mistral') === 'ollama') ? 'selected' : '' %>>Custom (Ollama, LM Studio, local models)</option>
                                <option value="anthropic" <%= (config.OCR_PROVIDER || 'mistral') === 'anthropic' ? 'selected' : '' %>>Claude (Anthropic)</option>
                            </select>
                        </div>
                        <div id="ocrApiUrlContainer" class="zr-field zr-field--stacked">
                            <label for="ocrApiUrl" class="zr-field__name">OCR API URL (optional override)</label>
                            <input id="ocrApiUrl" type="text" class="zr-input" value="<%= config.OCR_API_URL || '' %>" placeholder="Leave empty to use provider default URL" data-placeholder-default="Leave empty to use provider default URL" data-placeholder-anthropic="Optional proxy URL">
                            <p id="ocrApiUrlHint" class="zr-field__hint">For custom provider, set URL to your local endpoint (e.g. Ollama or LM Studio /v1).</p>
                            <p id="ocrApiUrlAnthropicHint" class="zr-field__hint hidden">Only for a proxy; empty uses the Anthropic API URL of the AI provider, then api.anthropic.com.</p>
                        </div>
                        <div id="ocrApiKeyContainer" class="zr-field zr-field--stacked">
                            <label for="ocrApiKey" class="zr-field__name">OCR API key</label>
                            <input id="ocrApiKey" type="password" class="zr-input" placeholder="Required for Mistral" data-placeholder-default="Required for Mistral" data-placeholder-anthropic="Optional">
                            <p id="ocrApiKeyHint" class="zr-field__hint">Optional for local and custom OCR providers.</p>
                            <p id="ocrApiKeyAnthropicHint" class="zr-field__hint hidden">Empty uses the Anthropic API key from the AI provider.</p>
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="mistralOcrModel" class="zr-field__name">OCR model</label>
                            <div class="zr-inputgroup">
                                <select id="mistralOcrModel" class="zr-input">
                                    <option value="<%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %>" selected><%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %></option>
                                </select>
                                <button type="button" id="fetchOcrModelsBtn" class="zr-btn">
                                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                    <span>Fetch OCR models</span>
                                </button>
                            </div>
                            <p id="ocrModelVisionHint" class="zr-field__hint <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'hidden' : '' %>">Vision support is detected from the model name, so the list is grouped rather than filtered &middot; models outside the recommended group may still work</p>
                        </div>
                        <div class="zr-field zr-field--stacked">
                            <label for="ocrValidationTimeout" class="zr-field__name">OCR timeout</label>
                            <div class="zr-row">
                                <input id="ocrValidationTimeout" type="number" min="1" max="120" step="1" class="zr-input" value="30">
                                <span class="zr-field__hint">seconds</span>
                            </div>
                            <p class="zr-field__hint">Used for OCR model discovery, connection tests and document processing. Default: 30s.</p>
                        </div>
                        <div class="zr-row zr-row--wrap">
                            <button type="button" id="testOcrBtn" class="zr-btn">
                                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                <span>Test OCR connection</span>
                            </button>
                            <span id="ocrTestState" class="zr-badge">Not tested</span>
                        </div>
                    </div>
                </section>

                <section class="zr-steppane" data-step-index="6" data-step-title="Review and finish">
                    <h3 class="zr-module__title zr-row"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg> Review and finish</h3>
                    <p class="zr-sm zr-muted">Review generated environment keys, copy if needed, then finalize setup.</p>

                    <div class="zr-field zr-field--stacked">
                        <label for="envPreview" class="zr-field__name">For docker compose copy</label>
                        <textarea id="envPreview" class="zr-textarea" rows="12" readonly></textarea>
                    </div>

                    <div class="zr-row zr-row--wrap">
                        <button type="button" id="copyEnvPreviewBtn" class="zr-btn">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                            Copy to clipboard
                        </button>
                        <button type="button" id="finalizeSetupBtn" class="zr-btn zr-btn--primary">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check"/></svg>
                            Save and restart container
                        </button>
                    </div>
                </section>

                </form>

                <div class="zr-module__foot">
                    <div class="zr-row zr-row--between">
                        <button type="button" id="prevStepBtn" class="zr-btn" disabled>
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-arrow-left"/></svg>
                            Back
                        </button>
                        <button type="button" id="nextStepBtn" class="zr-btn zr-btn--primary">
                            Continue
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-arrow-right"/></svg>
                        </button>
                    </div>
                </div>
            </section>
        </div>
    </div>

    <%- include('partials/model-test-overlay') %>

    <script>
        window.__SETUP_BOOTSTRAP__ = <%- JSON.stringify({
            config: config || {},
            defaults: defaults || {},
            aiProviderPresets: Array.isArray(aiProviderPresets) ? aiProviderPresets : [],
            anthropic: (typeof anthropicOptions !== 'undefined' && anthropicOptions) || {}
        }).replace(/</g, '\\u003c') %>;
    </script>
    <script type="module" src="/js/zr.js"></script>
    <script src="/js/setup.js" defer></script>
</body>
</html>
