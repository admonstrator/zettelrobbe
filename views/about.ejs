<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'About - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'About',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false
}) %>
            <%
                const shortSha = /^[0-9a-f]{7,}$/i.test(supportInfo.commitSha || '') ? supportInfo.commitSha.slice(0, 7) : '';
                const facts = [
                    ['Version', supportInfo.appVersion + (shortSha ? ' (' + shortSha + ')' : '')],
                    ['Paperless-ngx', supportInfo.paperlessNgxVersion !== 'unknown' ? supportInfo.paperlessNgxVersion : ''],
                    ['AI', supportInfo.aiProviderLabel + (supportInfo.aiModel !== 'unknown' ? ' · ' + supportInfo.aiModel : '')],
                    ['OCR', supportInfo.ocrLabel],
                    ['Scan schedule', supportInfo.scanInterval],
                    ['Node.js', supportInfo.nodeVersion],
                    ['Platform', supportInfo.platform],
                    ['Uptime', supportInfo.uptime],
                    ['Server time', String(supportInfo.serverTimeUtc).replace('T', ' ').replace(/\.\d+Z$/, ' UTC') + ' (' + supportInfo.timezone + ')'],
                ].filter(([, value]) => value);
            %>
            <div class="zr-col zr-col--loose about-page">
                <section class="zr-module about-hero">
                    <img class="about-hero__logo no-invert" src="/logo.png" alt="" width="56" height="56">
                    <div class="zr-col zr-col--tight">
                        <div class="zr-row zr-row--wrap">
                            <h2 class="about-hero__name">Zettelrobbe</h2>
                            <button
                                type="button"
                                class="zr-badge zr-badge--brand zr-num about-hero__version"
                                data-open-welcome
                                aria-haspopup="dialog"
                                title="Show the welcome and What's new dialog again"
                            ><%= supportInfo.appVersion %></button>
                        </div>
                        <p class="zr-muted">
                            Zettelrobbe reads the documents in your Paperless-ngx and fills in title, tags, correspondent,
                            document type and custom fields with an AI model of your choice. A community fork of
                            paperless-ai, free and open source under the MIT license.
                        </p>
                        <div class="zr-row zr-row--wrap">
                            <a class="zr-btn" href="https://zettelrob.be/" target="_blank" rel="noopener noreferrer">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>Documentation
                            </a>
                            <a class="zr-btn" href="https://github.com/admonstrator/zettelrobbe/releases" target="_blank" rel="noopener noreferrer">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>Release notes
                            </a>
                            <a class="zr-btn" href="https://github.com/admonstrator/zettelrobbe" target="_blank" rel="noopener noreferrer">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-github"/></svg>Source code
                            </a>
                        </div>
                    </div>
                </section>

                <div class="card-grid">
                    <section class="zr-module">
                        <div class="zr-module__head">
                            <h2 class="zr-module__title">Report a problem</h2>
                        </div>
                        <div class="zr-module__body zr-col">
                            <p class="zr-sm zr-muted">
                                A report with these details gets an answer faster. The issue form is filled in for you;
                                API keys are never included, only whether one is set. Check the server addresses before
                                you post them publicly.
                            </p>
                            <dl class="about-facts zr-sm">
                                <% facts.forEach(([label, value]) => { %>
                                    <dt><%= label %></dt><dd><%= value %></dd>
                                <% }) %>
                            </dl>
                            <div class="zr-row zr-row--wrap">
                                <a
                                    id="openPrefilledIssueBtn"
                                    href="https://github.com/admonstrator/zettelrobbe/issues/new?template=bug_report.yml"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="zr-btn zr-btn--primary">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-bug"/></svg>Open issue form
                                </a>
                                <button id="copyIssueDiagnosticsBtn" type="button" class="zr-btn">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>Copy details
                                </button>
                            </div>
                        </div>
                    </section>

                    <div class="zr-col zr-col--loose">
                        <section class="zr-module about-support">
                            <div class="zr-module__head">
                                <h2 class="zr-module__title">Support Zettelrobbe</h2>
                            </div>
                            <div class="zr-module__body zr-col">
                                <p class="zr-sm zr-muted">
                                    Free for everyone, with no account and no license key. If it saves you time and
                                    headaches, a few energy drinks keep it going.
                                </p>
                                <%- include('partials/pay-links') %>
                            </div>
                        </section>

                        <section class="zr-module">
                            <div class="zr-module__head">
                                <h2 class="zr-module__title">Contact</h2>
                            </div>
                            <div class="zr-module__body zr-col">
                                <p class="zr-sm zr-muted">Questions, praise, feedback, or a bug you would rather not post in public.</p>
                                <div class="zr-row zr-row--wrap">
                                    <a class="zr-btn" href="mailto:hey@admon.me">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-mail"/></svg>hey@admon.me
                                    </a>
                                    <a class="zr-btn zr-btn--ghost" href="https://github.com/admonstrator/Admonstrator/blob/main/pgp/hey@admon.me.asc" target="_blank" rel="noopener noreferrer">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>PGP key
                                    </a>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>

                <div class="card-grid">
                    <section class="zr-module">
                        <div class="zr-module__head">
                            <h2 class="zr-module__title">Who is behind it</h2>
                        </div>
                        <div class="zr-module__body about-prose zr-muted">
                            <p>
                                I am Aaron Viehl
                                (<a class="zr-link" href="https://github.com/admonstrator" target="_blank" rel="noopener noreferrer">@admonstrator</a>),
                                a trained IT specialist for system integration and CTO at
                                <a class="zr-link" href="https://singleton-factory.de" target="_blank" rel="noopener noreferrer">singleton-factory</a>
                                in Germany, also known as the grumpy nerd next door. I build tools that hold up in daily
                                use: less noise, more reliability, fewer surprises at the edges.
                            </p>
                            <p>
                                I am not a full-time software engineer, and I use AI heavily to move faster. Every change
                                still gets my review, hands-on testing and as many rounds as it takes until it is stable.
                                More at <a class="zr-link" href="https://admon.me" target="_blank" rel="noopener noreferrer">admon.me</a>.
                            </p>
                        </div>
                    </section>

                    <section class="zr-module">
                        <div class="zr-module__head">
                            <h2 class="zr-module__title">Thanks to</h2>
                        </div>
                        <div class="zr-module__body about-prose zr-muted">
                            <ul>
                                <li>
                                    <a class="zr-link" href="https://github.com/clusterzx" target="_blank" rel="noopener noreferrer">@clusterzx</a>
                                    for
                                    <a class="zr-link" href="https://github.com/clusterzx/paperless-ai" target="_blank" rel="noopener noreferrer">paperless-ai</a>,
                                    the foundation this fork stands on
                                </li>
                                <li>
                                    <a class="zr-link" href="https://github.com/claymore666" target="_blank" rel="noopener noreferrer">@claymore666</a>
                                    and
                                    <a class="zr-link" href="https://github.com/saschabuehrle" target="_blank" rel="noopener noreferrer">@saschabuehrle</a>
                                    for their code
                                </li>
                                <li>everyone who reports bugs with clear steps, tests fixes and sends feedback</li>
                            </ul>
                            <p class="zr-sm zr-faint">Missing from this list? Open an issue or a pull request and say hello.</p>
                        </div>
                    </section>
                </div>
            </div>
        </main>
    </div>

    <script id="supportInfoPayload" type="application/json"><%- JSON.stringify(supportInfo || {}).replace(/</g, '\\u003c') %></script>

    <%- include('partials/scripts/about-scripts') %>
    <%- include('partials/shell/body-close') %>
