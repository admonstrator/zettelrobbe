<!-- views/history.ejs -->
<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'History - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'History',
    version: typeof version !== 'undefined' ? version : '',
    chatEnabled: typeof chatEnabled !== 'undefined' ? chatEnabled : false,
    mainClass: 'main-content modified-documents-page'
}) %>
            <div>
                <div class="zr-viewhead">
                    <p class="zr-viewhead__sub" style="margin-top: 0">
                        Documents Zettelrobbe has already processed. Resetting one makes it eligible
                        for the next scan again.
                    </p>
                </div>

                <!-- Slotted into the table toolbar next to the search once the
                     table exists, so every way to narrow the list is one row.
                     Hidden until then to avoid a layout jump. -->
                <div id="historyFilters" class="zr-row" hidden>
                    <select id="tagFilter" class="zr-select history-filter" aria-label="Filter by tag">
                        <option value="">All tags</option>
                        <% filters.allTags.forEach(function(tag) { %>
                            <option value="<%= tag.id %>"><%= tag.name %></option>
                        <% }); %>
                    </select>
                    <select id="correspondentFilter" class="zr-select history-filter" aria-label="Filter by correspondent">
                        <option value="">All correspondents</option>
                        <% filters.allCorrespondents.forEach(function(corr) { %>
                            <option value="<%= corr %>"><%= corr %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="zr-row zr-row--wrap zr-btnbar" data-module="toolbar-menu" style="margin-bottom: var(--zr-3)">
                    <button id="rescanSelectedBtn" class="zr-btn" title="Reprocess selected documents (clears the local record and triggers a scan)">
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                        Rescan selected
                    </button>
                    <!-- The row menu applied to a selection. Same actions, same
                         order, so the two read as one vocabulary. -->
                    <button id="bulkActionsBtn" class="zr-btn" popovertarget="historyBulkMenu"
                        title="Apply an action to the selected documents" aria-haspopup="menu">
                        <span>Actions</span>
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                    </button>
                    <div id="historyBulkMenu" popover class="zr-menu">
                        <button type="button" class="zr-menu__item" id="bulkOcrRunBtn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-play"/></svg>OCR now, then analyze
                        </button>
                        <button type="button" class="zr-menu__item" id="bulkOcrQueueBtn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-scan"/></svg>Send to OCR queue
                        </button>
                        <button type="button" class="zr-menu__item" id="bulkReanalyzeBtn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>Reanalyze
                        </button>
                        <div class="zr-menu__sep"></div>
                        <button type="button" class="zr-menu__item zr-menu__item--danger" id="bulkIgnoreBtn">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye-off"/></svg>Ignore
                        </button>
                    </div>
                    <button id="forceReloadBtn" class="zr-btn" title="Reload the tag and correspondent lists, bypassing the cache">
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                        Refresh filters
                    </button>
                    <span class="zr-grow"></span>
                    <button id="resetSelectedBtn" class="zr-btn zr-btn--danger">Reset selected</button>
                    <button id="resetAllBtn" class="zr-btn zr-btn--danger">Reset all</button>
                </div>

                <div class="zr-alert zr-alert--info" style="margin-bottom: var(--zr-4)">
                    <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
                    <div class="zr-alert__body">
                        <p class="zr-sm">History is reconciled automatically. To run it by hand, go to
                        <a href="/settings#caching" class="zr-link">Settings &rarr; Caching and history</a>.</p>
                    </div>
                </div>

                <!-- Loading Indicator -->
                <div id="historyLoadingIndicator" class="zr-module">
                    <div class="zr-empty">
                        <div >
                            <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                        </div>
                        <div class="zr-empty__title">Loading history…</div>
                        <div id="historyProgressContainer" class="zr-meter" style="max-width: 320px; margin: var(--zr-3) auto"
                             role="progressbar"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="0"
                             aria-label="Loading progress">
                            <div id="historyLoadProgress" class="zr-meter__fill" style="width: 0%"></div>
                        </div>
                        <div id="historyLoadStatus" class="zr-sm zr-muted" aria-live="polite">Preparing to load history data...</div>
                    </div>
                </div>

                <!-- DataTable -->
                <div id="historyTableContainer" class="zr-module" data-module="row-menu" style="display: none;">
                    <div class="zr-module__head">
                        <label class="zr-row zr-sm">
                            <input type="checkbox" id="selectAll" class="zr-check">
                            Select all on this page
                        </label>
                    </div>
                    <!-- The table body is rendered by js/modules/data-table.js -->
                    <div id="historyTable"></div>
                </div>
            </div>
        </main>
    </div>

    <!-- Info Modal: AI Analysis Details -->
    <div id="infoModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container" style="max-width:680px;width:95%;display:flex;flex-direction:column;">
            <div class="modal-header" style="display:flex;justify-content:space-between;align-items:flex-start;flex-shrink:0;">
                <div>
                    <h3 class="modal-title" id="infoModalTitle">AI Analysis Details</h3>
                    <a id="infoModalLink" href="#" target="_blank" class="zr-link zr-sm" style="display:none;">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-external"/></svg> Open in Paperless-ngx
                    </a>
                </div>
                <button class="modal-close" id="infoModalClose"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
            </div>
            <div class="modal-content" style="flex:1;min-height:0;overflow-y:auto;max-height:none;">
                <!-- Loading State -->
                <div id="infoModalLoading" class="zr-empty">
                    <svg class="zr-icon zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                    <div class="zr-muted">Loading details...</div>
                </div>
                <!-- Content -->
                <div id="infoModalBody" class="zr-modal-sections" style="display:none;">
                    <!-- Tags Section -->
                    <div >
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-tag"/></svg> AI-Set Tags
                            <span id="infoModalLiveHint" class="zr-xs zr-faint"></span>
                        </h4>
                        <div id="infoModalTags" class="zr-row zr-row--wrap"></div>
                        <div id="infoModalExternalTags" class="zr-row zr-row--wrap"></div>
                    </div>
                    <!-- Correspondent Section -->
                    <div >
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-user"/></svg> Correspondent
                        </h4>
                        <div id="infoModalCorrespondent" class="zr-sm"></div>
                    </div>
                    <!-- Document Classification Section -->
                    <div  id="infoModalClassificationSection">
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-folder"/></svg> Document Classification
                        </h4>
                        <div class="zr-row zr-row--wrap">
                            <div>
                                <span class="zr-label">Type</span>
                                <span id="infoModalDocType" class="zr-badge zr-badge--info">–</span>
                            </div>
                            <div>
                                <span class="zr-label">Language</span>
                                <span id="infoModalLanguage" class="zr-badge zr-badge--brand">–</span>
                            </div>
                        </div>
                    </div>
                    <!-- Custom Fields Section -->
                    <div  id="infoModalCustomFieldsSection">
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-list"/></svg> Custom Fields
                        </h4>
                        <div id="infoModalCustomFields" class="zr-sm"></div>
                    </div>
                    <!-- Processed At -->
                    <div >
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-clock"/></svg> Processed At
                        </h4>
                        <div id="infoModalProcessedAt" class="zr-sm"></div>
                    </div>
                    <!-- Token Usage -->
                    <div  id="infoModalTokensSection">
                        <h4 class="zr-label">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-coins"/></svg> Token Usage
                        </h4>
                        <div id="infoModalTokens" class="zr-row zr-row--wrap"></div>
                    </div>
                    <!-- Original State (collapsible) -->
                    <div  id="infoModalOriginalSection" style="display:none;">
                        <button id="infoModalOriginalToggle" class="zr-label zr-row" style="width:100%; text-align:left">
                            <svg class="zr-icon" id="infoModalOriginalChevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-history"/></svg> Original State (before AI)
                        </button>
                        <div id="infoModalOriginalBody" class="hidden">
                            <div id="infoModalOriginalContent" class="zr-col zr-col--tight"></div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Footer: outside scrollable area so buttons are always visible -->
            <div class="zr-dialog__foot" style="background:var(--card-bg);border-radius:0 0 12px 12px;">
                <button id="infoModalRestoreBtn" class="zr-btn zr-btn--danger" style="display:none;">
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg> Restore Original
                </button>
                <button id="infoModalRescanBtn" class="zr-btn">
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg> Rescan
                </button>
                <button id="infoModalCloseBtn" class="zr-btn">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal for Selected Documents -->
    <div id="confirmModal" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">Confirm Reset</h3>
                <button class="modal-close"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
            </div>
            <div class="modal-content">
                <p >Are you sure you want to reset the selected documents to their original values? This action cannot be undone.</p>
                <div class="zr-row" style="justify-content: flex-end">
                    <button id="cancelReset" class="zr-btn">Cancel</button>
                    <button id="confirmReset" class="zr-btn zr-btn--danger">Confirm Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal for All Documents -->
    <div id="confirmModalAll" class="modal hidden">
        <div class="modal-overlay"></div>
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">Confirm Reset All</h3>
                <button class="modal-close"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
            </div>
            <div class="modal-content">
                <p >Are you sure you want to reset <b>all</b> documents to their original values? This action cannot be undone.</p>
                <div class="zr-row" style="justify-content: flex-end">
                    <button id="cancelResetAll" class="zr-btn">Cancel</button>
                    <button id="confirmResetAll" class="zr-btn zr-btn--danger">Confirm Reset</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Skip a document and propose rules for documents like it. Filled by
         js/history.js from /api/ignored/suggest/:id. -->
    <dialog class="zr-dialog zr-dialog--wide history-skip" id="skipDialog" aria-labelledby="skipDialogTitle">
        <div class="zr-dialog__head">
            <span class="zr-grow" id="skipDialogTitle">Skip documents like this</span>
            <button class="zr-btn zr-btn--ghost zr-btn--icon" type="button" data-skip-close aria-label="Close">
                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
            </button>
        </div>
        <div class="zr-dialog__body zr-col">
            <p class="zr-sm">Pick what should keep documents like this one away from OCR and AI. The rules are built from this document; adjust them before saving.</p>
            <p class="zr-sm" id="skipDialogLoading">
                <svg class="zr-icon zr-icon--sm zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                Reading the document from Paperless-ngx…
            </p>
            <p class="zr-sm zr-danger-text hidden" id="skipDialogError"></p>
            <div class="zr-col hidden" id="skipDialogForm">
                <dl class="history-skip__facts">
                    <div><dt>Document</dt><dd id="skipFactDocument"></dd></div>
                    <div><dt>Pages</dt><dd id="skipFactPages"></dd></div>
                    <div><dt>File</dt><dd class="zr-mono" id="skipFactFile"></dd></div>
                    <div><dt>Correspondent</dt><dd id="skipFactCorrespondent"></dd></div>
                </dl>

                <div class="history-skip__rule">
                    <input type="checkbox" class="zr-check" id="skipRuleDocument" checked disabled>
                    <div class="zr-col zr-col--tight zr-grow">
                        <label for="skipRuleDocument" class="history-skip__name">This document</label>
                        <p class="zr-sm">Goes on the ignored list. Always part of a skip.</p>
                    </div>
                </div>

                <div class="history-skip__rule">
                    <input type="checkbox" class="zr-check" id="skipRuleText">
                    <div class="zr-col zr-col--tight zr-grow">
                        <label for="skipRuleText" class="history-skip__name">Copies with the same text</label>
                        <p class="zr-sm" id="skipRuleTextHint"></p>
                    </div>
                </div>

                <div class="history-skip__rule">
                    <input type="checkbox" class="zr-check" id="skipRuleTitle">
                    <div class="zr-col zr-col--tight zr-grow">
                        <label for="skipRuleTitle" class="history-skip__name">Title or file name contains</label>
                        <input type="text" class="zr-input" id="skipTitlePattern" aria-label="Title part" maxlength="200">
                        <div class="zr-row zr-row--wrap zr-sm hidden" id="skipTitleSuggestions">
                            <span>Other suggestions:</span>
                        </div>
                        <p class="zr-sm" id="skipRuleTitleHint"></p>
                    </div>
                </div>

                <div class="history-skip__rule hidden" id="skipRulePagesTile">
                    <input type="checkbox" class="zr-check" id="skipRulePages">
                    <div class="zr-col zr-col--tight zr-grow">
                        <label for="skipRulePages" class="history-skip__name">Page limit for every document</label>
                        <div class="zr-row zr-sm">
                            <span>Skip anything over</span>
                            <input type="number" class="zr-input history-skip__pages" id="skipPageLimit" min="1" step="1" aria-label="Page limit">
                            <span>pages</span>
                        </div>
                        <p class="zr-sm" id="skipRulePagesHint"></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="zr-dialog__foot">
            <span class="zr-grow zr-sm zr-faint">Title and page rules are saved to <a href="/settings#skip-rules">Settings › Skip rules</a>.</span>
            <button type="button" class="zr-btn" data-skip-close>Cancel</button>
            <button type="button" class="zr-btn zr-btn--primary" id="skipDialogConfirm" disabled>Skip document</button>
        </div>
    </dialog>

    <%- include('partials/ocr-progress-overlay') %>

    <!-- Classic script: history.js is a module and can read the global it sets,
         but the OCR queue page cannot import one. -->
    <script src="/js/ocr-progress.js"></script>
    <!-- window.zrDialog, for the confirmation before a bulk action. -->
    <script src="/js/dialogs.js"></script>
    <script type="module" src="/js/history.js"></script>
    <%- include('partials/shell/body-close') %>