<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Duplicates - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Duplicates',
    version: typeof version !== 'undefined' ? version : ''
}) %>
<%
/* The sensitivity presets come from services/entityNameMatcher.js through the
   route. The fallbacks below keep the page renderable on its own: the mock
   server the UI is reviewed with and the static view test both use them. */
const dupSensitivity = (typeof sensitivity !== 'undefined' && sensitivity)
    ? sensitivity
    : { strict: 0.95, normal: 0.85, loose: 0.75 };
const dupDefaultThreshold = (typeof defaultThreshold !== 'undefined' && defaultThreshold)
    ? Number(defaultThreshold)
    : 0.85;
const dupSensitivityOptions = [
    { label: 'Loose', value: dupSensitivity.loose },
    { label: 'Normal', value: dupSensitivity.normal },
    { label: 'Strict', value: dupSensitivity.strict }
];
/* The model is only offered when the setting is on and a provider is
   configured; without that local nothing of it is rendered at all. */
const dupAiReviewEnabled = typeof aiReviewEnabled !== 'undefined' && aiReviewEnabled === true;
-%>
            <!-- The page in two modes. The script stamps data-mode on this
                 element; review.css hides what belongs to the other mode.
                 Simple until the script has read the stored mode. -->
            <div class="dup-page" data-review-page="duplicates" data-mode="simple"
                 data-default-threshold="<%= dupDefaultThreshold %>">
                <div class="dup-lede" data-simple>
                    <p class="dup-sub">Merge tags and correspondents that mean the same thing.</p>
                </div>

                <!-- Advanced: what a scan looks at, and the two runs. -->
                <div class="zr-module dup-scanrow" id="dupControls" data-advanced>
                    <div class="zr-module__body dup-controls">
                        <div class="dup-controls__field">
                            <span class="zr-label" id="dupKindLabel">Look at</span>
                            <div class="zr-segment" id="dupKind" role="group" aria-labelledby="dupKindLabel">
                                <button type="button" data-kind="tags" aria-selected="false">Tags</button>
                                <button type="button" data-kind="correspondents" aria-selected="false">Correspondents</button>
                                <button type="button" data-kind="all" aria-selected="true">Both</button>
                            </div>
                        </div>

                        <div class="dup-controls__field">
                            <label class="zr-label" for="dupSensitivity">Sensitivity</label>
                            <select class="zr-select dup-controls__select" id="dupSensitivity">
<% dupSensitivityOptions.forEach(function (option) { -%>
                                <option value="<%= option.value %>"<%= Number(option.value) === dupDefaultThreshold ? ' selected' : '' %>><%= option.label %></option>
<% }); -%>
                                <option value="custom">Custom</option>
                            </select>
                        </div>

                        <!-- The number the scan and the model are asked with. A
                             preset writes its own number here; a number no
                             preset has turns the select to Custom. -->
                        <div class="dup-controls__field dup-controls__custom" id="dupThresholdCustomField">
                            <label class="zr-label" for="dupThresholdCustom">Threshold</label>
                            <div class="dup-controls__percent">
                                <input class="zr-input" id="dupThresholdCustom" type="number"
                                       min="50" max="100" step="1" value="<%= Math.round(dupDefaultThreshold * 100) %>" inputmode="numeric">
                                <span class="zr-faint">%</span>
                            </div>
                        </div>

                        <label class="dup-controls__switch">
                            <span>Include hidden pairs</span>
                            <input type="checkbox" class="zr-toggle" id="dupIncludeDismissed">
                        </label>

                        <div class="dup-controls__field dup-controls__field--action">
                            <button class="zr-btn<%= dupAiReviewEnabled ? '' : ' zr-btn--primary' %>" id="dupScanBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" id="dupScanIcon" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                Scan
                            </button>
<% if (dupAiReviewEnabled) { -%>
                            <button class="zr-btn zr-btn--primary" id="dupAiReviewBtn" type="button" disabled>
                                <svg class="zr-icon zr-icon--sm" id="dupAiReviewIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                Ask the model
                            </button>
<% } -%>
                        </div>
                    </div>
                </div>

                <!-- Simple: the card the page opens on, and its one button. -->
                <div class="zr-emptycard dup-empty" id="dupEmpty" data-simple>
                    <svg class="zr-icon zr-emptycard__icon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                    <button class="zr-btn zr-btn--primary" id="dupFindBtn" type="button">Find duplicates</button>
                </div>

<% if (dupAiReviewEnabled) { -%>
                <!-- Both modes: a run while it runs. A reloaded page attaches
                     to a run that is still going through
                     /api/duplicates/ai-review/jobs. -->
                <div class="dup-progress zr-runmeter hidden" id="dupAiProgress" role="status" aria-live="polite">
                    <div class="zr-runmeter__head">
                        <span class="zr-runmeter__phase" id="dupAiProgressMessage"></span>
                        <button class="zr-btn" id="dupAiStopBtn" type="button">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                            <span class="dup-progress__stop-label">Stop</span>
                        </button>
                    </div>
                    <div class="zr-runbar dup-progress__runbar">
                        <span class="zr-runbar__position" id="dupRunPosition"></span>
                        <div class="dup-progress__bar zr-runbar__track" id="dupAiProgressBar" role="progressbar" aria-label="Run progress">
                            <div class="dup-progress__fill zr-runbar__fill" id="dupAiProgressFill"></div>
                        </div>
                        <span class="zr-runbar__rest" id="dupRunRest"></span>
                    </div>
                    <div class="zr-ledger dup-progress__ledger" id="dupRunLedger"></div>
                    <div class="zr-tokenbar dup-progress__tokenbar hidden" id="dupRunTokenbar">
                        <div class="zr-tokenbar__track">
                            <span class="zr-tokenbar__seg zr-tokenbar__seg--prompt" id="dupRunSegPrompt"></span>
                            <span class="zr-tokenbar__seg zr-tokenbar__seg--answer" id="dupRunSegAnswer"></span>
                            <span class="zr-tokenbar__seg zr-tokenbar__seg--thinking" id="dupRunSegThinking"></span>
                        </div>
                        <div class="zr-tokenbar__legend" id="dupRunLegend"></div>
                    </div>
                    <p class="zr-runmeter__ceiling hidden" id="dupRunCeiling"></p>
                    <div class="zr-reqlog dup-progress__reqlog" id="dupRunLog"></div>
                </div>
<% } -%>

                <!-- Both modes: a failed scan, a failed or stopped run. -->
                <div class="dup-ai-notice" id="dupAiNotice"></div>

                <!-- Both modes: a batch merge while it writes, one row per group. -->
                <section class="dup-apply hidden" id="dupApply" role="status" aria-live="polite" aria-label="Merging">
                    <div class="zr-runbar dup-apply__bar">
                        <span class="zr-runbar__position" id="dupApplyPosition"></span>
                        <div class="zr-runbar__track"><div class="zr-runbar__fill" id="dupApplyFill"></div></div>
                        <span class="zr-runbar__rest" id="dupApplyRest"></span>
                    </div>
                    <div class="zr-reqlog dup-apply__list" id="dupApplyList"></div>
                </section>

                <!-- Both modes: one pair per screen. A decision ticks or
                     unticks the pair's row; the keys are Enter, Esc and L. -->
                <section class="dup-stack hidden" id="dupStack" tabindex="-1" aria-label="One pair at a time">
                    <div class="zr-runbar dup-stack__bar">
                        <span class="zr-runbar__position" id="dupStackPosition"></span>
                        <div class="zr-runbar__track"><div class="zr-runbar__fill" id="dupStackFill"></div></div>
                        <span class="zr-runbar__rest" id="dupStackRest"></span>
                    </div>
                    <div class="dup-stack__card" id="dupStackCard"></div>
                    <div class="dup-stack__foot">
                        <span class="zr-sm zr-faint dup-stack__tally" id="dupStackTally"></span>
                        <button class="zr-btn" id="dupStackUndoBtn" type="button" disabled>
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg>
                            Undo
                        </button>
                        <button class="zr-btn" id="dupStackCloseBtn" type="button">Back</button>
                    </div>
                </section>

                <!-- Simple: what a run found. The head, three checklists and
                     one line of history; hidden until a scan has answered. -->
                <section class="dup-result hidden" id="dupResult" data-simple aria-label="Result">
                    <div class="dup-result__card">
                        <div class="zr-resulthead">
                            <div class="zr-resulthead__text">
                                <p class="zr-resulthead__headline" id="dupResultHeadline"></p>
                                <p class="zr-resulthead__cost" id="dupResultCost"></p>
                            </div>
                            <div class="zr-resulthead__action">
                                <button class="zr-btn zr-btn--primary" id="dupResultMergeBtn" type="button" disabled>Merge 0 · 0 writes</button>
                            </div>
                        </div>
                    </div>
                    <div class="dup-result__lists" id="dupChecklists"></div>
                    <p class="zr-historyline hidden" id="dupHistoryLine">
                        <span id="dupHistoryText"></span>
                        <span aria-hidden="true">·</span>
                        <button class="zr-btn" id="dupHistoryUndoBtn" type="button">Undo</button>
                    </p>
                </section>

                <!-- Advanced: the whole toolset. The marked wrapper carries no
                     layout of its own, so review.css alone decides whether it
                     shows; the column inside it spaces the modules. -->
                <div data-advanced>
                <div class="dup-tools">
                    <!-- Merge by hand: no scan involved. Same request, same log,
                         same undo as a scanned group. The list behind it is
                         fetched on the first open. -->
                    <details class="zr-module dup-manual" id="dupManual">
                        <summary class="zr-module__head dup-manual__summary">
                            <svg class="zr-icon zr-icon--sm dup-manual__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <span class="zr-module__title" id="dupManualTitle">Merge by hand</span>
                        </summary>
                        <div class="zr-module__body dup-manual__body">
                            <div class="dup-manual__field">
                                <span class="zr-label" id="dupManualKindLabel">Kind</span>
                                <div class="zr-segment" id="dupManualKind" role="group" aria-labelledby="dupManualKindLabel">
                                    <button type="button" data-kind="tags" aria-selected="true">Tags</button>
                                    <button type="button" data-kind="correspondents" aria-selected="false">Correspondents</button>
                                </div>
                            </div>

                            <div class="dup-manual__pair">
                                <div class="dup-manual__field">
                                    <label class="zr-label" for="dupManualTarget">Keep</label>
                                    <div class="zr-picker" id="dupManualTargetPicker">
                                        <input class="zr-input zr-picker__input" id="dupManualTarget" type="text"
                                               autocomplete="off" role="combobox" aria-expanded="false"
                                               aria-autocomplete="list" aria-controls="dupManualTargetList"
                                               placeholder="Search an entry" data-selected-id="">
                                        <div class="zr-picker__list hidden" id="dupManualTargetList" role="listbox" aria-label="Entries to keep"></div>
                                    </div>
                                </div>

                                <div class="dup-manual__field">
                                    <label class="zr-label" for="dupManualSources">Merge away</label>
                                    <div class="zr-picker" id="dupManualSourcesPicker">
                                        <input class="zr-input zr-picker__input" id="dupManualSources" type="text"
                                               autocomplete="off" role="combobox" aria-expanded="false"
                                               aria-autocomplete="list" aria-controls="dupManualSourcesList"
                                               placeholder="Search an entry">
                                        <div class="zr-picker__list hidden" id="dupManualSourcesList" role="listbox" aria-label="Entries to merge away"></div>
                                    </div>
                                    <div class="zr-chips dup-manual__chips" id="dupManualChips"></div>
                                </div>
                            </div>

                            <div class="dup-manual__warnings" id="dupManualWarnings"></div>

                            <!-- What the Merge button writes, in numbers. -->
                            <p class="zr-sm zr-faint dup-manual__consequence hidden" id="dupManualConsequence"></p>

                            <div class="dup-manual__actions">
                                <button class="zr-btn" id="dupManualReloadBtn" type="button">
                                    <svg class="zr-icon zr-icon--sm" id="dupManualReloadIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                    Reload
                                </button>
                                <button class="zr-btn zr-btn--primary" id="dupManualMergeBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                                    Merge
                                </button>
                            </div>

                            <div class="dup-manual__result" id="dupManualResult"></div>
                        </div>
                    </details>

                    <!-- Every group of the scan: the order, the tick by
                         confidence, the selection and the cards. -->
                    <div class="dup-everything hidden" id="dupEverything">
                        <div class="dup-results-bar hidden" id="dupResultsBar" role="group" aria-label="Every group">
                            <span class="dup-results-bar__title">Every group <span class="dup-results-bar__count" id="dupResultsCount">· 0</span></span>
                            <select class="zr-select" id="dupSortSelect" aria-label="Sort">
                                <option value="confidence">Sort: Confidence</option>
                                <option value="documents">Sort: Documents</option>
                                <option value="name">Sort: Name</option>
                                <option value="kind">Sort: Kind</option>
                            </select>
                            <div class="dup-results-bar__minrow">
                                <input class="zr-input" id="dupMinConfidence" type="number"
                                       min="50" max="100" step="1" value="95" inputmode="numeric"
                                       aria-label="Confidence at least">
                                <span class="zr-faint">%</span>
                                <button class="zr-btn" id="dupSelectMinBtn" type="button">Select ≥ 95%</button>
                            </div>
                        </div>

                        <!-- The groups ticked for one batch; sticky under the
                             top bar while the cards scroll past. -->
                        <div class="dup-selection hidden" id="dupSelection" role="group" aria-label="Selected groups">
                            <span class="dup-selection__count" id="dupSelectionCount"></span>
                            <span class="zr-sm dup-selection__progress hidden" id="dupSelectionProgress" aria-live="polite"></span>
                            <div class="dup-selection__actions">
<% if (dupAiReviewEnabled) { -%>
                                <button class="zr-btn" id="dupReviewThenMergeBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" id="dupReviewThenMergeIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                    <span id="dupReviewThenMergeLabel">Ask the model about 0</span>
                                </button>
<% } -%>
                                <button class="zr-btn zr-btn--primary" id="dupMergeSelectedBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                                    <span id="dupMergeSelectedLabel">Merge 0</span>
                                </button>
                            </div>
                        </div>

                        <div class="dup-results" id="dupResults"></div>
                    </div>

                    <!-- Objects the scan found without a single document.
                         Deleting one is logged and undone like a merge. -->
                    <details class="zr-module dup-unused hidden" id="dupUnused">
                        <summary class="zr-module__head dup-unused__summary">
                            <svg class="zr-icon zr-icon--sm dup-unused__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <span class="zr-module__title">Unused <span class="dup-summary__count" id="dupUnusedSummary">· 0</span></span>
                        </summary>
                        <div class="zr-module__body dup-unused__body">
                            <div class="dup-unused__alert" id="dupUnusedAlert"></div>
                            <div class="zr-table-wrap">
                                <table class="zr-table zr-table--stack dup-unused__table">
                                    <thead>
                                        <tr>
                                            <th class="dup-unused__pickcol">Delete</th>
                                            <th>Kind</th>
                                            <th>Name</th>
                                            <th>Matching rule</th>
                                        </tr>
                                    </thead>
                                    <tbody id="dupUnusedBody"></tbody>
                                </table>
                            </div>
                            <div class="dup-unused__actions">
                                <button class="zr-btn" id="dupUnusedSelectAllBtn" type="button">Select all</button>
                                <button class="zr-btn zr-btn--danger" id="dupUnusedDeleteBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                    Delete 0
                                </button>
                            </div>
                        </div>
                    </details>

                    <!-- The merge log: every merge, delete and split, with its undo. -->
                    <details class="zr-module dup-log" id="dupLog">
                        <summary class="zr-module__head dup-log__summary">
                            <svg class="zr-icon zr-icon--sm dup-log__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <span class="zr-module__title">History <span class="dup-summary__count" id="dupLogMeta">· 0</span></span>
                        </summary>
                        <div class="dup-log__alert" id="dupLogAlert"></div>
                        <div class="zr-table-wrap">
                            <table class="zr-table zr-table--stack dup-log__table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Kind</th>
                                        <th>Target</th>
                                        <th>Merged</th>
                                        <th>Documents</th>
                                        <th>Status</th>
                                        <th class="zr-table__actions">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="dupLogBody">
                                    <tr>
                                        <td colspan="7" class="zr-empty">
                                            <svg class="zr-icon zr-icon--sm zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            Loading
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="zr-table-foot">
                            <span class="zr-sm zr-faint" id="dupLogInfo"></span>
                            <button class="zr-btn hidden" id="dupLogMoreBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                More
                            </button>
                        </div>
                    </details>

                    <!-- Every time document analysis proposed another spelling
                         of an existing name, the existing one was used and the
                         mapping recorded here. Loaded when the page opens. -->
                    <details class="zr-module dup-mappings" id="dupMappings">
                        <summary class="zr-module__head dup-mappings__summary">
                            <svg class="zr-icon zr-icon--sm dup-mappings__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <span class="zr-module__title">Names mapped while processing <span class="dup-summary__count" id="dupMappingsSummary">· 0</span></span>
                        </summary>
                        <div class="zr-module__body dup-mappings__body">
                            <div class="dup-mappings__alert" id="dupMappingsAlert"></div>
                            <div class="zr-table-wrap">
                                <table class="zr-table zr-table--stack dup-mappings__table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Kind</th>
                                            <th>Proposed → mapped to</th>
                                            <th>Rule</th>
                                            <th>Document</th>
                                        </tr>
                                    </thead>
                                    <tbody id="dupMappingsBody"></tbody>
                                </table>
                            </div>
                            <div class="dup-mappings__actions">
                                <button class="zr-btn" id="dupMappingsClearBtn" type="button">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                    Clear
                                </button>
                            </div>
                        </div>
                    </details>

                    <details class="zr-module dup-hidden" id="dupDismissals">
                        <summary class="zr-module__head dup-hidden__summary">
                            <svg class="zr-icon zr-icon--sm dup-hidden__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                            <span class="zr-module__title">Hidden pairs <span class="dup-summary__count" id="dupDismissalsSummary">· 0</span></span>
                        </summary>
                        <div class="zr-module__body dup-hidden__list" id="dupDismissalsList"></div>
                    </details>
<% if (dupAiReviewEnabled) { -%>

                    <!-- Empties the model's memory of earlier verdicts; the
                         next run asks about every pair again. -->
                    <div class="dup-forget">
                        <button class="zr-btn" id="dupAiForgetBtn" type="button">Clear verdict memory</button>
                    </div>
<% } -%>
                </div>
                </div>
            </div>

    <script type="module" src="/js/duplicates.js"></script>
    <%- include('partials/shell/body-close') %>
