<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Duplicates - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Duplicates',
    version: typeof version !== 'undefined' ? version : ''
}) %>
<%
/* The sensitivity presets come from services/entityNameMatcher.js through the
   route. The fallbacks below keep the page renderable on its own — the mock
   server the UI is reviewed with and the static view test both use them. */
const dupSensitivity = (typeof sensitivity !== 'undefined' && sensitivity)
    ? sensitivity
    : { strict: 0.95, normal: 0.85, loose: 0.75 };
const dupDefaultThreshold = (typeof defaultThreshold !== 'undefined' && defaultThreshold)
    ? Number(defaultThreshold)
    : 0.85;
const dupSensitivityOptions = [
    { label: 'Strict', value: dupSensitivity.strict },
    { label: 'Normal', value: dupSensitivity.normal },
    { label: 'Loose', value: dupSensitivity.loose }
];
/* The AI review is only offered when the setting is on and a provider is
   configured; without that local nothing of it is rendered at all. */
const dupAiReviewEnabled = typeof aiReviewEnabled !== 'undefined' && aiReviewEnabled === true;
-%>
            <div>
                <div class="zr-viewhead">
                    <p class="zr-viewhead__sub">
                        Find tags and correspondents that mean the same thing and merge them in Paperless-ngx. Nothing here runs on its own.
                    </p>
                </div>

                <!-- Controls: nothing scans until this button is used. -->
                <div class="zr-module" id="dupControls">
                    <div class="zr-module__body dup-controls">
                        <div class="dup-controls__field">
                            <span class="zr-label" id="dupKindLabel">Look at</span>
                            <div class="zr-segment" id="dupKind" role="group" aria-labelledby="dupKindLabel">
                                <button type="button" data-kind="tags" aria-selected="false">Tags</button>
                                <button type="button" data-kind="correspondents" aria-selected="false">Correspondents</button>
                                <button type="button" data-kind="all" aria-selected="true">Both</button>
                            </div>
                        </div>

                        <div class="dup-controls__field">
                            <label class="zr-label" for="dupSensitivity">Sensitivity</label>
                            <select class="zr-select" id="dupSensitivity">
<% dupSensitivityOptions.forEach(function (option) { -%>
                                <option value="<%= option.value %>"<%= Number(option.value) === dupDefaultThreshold ? ' selected' : '' %>><%= option.label %></option>
<% }); -%>
                                <option value="custom">Custom</option>
                            </select>
                        </div>

                        <!-- Only shown for the "Custom" preset; the scan and the
                             review then send this number divided by 100. -->
                        <div class="dup-controls__field dup-controls__custom hidden" id="dupThresholdCustomField">
                            <label class="zr-label" for="dupThresholdCustom">Threshold %</label>
                            <input class="zr-input" id="dupThresholdCustom" type="number"
                                   min="50" max="100" step="1" value="95" inputmode="numeric">
                        </div>

                        <div class="dup-controls__field dup-controls__field--check">
                            <label class="zr-row">
                                <input type="checkbox" class="zr-check" id="dupIncludeDismissed">
                                Include hidden pairs
                            </label>
                        </div>

                        <div class="dup-controls__field dup-controls__field--action">
                            <button class="zr-btn zr-btn--primary" id="dupScanBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" id="dupScanIcon" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                Scan Paperless-ngx
                            </button>
                        </div>
<% if (dupAiReviewEnabled) { -%>
                        <!-- Second row: the model judges what the scan found.
                             Disabled until a scan has produced something. -->
                        <div class="dup-ai-controls">
                            <button class="zr-btn" id="dupAiReviewBtn" type="button" disabled>
                                <svg class="zr-icon zr-icon--sm" id="dupAiReviewIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                Ask the AI
                            </button>
                            <label class="zr-row">
                                <input type="checkbox" class="zr-check" id="dupAiTitles" checked>
                                Use document titles as context
                            </label>
                            <span class="zr-sm zr-faint dup-ai-hint" id="dupAiHint">Most useful at Strict sensitivity: the near-misses below the threshold are what the model gets to judge.</span>
                        </div>
<% } -%>
                    </div>
                </div>

                <section class="zr-stats dup-stats hidden" id="dupStats" aria-label="Scan result">
                    <div class="zr-stat">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-tag"/></svg>
                            Tags scanned
                        </span>
                        <span class="zr-stat__value" id="dupStatTags">–</span>
                    </div>
                    <div class="zr-stat">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-building"/></svg>
                            Correspondents scanned
                        </span>
                        <span class="zr-stat__value" id="dupStatCorrespondents">–</span>
                    </div>
                    <div class="zr-stat">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                            Groups found
                        </span>
                        <span class="zr-stat__value" id="dupStatGroups">0</span>
                        <!-- How the groups are spread over the confidence bands;
                             filled by the page script after a scan or a review. -->
                        <span class="zr-stat__delta dup-stat__buckets" id="dupStatBuckets"></span>
                    </div>
                    <div class="zr-stat">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-layers"/></svg>
                            Documents involved
                        </span>
                        <span class="zr-stat__value" id="dupStatDocuments">0</span>
                    </div>
<% if (dupAiReviewEnabled) { -%>
                    <!-- Both stay hidden until a review has answered. -->
                    <div class="zr-stat hidden" id="dupStatAiJudgedTile">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                            AI-judged pairs
                        </span>
                        <span class="zr-stat__value" id="dupStatAiJudged">0</span>
                        <span class="zr-stat__delta" id="dupStatAiCandidates"></span>
                    </div>
                    <div class="zr-stat hidden" id="dupStatAiRequestsTile">
                        <span class="zr-stat__label">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-cpu"/></svg>
                            Model requests
                        </span>
                        <span class="zr-stat__value" id="dupStatAiRequests">0</span>
                        <span class="zr-stat__delta" id="dupStatAiTokens"></span>
                    </div>
<% } -%>
                </section>

                <!-- Merge by hand: no scan involved, the user names the target
                     and the sources themselves. Same request, same log, same
                     undo as a scanned group. Closed until it is needed, and the
                     list behind it is only fetched on the first open. -->
                <details class="zr-module dup-manual" id="dupManual">
                    <summary class="zr-module__head dup-manual__summary">
                        <svg class="zr-icon zr-icon--sm dup-manual__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                        <span class="zr-module__title" id="dupManualTitle">Merge by hand</span>
                    </summary>
                    <div class="zr-module__body dup-manual__body">
                        <p class="zr-sm zr-faint dup-manual__hint">
                            Pick what survives and what is merged into it, whether or not a scan proposed them together.
                        </p>

                        <div class="dup-manual__field">
                            <span class="zr-label" id="dupManualKindLabel">Kind</span>
                            <div class="zr-segment" id="dupManualKind" role="group" aria-labelledby="dupManualKindLabel">
                                <button type="button" data-kind="tags" aria-selected="true">Tags</button>
                                <button type="button" data-kind="correspondents" aria-selected="false">Correspondents</button>
                            </div>
                        </div>

                        <div class="dup-manual__field">
                            <label class="zr-label" for="dupManualTarget">Keep</label>
                            <div class="dup-picker" id="dupManualTargetPicker">
                                <input class="zr-input dup-picker__input" id="dupManualTarget" type="text"
                                       autocomplete="off" role="combobox" aria-expanded="false"
                                       aria-autocomplete="list" aria-controls="dupManualTargetList"
                                       placeholder="Search an entry to keep" data-selected-id="">
                                <div class="dup-picker__list hidden" id="dupManualTargetList" role="listbox" aria-label="Entries to keep"></div>
                            </div>
                        </div>

                        <div class="dup-manual__field">
                            <label class="zr-label" for="dupManualSources">Merge away</label>
                            <div class="dup-picker" id="dupManualSourcesPicker">
                                <input class="zr-input dup-picker__input" id="dupManualSources" type="text"
                                       autocomplete="off" role="combobox" aria-expanded="false"
                                       aria-autocomplete="list" aria-controls="dupManualSourcesList"
                                       placeholder="Search entries to merge away">
                                <div class="dup-picker__list hidden" id="dupManualSourcesList" role="listbox" aria-label="Entries to merge away"></div>
                            </div>
                            <div class="zr-chips dup-manual__chips" id="dupManualChips"></div>
                        </div>

                        <div class="dup-manual__warnings" id="dupManualWarnings"></div>

                        <div class="dup-manual__actions">
                            <button class="zr-btn" id="dupManualReloadBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" id="dupManualReloadIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                Reload list
                            </button>
                            <button class="zr-btn zr-btn--primary" id="dupManualMergeBtn" type="button" disabled>
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                                Merge
                            </button>
                        </div>

                        <div class="dup-manual__result" id="dupManualResult"></div>
                    </div>
                </details>

<% if (dupAiReviewEnabled) { -%>
                <!-- What the review has to say about itself: the line while it
                     runs, a warning about failed requests, or its error. -->
                <div class="dup-ai-notice" id="dupAiNotice"></div>
<% } -%>
                <!-- What to do with a long result list: put it in the order that
                     helps, and tick everything above a confidence in one move.
                     Hidden until a scan has produced groups; it re-orders and
                     ticks what is already on the page and fetches nothing. -->
                <div class="dup-results-bar hidden" id="dupResultsBar" role="group" aria-label="Sort and select results">
                    <div class="dup-results-bar__sort">
                        <label class="zr-label" for="dupSortSelect">Sort by</label>
                        <select class="zr-select" id="dupSortSelect">
                            <option value="confidence">Confidence</option>
                            <option value="documents">Documents</option>
                            <option value="name">Name</option>
                            <option value="kind">Kind</option>
                        </select>
                    </div>
                    <div class="dup-results-bar__min">
                        <label class="zr-label" for="dupMinConfidence">Confidence</label>
                        <div class="dup-results-bar__minrow">
                            <input class="zr-input" id="dupMinConfidence" type="number"
                                   min="50" max="100" step="1" value="95" inputmode="numeric"
                                   aria-describedby="dupMinConfidenceCount">
                            <span class="zr-sm zr-faint">%</span>
                            <button class="zr-btn" id="dupSelectMinBtn" type="button">Select ≥</button>
                            <span class="zr-sm zr-faint" id="dupMinConfidenceCount" aria-live="polite"></span>
                        </div>
                    </div>
                </div>

                <!-- Selecting several groups: hidden until a card is ticked,
                     then sticky under the top bar while the cards scroll past.
                     One confirmation covers everything ticked here; the cards
                     keep their own target and their own source ticks. -->
                <div class="dup-selection hidden" id="dupSelection" role="group" aria-label="Selected groups">
                    <span class="dup-selection__count" id="dupSelectionCount"></span>
                    <span class="zr-sm dup-selection__progress hidden" id="dupSelectionProgress" aria-live="polite"></span>
                    <div class="dup-selection__actions">
                        <button class="zr-btn zr-btn--ghost" id="dupSelectAllBtn" type="button">Select all</button>
                        <button class="zr-btn zr-btn--ghost hidden" id="dupSelectAiSameBtn" type="button">Select AI: same</button>
                        <button class="zr-btn zr-btn--ghost" id="dupClearSelectionBtn" type="button">Clear</button>
                        <button class="zr-btn zr-btn--primary" id="dupMergeSelectedBtn" type="button">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                            Merge selected
                        </button>
<% if (dupAiReviewEnabled) { -%>
                        <!-- The guided path: the model judges exactly the ticked
                             groups, the verdicts are shown once, and what stays
                             ticked in that dialog is merged. An addition to the
                             button before it, never a replacement for it. -->
                        <button class="zr-btn zr-btn--primary" id="dupReviewThenMergeBtn" type="button" disabled>
                            <svg class="zr-icon zr-icon--sm" id="dupReviewThenMergeIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                            Ask the AI, then merge
                        </button>
<% } -%>
                    </div>
                </div>

                <div class="dup-results" id="dupResults">
                    <div class="zr-module">
                        <div class="zr-empty">
                            <svg class="zr-icon zr-icon--lg zr-empty__icon" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                            <div class="zr-empty__title">Nothing scanned yet</div>
                            <p class="zr-sm zr-faint">Start a scan to see suggested merges.</p>
                        </div>
                    </div>
                </div>

                <section class="zr-module" id="dupLog">
                    <div class="zr-module__head">
                        <h2 class="zr-module__title">Recent merges</h2>
                        <span class="zr-module__meta" id="dupLogMeta"></span>
                    </div>
                    <div class="dup-log__alert" id="dupLogAlert"></div>
                    <div class="zr-table-wrap">
                        <table class="zr-table zr-table--stack dup-log__table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Kind</th>
                                    <th>Target</th>
                                    <th>Merged</th>
                                    <th>Documents</th>
                                    <th>Status</th>
                                    <th class="zr-table__actions">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="dupLogBody">
                                <tr>
                                    <td colspan="7" class="zr-empty">
                                        <svg class="zr-icon zr-icon--sm zr-icon--spin" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                        Loading merges…
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="zr-table-foot">
                        <span class="zr-sm zr-faint" id="dupLogInfo"></span>
                        <button class="zr-btn hidden" id="dupLogMoreBtn" type="button">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                            Show more
                        </button>
                    </div>
                </section>

                <details class="zr-module dup-hidden" id="dupDismissals">
                    <summary class="zr-module__head dup-hidden__summary">
                        <svg class="zr-icon zr-icon--sm dup-hidden__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                        <span class="zr-module__title" id="dupDismissalsSummary">Hidden pairs (0)</span>
                    </summary>
                    <div class="zr-module__body dup-hidden__list" id="dupDismissalsList"></div>
                </details>
            </div>

    <script type="module" src="/js/duplicates.js"></script>
    <%- include('partials/shell/body-close') %>
