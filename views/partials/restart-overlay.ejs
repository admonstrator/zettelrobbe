<%# Shown after a save that restarts the server. public/js/settings.js polls
    /health and reloads once a healthy answer carries a boot id other than the
    one this page was rendered with. %>
<div id="restartOverlay" class="zr-fullscreen hidden" aria-live="polite" aria-busy="true">
    <div class="zr-fullscreen__card">
        <div class="zr-row">
            <span class="zr-fullscreen__seal" aria-hidden="true">🦭</span>
            <div>
                <h3 class="zr-module__title">Restarting Zettelrobbe</h3>
                <p id="restartOverlayStatus" class="zr-sm zr-muted">Settings saved. Waiting for the server to come back…</p>
            </div>
        </div>

        <div class="zr-meter">
            <div id="restartOverlayBar" class="zr-meter__fill" style="width: 6%"></div>
        </div>
        <div class="zr-xs zr-faint" id="restartOverlayPercent">6%</div>

        <div id="restartOverlayActions" class="zr-row hidden">
            <button type="button" id="restartOverlayRetryBtn" class="zr-btn">Retry check</button>
            <button type="button" id="restartOverlayReloadBtn" class="zr-btn zr-btn--primary">Reload now</button>
        </div>
    </div>
</div>
