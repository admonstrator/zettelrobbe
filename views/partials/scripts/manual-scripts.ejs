<script>
// Global Variables
let availableTags = [];
let currentDocument = null;
let documentSelectionVersion = 0;
let suggestedTitle = null;
let currentCorrespondent = null;
let isUpdating = false;
let manualSearchController = null;

// Show message (error or success)
function showMessage(message, type = 'error') {
    const messageArea = document.getElementById('messageArea');
    const tone = type === 'error' ? 'danger' : 'ok';
    const symbol = type === 'error' ? 'i-alert-circle' : 'i-check-circle';

    messageArea.className = `zr-alert zr-alert--${tone}`;
    messageArea.innerHTML = `
        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#${symbol}"/></svg>
        <div class="zr-alert__body"><p class="zr-sm" data-message-text></p></div>
    `;
    // The message can carry server text, so it is set as text, not markup.
    messageArea.querySelector('[data-message-text]').textContent = message;
    messageArea.classList.remove('hidden');

    setTimeout(() => {
        messageArea.classList.add('hidden');
    }, 5000);
}

// API Functions
async function fetchTags() {
    try {
        const response = await fetch('/manual/tags');
        if (!response.ok) throw new Error('Failed to fetch tags');
        const tags = await response.json();
        availableTags = tags;
        updateTagSelect(tags);
    } catch (error) {
        showMessage('Error loading tags: ' + error.message);
    }
}

async function fetchDocuments() {
    try {
        const response = await fetch('/manual/documents');
        if (!response.ok) throw new Error('Failed to fetch documents');
        const documents = await response.json();
        updateDocumentSelect(documents);
    } catch (error) {
        showMessage('Error loading documents: ' + error.message);
    }
}

function getManualDocumentTitle(doc) {
    return doc?.title || `Document ${doc?.id || ''}`;
}

function setManualSearchStatus(message, isError = false) {
    const statusElement = document.getElementById('manualDocumentSearchStatus');
    if (!statusElement) return;

    statusElement.textContent = message;
    statusElement.classList.toggle('error', isError);
}

function selectManualDocument(doc) {
    const input = document.getElementById('manualDocumentSearchInput');
    const hiddenSelect = document.getElementById('documentSelect');
    if (!input || !hiddenSelect || !doc) return;

    input.value = getManualDocumentTitle(doc);
    input.dataset.selectedDocumentId = String(doc.id);
    hiddenSelect.value = String(doc.id);
    clearManualSearchResults();
    handleDocumentSelection(doc.id);
}

async function loadManualDocuments(searchTerm = '', options = {}) {
    if (!manualSearchController) return;
    await manualSearchController.load(searchTerm || '', options || {});
}

function initializeManualOmnibox() {
    const input = document.getElementById('manualDocumentSearchInput');
    const hiddenSelect = document.getElementById('documentSelect');
    if (!input || !hiddenSelect) return;

    manualSearchController = window.createDocumentOmnibox({
        preset: 'manual',
        inputId: 'manualDocumentSearchInput',
        resultsId: 'manualDocumentSearchResults',
        statusId: 'manualDocumentSearchStatus',
        hiddenInputId: 'documentSelect',
        limit: 100,
        debounceMs: 250,
        resultItemClass: 'manual-search-item',
        resultTitleClass: 'manual-search-title',
        resultMetaClass: 'manual-search-meta',
        resultPillClass: 'manual-search-pill',
        onSelect: (doc) => {
            selectManualDocument(doc);
        }
    });
}

function clearManualSearchResults() {
    if (!manualSearchController) return;
    manualSearchController.clearResults();
}

// UI Update Functions
function updateDocumentSelect(documents) {
    // Legacy function kept for compatibility. Manual view uses omnibox now.
    return documents;
}

function updateTagSelect(tags) {
    if (!Array.isArray(tags)) return;
    const select = document.getElementById('newTagSelect');
    select.innerHTML = '<option value="">Select a tag...</option>';
    tags.forEach(tag => {
        const option = document.createElement('option');
        option.value = tag.id;
        option.textContent = tag.name;
        select.appendChild(option);
    });
}

function updateCorrespondentDisplay(correspondent) {
    const correspondentInfo = document.getElementById('correspondentInfo');
    const correspondentName = document.getElementById('correspondentName');
    
    if (correspondent) {
        correspondentName.textContent = correspondent.name || correspondent;
        correspondentInfo.classList.remove('hidden');
        currentCorrespondent = correspondent;
    } else {
        correspondentInfo.classList.add('hidden');
        currentCorrespondent = null;
    }
}

function updateTitleDisplay(title) {
    const titleInfo = document.getElementById('titleInfo');
    const titleName = document.getElementById('titleName');
    
    if (title) {
        titleName.textContent = title.name || title;
        titleInfo.classList.remove('hidden');
    } else {
        titleName.textContent = '';
        titleInfo.classList.add('hidden');
    }
}

function updateMetadataSuggestions(analysis = {}) {
    suggestedTitle = typeof analysis.title === 'string' && analysis.title.trim()
        ? analysis.title : null;
    document.getElementById('suggestedTitle').textContent = suggestedTitle || '';
    document.getElementById('suggestedTitleInfo').classList.toggle('hidden', !suggestedTitle);
    const documentType = typeof analysis.document_type === 'string' ? analysis.document_type : '';
    document.getElementById('suggestedDocumentType').textContent = documentType;
    document.getElementById('suggestedDocumentTypeInfo').classList.toggle('hidden', !documentType);
}

function resolveTitleSuggestion(accept) {
    if (accept && suggestedTitle) updateTitleDisplay(suggestedTitle);
    suggestedTitle = null;
    document.getElementById('suggestedTitle').textContent = '';
    document.getElementById('suggestedTitleInfo').classList.add('hidden');
}

function updateSuggestedTags(tags) {
    if (!Array.isArray(tags)) return;
    
    const suggestedTags = document.getElementById('suggestedTags');
    suggestedTags.innerHTML = '';
    
    tags.forEach(tag => {
        const tagElement = createTagElement(tag, true);
        if (tagElement) {
            suggestedTags.appendChild(tagElement);
        }
    });
}

// Tag Management Functions

// A chip button in the shape settings.ejs and the styleguide use: the icon
// alone, so it needs a label of its own.
function createChipButton(icon, label) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'zr-link';
    button.setAttribute('aria-label', label);
    button.innerHTML = `<svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#${icon}"/></svg>`;
    return button;
}

function createTagElement(tag, isSuggested = false) {
    if (!tag) return null;

    // If tag is just an ID string/number, look up the full tag object in availableTags
    let fullTag = tag;
    if (typeof tag === 'string' || typeof tag === 'number') {
        fullTag = availableTags.find(t => t.id === parseInt(tag)) || { id: tag, name: tag };
    }

    const tagId = fullTag.id;
    const tagName = fullTag.name;

    // Suggestions are not on the document yet; the modifier sets them apart
    // from the tags it already carries.
    const tagElement = document.createElement('div');
    tagElement.className = isSuggested ? 'zr-chip manual-chip--suggested' : 'zr-chip';
    tagElement.dataset.tagId = tagId;

    const nameSpan = document.createElement('span');
    nameSpan.textContent = tagName;
    tagElement.appendChild(nameSpan);

    if (isSuggested) {
        const addButton = createChipButton('i-plus', `Add ${tagName}`);
        addButton.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            const newTag = createTagElement(tag);
            if (newTag) {
                document.getElementById('currentTags').appendChild(newTag);
                updateHiddenTagsInput(); // Update hidden input when tag is added
                tagElement.remove();
            }
        };
        tagElement.appendChild(addButton);
    }

    const removeButton = createChipButton(
        'i-x',
        isSuggested ? `Dismiss ${tagName}` : `Remove ${tagName}`
    );
    removeButton.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        tagElement.remove();
        updateHiddenTagsInput(); // Update hidden input when tag is removed
    };
    tagElement.appendChild(removeButton);

    return tagElement;
}

// Function to update the hidden input field with current tags
function updateHiddenTagsInput() {
    const currentTagElements = document.getElementById('currentTags').children;
    const tagIds = Array.from(currentTagElements)
        .map(el => el.dataset.tagId)
        .filter(id => id); // Filter out any undefined/null values

    // Update the hidden input field
    const hiddenInput = document.getElementById('tags');
    if (hiddenInput) {
        hiddenInput.value = tagIds.join(',');
    }
}

// The tag controls only make sense with a document loaded; keep them in
// step with the analyze button.
function setDocumentActionsEnabled(enabled) {
    ['analyzeBtn', 'saveTagsBtn', 'addTagBtn', 'newTagSelect'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.disabled = !enabled;
    });
}

// Document Handling Functions
async function handleDocumentSelection(documentId) {
    const selectionVersion = ++documentSelectionVersion;
    currentDocument = null;
    setDocumentActionsEnabled(false);
    updateMetadataSuggestions();
    updateTitleDisplay(null);
    updateCorrespondentDisplay(null);
    document.getElementById('aiStatus').classList.add('hidden');
    if (!documentId) {
        setDocumentActionsEnabled(false);
        document.getElementById('contentPreview').textContent = '';
        document.getElementById('currentTags').innerHTML = '';
        document.getElementById('suggestedTags').innerHTML = '';
        updateHiddenTagsInput(); // Clear hidden input when no document is selected
        return;
    }

    try {
        const response = await fetch(`/manual/preview/${documentId}`);
        if (!response.ok) throw new Error('Failed to fetch document content');
        const data = await response.json();
        if (selectionVersion !== documentSelectionVersion) return;
        
        if (!data.content) {
            throw new Error('Document content is missing');
        }
        
        document.getElementById('contentPreview').textContent = data.content || 'No content available';
        document.getElementById('hiddenId').value = data.id;
        
        document.getElementById('currentTags').innerHTML = '';
        document.getElementById('suggestedTags').innerHTML = '';

        if (data.tags && Array.isArray(data.tags)) {
            const currentTagsContainer = document.getElementById('currentTags');
            data.tags.forEach(tag => {
                const tagElement = createTagElement(tag);
                if (tagElement) {
                    currentTagsContainer.appendChild(tagElement);
                }
            });
            updateHiddenTagsInput(); // Update hidden input with initial tags
        }

        updateCorrespondentDisplay(data.correspondent);
        updateTitleDisplay(data.title);
        currentDocument = documentId;
        setDocumentActionsEnabled(true);
    } catch (error) {
        if (selectionVersion === documentSelectionVersion) showMessage('Error loading document content: ' + error.message);
    }
}

// Analysis Functions
async function handleAnalysis() {
    if (!currentDocument) return;

    const selectionVersion = documentSelectionVersion;
    updateMetadataSuggestions();
    const aiStatus = document.getElementById('aiStatus');
    document.getElementById('analyzeBtn').disabled = true;
    aiStatus.classList.remove('hidden');
    
    try {
        let content = document.getElementById('contentPreview').textContent;
        
        if (!content || content === 'No content available') {
            throw new Error('No document content available for analysis');
        }

        if(content.length> 50000) {
            content = content.substring(0, 50000);
        }

        const currentTagElements = document.getElementById('currentTags').children;
        const documentId = document.getElementById('hiddenId').value;
        const existingTags = Array.from(currentTagElements)
            .map(el => el.dataset.tagId)
            .filter(id => !isNaN(parseInt(id)))
            .map(id => parseInt(id));

        const response = await fetch('/manual/analyze', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                content: content,
                existingTags: existingTags,
                correspondent: currentCorrespondent,
                id: documentId
            })
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Analysis failed');
        }

        const result = await response.json();
        if (selectionVersion !== documentSelectionVersion) return;

        let suggestedTags = [];
        if (result.document && result.document.tags) {
            suggestedTags = result.document.tags.map(tag => ({
                id: tag,
                name: tag
            }));
        }

        updateSuggestedTags(suggestedTags);

        if (result.document && result.document.correspondent) {
            updateCorrespondentDisplay(result.document.correspondent);
        }
        updateMetadataSuggestions(result.document || {});
        showMessage('Analysis completed successfully', 'success');
    } catch (error) {
        if (selectionVersion !== documentSelectionVersion) return;
        showMessage('Error during analysis: ' + error.message);
        console.error('Analysis error:', error);
    } finally {
        if (selectionVersion === documentSelectionVersion) {
            aiStatus.classList.add('hidden');
            document.getElementById('analyzeBtn').disabled = !currentDocument;
        }
    }
}

async function updateDocumentTags() {
    if (!currentDocument || isUpdating) return;

    isUpdating = true;
    try {
        const titleElement = document.getElementById('titleName');
        const tagsElement = document.getElementById('tags');
        
        const titleValue = titleElement ? titleElement.textContent : '';
        const tagIds = tagsElement && tagsElement.value ? tagsElement.value.split(',').filter(id => id) : [];

        const response = await fetch('/manual/updateDocument', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                documentId: currentDocument,
                tags: tagIds,
                correspondent: currentCorrespondent,
                title: titleValue
            })
        });

        if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Failed to update document');
        }

        const result = await response.json();
        showMessage('Changes saved successfully', 'success');
    } catch (error) {
        showMessage('Error updating tags: ' + error.message);
        console.error('Update error:', error);
    } finally {
        isUpdating = false;
    }
}


document.addEventListener('DOMContentLoaded', function() {
    initializeManualOmnibox();
    document.getElementById('acceptTitleBtn').addEventListener('click', () => resolveTitleSuggestion(true));
    document.getElementById('declineTitleBtn').addEventListener('click', () => resolveTitleSuggestion(false));

    document.getElementById('analyzeBtn').addEventListener('click', handleAnalysis);
    document.getElementById('saveTagsBtn').addEventListener('click', updateDocumentTags);

    document.getElementById('addTagBtn').addEventListener('click', (e) => {
        e.preventDefault();
        const select = document.getElementById('newTagSelect');
        const tagId = select.value;
        if (!tagId) return;

        const tag = availableTags.find(t => t.id === parseInt(tagId));
        if (tag) {
            const tagElement = createTagElement(tag);
            if (tagElement) {
                document.getElementById('currentTags').appendChild(tagElement);
                updateHiddenTagsInput();
                select.value = '';
            }
        }
    });

    fetchTags();

    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            const formData = serializeFormWithoutEmptyTags(this);

            fetch(this.action, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(() => {
                showMessage('Settings saved successfully', 'success');
            })
            .catch(error => {
                showMessage('Error saving settings: ' + error.message);
            });
        });
    }
});

function serializeFormWithoutEmptyTags(formElement) {
    const formData = new FormData(formElement);
    const currentTags = document.getElementById('currentTags');

    if (!currentTags || currentTags.children.length === 0) {
        formData.delete('tags');
    }

    const object = {};
    formData.forEach((value, key) => {
        if (key !== 'tags' || currentTags.children.length> 0) {
            object[key] = value;
        }
    });

    return object;
}
</script>
