        </div>
        <div class="zr-welcome__contact">
            <span class="zr-welcome__contact-icon">
                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-mail"/></svg>
            </span>
            <div class="zr-welcome__contact-text">
                <span>Questions, praise, feedback</span>
                <a href="mailto:hey@admon.me">hey@admon.me</a>
            </div>
            <a
                class="zr-welcome__pgp"
                href="https://github.com/admonstrator/Admonstrator/blob/main/pgp/hey@admon.me.asc"
                target="_blank"
                rel="noopener noreferrer"
            >
                PGP key
            </a>
        </div>
        <section class="zr-welcome__changelog" aria-labelledby="changelogModalReleaseTitle">
            <div class="zr-welcome__changelog-head">
                <div class="zr-welcome__changelog-title">
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>
                    <h3 id="changelogModalReleaseTitle">What's new</h3>
                    <span id="changelogModalVersion" class="zr-sm zr-faint"></span>
                </div>
                <a
                    class="zr-welcome__changelog-link"
                    href="https://github.com/admonstrator/zettelrobbe/releases"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Release notes
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-external"/></svg>
                </a>
            </div>
            <ul class="zr-changelog-list" id="changelogModalEntries"></ul>
        </section>
        <div class="zr-welcome__foot">
            <button type="button" class="zr-welcome__later" id="changelogModalClose">
                Remind me later
            </button>
            <button type="button" class="zr-welcome__start" id="changelogModalDismiss">
                Let's go
            </button>
        </div>
    </div>
</dialog>
