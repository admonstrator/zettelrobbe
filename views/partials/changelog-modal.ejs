<!-- Welcome & What's New dialog — shown once per release (persisted per user in the DB),
     skipped on the login page (API returns 401).
     Filled and opened by /js/changelog-modal.js, loaded from the shell. -->
<dialog id="changelogModal" class="zr-dialog zr-welcome" aria-labelledby="changelogModalTitle">
    <div class="zr-welcome__story">
        <div class="zr-welcome__brand">
            <img class="no-invert" src="/logo.png" alt="" width="32" height="32">
            <span>Zettelrobbe</span>
        </div>
        <p class="zr-welcome__story-text">
            A community fork of paperless-ai built for reliable daily document automation. Heavy AI assistance,
            but steered, reviewed, and tested by a human.
        </p>
        <dl class="zr-welcome__figures">
            <div>
                <dt class="zr-welcome__warm">Countless</dt>
                <dd>energy drinks</dd>
            </div>
            <div>
                <dt class="zr-welcome__value">600+</dt>
                <dd>commits &amp; iterations</dd>
            </div>
            <div>
                <dt class="zr-welcome__value">120+</dt>
                <dd>automated test suites</dd>
            </div>
        </dl>
    </div>
    <div class="zr-welcome__main">
        <h2 id="changelogModalTitle" class="zr-welcome__title">
            Free to use. You name the price.
        </h2>
        <p class="zr-welcome__text">
            Zettelrobbe is open source under the MIT license: free for private use, freelancers, companies, and
            institutions, with no account and no license key. If it saves you time and headaches, consider chipping
            in a few energy drinks.
        </p>
        <section aria-labelledby="changelogModalWorth">
            <div class="zr-welcome__worth-head">
                <h3 id="changelogModalWorth">How many energy drinks is it worth to you?</h3>
                <span>One can is about &euro;1.50. A suggestion, not an obligation.</span>
            </div>
            <ul class="zr-welcome__tiles">
                <li>
                    <span class="zr-welcome__amount">3 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;5</span>
                    <span class="zr-welcome__who">For your private archive</span>
                </li>
                <li class="zr-welcome__tile--featured">
                    <span class="zr-welcome__amount">33 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;50, about a crate</span>
                    <span class="zr-welcome__who">For freelancers, self-employed &amp; power users</span>
                </li>
                <li>
                    <span class="zr-welcome__amount">200 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;300, eight crates</span>
                    <span class="zr-welcome__who">For companies, law firms &amp; organizations</span>
                </li>
            </ul>
        </section>
        <div class="zr-welcome__pay">
