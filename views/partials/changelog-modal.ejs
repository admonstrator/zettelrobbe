<!-- Welcome & What's New dialog — shown once per release (persisted per user in the DB),
     skipped on the login page (API returns 401).
     Filled and opened by /js/changelog-modal.js, loaded from the shell. -->
<dialog id="changelogModal" class="zr-dialog zr-welcome" aria-labelledby="changelogModalTitle">
    <div class="zr-welcome__story">
        <div class="zr-welcome__brand">
            <img class="no-invert" src="/logo.png" alt="" width="32" height="32">
            <span>Zettelrobbe</span>
        </div>
        <p class="zr-welcome__story-text">
            A community fork of paperless-ai built for reliable daily document automation. Heavy AI assistance,
            but steered, reviewed, and tested by a human.
        </p>
        <dl class="zr-welcome__figures">
            <div>
                <dt class="zr-welcome__warm">Countless</dt>
                <dd>energy drinks</dd>
            </div>
            <div>
                <dt class="zr-welcome__value">600+</dt>
                <dd>commits &amp; iterations</dd>
            </div>
            <div>
                <dt class="zr-welcome__value">120+</dt>
                <dd>automated test suites</dd>
            </div>
        </dl>
        <div class="zr-welcome__contact">
            <span class="zr-welcome__contact-icon">
                <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-mail"/></svg>
            </span>
            <div class="zr-welcome__contact-text">
                <span>Questions, praise, feedback</span>
                <a href="mailto:hey@admon.me">hey@admon.me</a>
            </div>
            <a
                class="zr-welcome__pgp"
                href="https://github.com/admonstrator/Admonstrator/blob/main/pgp/hey@admon.me.asc"
                target="_blank"
                rel="noopener noreferrer"
            >
                PGP key
            </a>
        </div>
    </div>
    <div class="zr-welcome__main">
        <!-- Shown only after an update (the status answers updated: true). The
             script then moves the focus (autofocus) and the dialog's name from
             the title to this notice, so a screen reader hears it first. -->
        <div id="changelogModalUpdate" class="zr-welcome__update hidden" tabindex="-1">
            <span class="zr-welcome__update-icon" aria-hidden="true">🎉</span>
            <p class="zr-welcome__update-text">
                <span id="changelogModalUpdateTitle" class="zr-welcome__update-title">
                    Hooray, Zettelrobbe was updated to <span id="changelogModalUpdateVersion"></span>
                </span>
                <span id="changelogModalUpdateFromLine" class="zr-welcome__update-from">
                    You were on <span id="changelogModalUpdateFrom"></span> before.
                </span>
            </p>
        </div>
        <h2 id="changelogModalTitle" class="zr-welcome__title" tabindex="-1" autofocus>
            Free to use. You name the price.
        </h2>
        <p class="zr-welcome__text">
            Zettelrobbe is open source under the MIT license: free for private use, freelancers, companies, and
            institutions, with no account and no license key. If it saves you time and headaches, consider chipping
            in a few energy drinks.
        </p>
        <section aria-labelledby="changelogModalWorth">
            <div class="zr-welcome__worth-head">
                <h3 id="changelogModalWorth">How many energy drinks is it worth to you?</h3>
                <span>One can is about &euro;1.50. A suggestion, not an obligation.</span>
            </div>
            <ul class="zr-welcome__tiles">
                <li>
                    <span class="zr-welcome__amount">3 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;5</span>
                    <span class="zr-welcome__who">For your private archive</span>
                </li>
                <li class="zr-welcome__tile--featured">
                    <span class="zr-welcome__amount">33 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;50, about a crate</span>
                    <span class="zr-welcome__who">For freelancers, self-employed &amp; power users</span>
                </li>
                <li>
                    <span class="zr-welcome__amount">200 cans</span>
                    <span class="zr-welcome__tile-title">for &euro;300, eight crates</span>
                    <span class="zr-welcome__who">For companies, law firms &amp; organizations</span>
                </li>
            </ul>
        </section>
        <%- include('pay-links') %>
        <section class="zr-welcome__changelog" aria-labelledby="changelogModalReleaseTitle">
            <div class="zr-welcome__changelog-head">
                <div class="zr-welcome__changelog-title">
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>
                    <h3 id="changelogModalReleaseTitle">What's new</h3>
                    <span id="changelogModalVersion" class="zr-sm zr-faint"></span>
                </div>
                <a
                    class="zr-welcome__changelog-link"
                    href="https://github.com/admonstrator/zettelrobbe/releases"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Release notes
                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-external"/></svg>
                </a>
            </div>
            <ul class="zr-changelog-list" id="changelogModalEntries"></ul>
        </section>
        <div class="zr-welcome__foot">
            <button type="button" class="zr-welcome__later" id="changelogModalClose">
                Remind me later
            </button>
            <button type="button" class="zr-welcome__start" id="changelogModalDismiss">
                Let's go
            </button>
        </div>
    </div>
</dialog>
