<article class="zr-module" data-widget="task-runner" data-span="<%= widget.span %>">
    <div class="zr-module__head">
        <span class="zr-dot zr-dot--ok" id="runnerDot"></span>
        <h2 class="zr-module__title">Task runner</h2>
        <div class="zr-module__actions">
            <span class="zr-sm zr-faint zr-freshness" id="statusLastUpdated"></span>
            <button class="zr-btn zr-btn--primary" type="button" id="scanButton">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-play"/></svg>
                <span>Scan now</span>
            </button>
            <button class="zr-btn zr-btn--danger hidden" type="button" id="stopScanButton" aria-label="Stop scan">
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-stop"/></svg>
                <span>Stop</span>
            </button>
        </div>
    </div>
    <div class="zr-module__body zr-col">
        <div class="zr-row">
            <div class="zr-grow zr-col zr-col--tight">
                <strong id="runnerLabel">System idle</strong>
                <span class="zr-sm zr-faint zr-truncate" id="runnerDetail">Waiting for new documents</span>
            </div>
            <span class="zr-badge zr-badge--info hidden" id="currentDocId"></span>
            <%- include('../runner-seal') %>
        </div>

        <!-- The board, like the pick-up screen at a counter: per lane the
             documents that wait, the ones in progress and the last ones done.
             Filled from activity in /api/processing-status by the dashboard
             module. Not a live region: the timers change every second. -->
        <div class="runner-board" id="runnerBoard">
            <div class="runner-board__head" aria-hidden="true">
                <span></span>
                <span>Waiting</span>
                <span>In progress</span>
                <span>Ready</span>
            </div>
            <% [['analysis', 'Analysis'], ['ocr', 'OCR']].forEach(function (lane) { %>
            <div class="runner-lane" data-lane="<%= lane[0] %>">
                <span class="runner-lane__name"><%= lane[1] %></span>
                <div class="runner-lane__cell" data-col="waiting">
                    <span class="runner-lane__label">Waiting</span>
                    <div class="runner-lane__items" data-lane-waiting></div>
                </div>
                <div class="runner-lane__cell" data-col="active">
                    <span class="runner-lane__label">In progress</span>
                    <div class="runner-lane__items" data-lane-active></div>
                </div>
                <div class="runner-lane__cell" data-col="ready">
                    <span class="runner-lane__label">Ready</span>
                    <div class="runner-lane__items" data-lane-ready></div>
                </div>
            </div>
            <% }) %>
        </div>

        <!-- The scan clock. Ticks between two polls; deliberately not a live
             region either. -->
        <div class="scan-clock zr-sm" id="scanClock">
            <div class="zr-kv"><span class="zr-kv__k">Last scan</span><span class="zr-kv__v" id="scanLastRun">&mdash;</span></div>
            <div class="zr-kv"><span class="zr-kv__k">Next scan</span><span class="zr-kv__v" id="scanNextRun">&mdash;</span></div>
            <div class="zr-kv"><span class="zr-kv__k">Schedule</span><span class="zr-kv__v" id="scanSchedule">&mdash;</span></div>
            <div class="zr-kv hidden" id="ocrNextRunRow"><span class="zr-kv__k">Next OCR run</span><span class="zr-kv__v" id="ocrNextRun">&mdash;</span></div>
        </div>

        <div class="zr-row zr-row--wrap zr-sm zr-muted" style="gap: var(--zr-4)">
            <span><strong class="zr-num" id="processedToday">0</strong> processed today</span>
            <span>last document <strong id="lastProcessed">no data</strong></span>
        </div>
    </div>

    <div class="zr-module__foot">
        <div class="zr-row zr-row--between">
            <span>Recent activity</span>
            <a class="zr-row" href="/history" style="gap: 4px">
                History
                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
            </a>
        </div>
    </div>
    <div class="zr-list" id="recentActivityList"></div>
</article>
