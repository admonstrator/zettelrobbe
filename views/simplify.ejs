<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Simplify tags - Zettelrobbe' }) %>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Simplify tags',
    version: typeof version !== 'undefined' ? version : ''
}) %>
<%
/* The model-backed runs are only offered when the route says a provider is
   configured and the AI review is switched on. Everything else on this page —
   editing the vocabulary, the rule pass, every edit of a proposal, every group
   decision and the apply itself — works without a model, so nothing below
   depends on this local except the buttons that talk to one. */
const simAiEnabled = typeof aiReviewEnabled !== 'undefined' && aiReviewEnabled === true;
-%>
            <div>
                <div class="zr-viewhead">
                    <p class="zr-viewhead__sub">
                        Turn compound tags into a document type and topic tags. Nothing here runs on its own.
                    </p>
                </div>

                <!-- The proposed order: one job reads every tag and every
                     document type, proposes the vocabulary and gives every tag
                     an action. The groups are the unit of review; the table
                     further down is the same rows one by one. -->
                <section class="zr-module" id="simOrder">
                    <div class="zr-module__head sim-order__head">
                        <h2 class="zr-module__title">Proposed order</h2>
                        <span class="zr-module__meta" id="simOrderMeta"></span>
                        <button class="zr-btn zr-btn--primary sim-order__apply-all" id="simApplyAcceptedBtn" type="button" disabled>
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check"/></svg>
                            <span id="simApplyAcceptedLabel">Apply all accepted (0)</span>
                        </button>
                    </div>
                    <div class="zr-module__body zr-col zr-col--loose">
                        <p class="zr-sm zr-faint">
                            The model reads every tag and every document type, proposes a vocabulary and sorts every tag into it. Nothing here runs on its own.
                        </p>
                        <div class="sim-actions">
<% if (simAiEnabled) { -%>
                            <button class="zr-btn zr-btn--primary" id="simOrderBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" id="simOrderIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                Propose a new order
                            </button>
<% } else { -%>
                            <p class="zr-sm zr-faint sim-hint" id="simOrderAiHint">
                                The AI review is switched off in the settings; the page can only propose splits by rule from a saved vocabulary.
                            </p>
<% } -%>
                            <!-- Only offered once something is saved: without a
                                 vocabulary there is nothing to keep. -->
                            <label class="zr-row sim-order__keep hidden" id="simOrderKeepWrap">
                                <input type="checkbox" class="zr-check" id="simOrderKeepVocabulary">
                                <span class="zr-sm">Keep my vocabulary</span>
                            </label>
                        </div>

                        <!-- The same panel the Duplicates page uses for a
                             review: every job of this page runs through the one
                             job service, so a reloaded page can attach to any
                             of them. -->
                        <div class="sim-progress hidden" id="simProgress" role="status" aria-live="polite">
                            <div class="sim-progress__bar" id="simProgressBar" role="progressbar" aria-label="Job progress">
                                <div class="sim-progress__fill" id="simProgressFill"></div>
                            </div>
                            <div class="sim-progress__text">
                                <span class="zr-sm" id="simProgressMessage"></span>
                                <span class="zr-sm zr-faint zr-mono" id="simProgressCounts"></span>
                                <span class="zr-sm zr-faint" id="simProgressEta"></span>
                            </div>
                            <div class="sim-progress__actions">
                                <button class="zr-btn zr-btn--ghost" id="simStopBtn" type="button">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-x"/></svg>
                                    <span class="sim-progress__stop-label">Stop</span>
                                </button>
                            </div>
                        </div>

                        <p class="zr-sm sim-order__summary hidden" id="simOrderSummary" aria-live="polite"></p>
                        <div class="sim-apply-result" id="simApplyResult" aria-live="polite"></div>

                        <section class="zr-stats sim-stats hidden" id="simOrderStats" aria-label="Group counts">
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-file"/></svg>
                                    Types
                                </span>
                                <span class="zr-stat__value" id="simStatGroupTypes">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-tag"/></svg>
                                    Topics
                                </span>
                                <span class="zr-stat__value" id="simStatGroupTopics">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                                    Merges
                                </span>
                                <span class="zr-stat__value" id="simStatGroupMerges">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                    Delete
                                </span>
                                <span class="zr-stat__value" id="simStatGroupDelete">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                                    Keep
                                </span>
                                <span class="zr-stat__value" id="simStatGroupKeep">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check"/></svg>
                                    Accepted
                                </span>
                                <span class="zr-stat__value" id="simStatOrderAccepted">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-split"/></svg>
                                    Applied
                                </span>
                                <span class="zr-stat__value" id="simStatOrderApplied">0</span>
                            </div>
                        </section>

                        <!-- Groups are how this page is read; the table below is
                             the detail view of the very same proposals. -->
                        <div class="sim-view" id="simViewField">
                            <span class="zr-label" id="simViewLabel">View</span>
                            <div class="zr-segment" id="simView" role="group" aria-labelledby="simViewLabel">
                                <button type="button" data-view="groups" aria-selected="true">Groups</button>
                                <button type="button" data-view="table" aria-selected="false">Table</button>
                            </div>
                        </div>

                        <div class="sim-filters" id="simGroupFilters">
                            <div class="sim-filters__field sim-filters__field--wide">
                                <span class="zr-label" id="simGroupKindLabel">Kind</span>
                                <div class="zr-segment" id="simGroupKind" role="group" aria-labelledby="simGroupKindLabel">
                                    <button type="button" data-kind="all" aria-selected="true">All</button>
                                    <button type="button" data-kind="type" aria-selected="false">Types</button>
                                    <button type="button" data-kind="topic" aria-selected="false">Topics</button>
                                    <button type="button" data-kind="merge" aria-selected="false">Merges</button>
                                    <button type="button" data-kind="delete" aria-selected="false">Delete</button>
                                    <button type="button" data-kind="keep" aria-selected="false">Keep</button>
                                </div>
                            </div>
                            <div class="sim-filters__field sim-filters__field--wide">
                                <span class="zr-label" id="simGroupStatusLabel">Show</span>
                                <div class="zr-segment" id="simGroupStatus" role="group" aria-labelledby="simGroupStatusLabel">
                                    <button type="button" data-group-status="open" aria-selected="true">Open</button>
                                    <button type="button" data-group-status="accepted" aria-selected="false">Accepted</button>
                                    <button type="button" data-group-status="applied" aria-selected="false">Applied</button>
                                    <button type="button" data-group-status="skipped" aria-selected="false">Skipped</button>
                                    <button type="button" data-group-status="all" aria-selected="false">All</button>
                                </div>
                            </div>
                            <div class="sim-filters__field zr-grow">
                                <label class="zr-label" for="simGroupSearch">Search</label>
                                <input class="zr-input" id="simGroupSearch" type="search" autocomplete="off" placeholder="Filter by group or tag name">
                            </div>
                        </div>

                        <div class="sim-groups" id="simGroups"></div>
                        <div class="zr-empty sim-order__empty hidden" id="simOrderEmpty"></div>
                    </div>
                </section>

                <!-- The target vocabulary: the couple of dozen concepts the
                     archive should end up with. Local names, not objects in
                     Paperless-ngx — a split creates the object it needs. The
                     order job proposes it, so the block stays closed once one
                     is saved. -->
                <details class="zr-module sim-vocab-module" id="simVocabularyBlock">
                    <summary class="zr-module__head sim-vocab__summary" id="simVocabulary">
                        <svg class="zr-icon zr-icon--sm sim-vocab__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-right"/></svg>
                        <span class="zr-module__title">Vocabulary</span>
                        <span class="zr-module__meta" id="simVocabularyMeta"></span>
                    </summary>
                    <div class="zr-module__body zr-col zr-col--loose">
                        <p class="zr-sm zr-faint">
                            A document type is the kind of document (Rechnung, Brief, Vertrag). A topic is what it is about (Strom, Auto). "Stromrechnung" is the type "Rechnung" plus the topic "Strom".
                        </p>
                        <div class="sim-notice" id="simVocabularyNotice"></div>
                        <div class="sim-vocab">
                            <div class="sim-vocab__col">
                                <span class="zr-label" id="simTypesLabel">Document types</span>
                                <div class="zr-chips sim-chips" id="simTypes" role="list" aria-labelledby="simTypesLabel"></div>
                                <!-- The one field of this page that offers what
                                     Paperless-ngx already has. The type select
                                     per proposal stays limited to the
                                     vocabulary, so a split never bypasses it. -->
                                <div class="sim-vocab__pick">
                                    <div class="zr-picker" id="simTypePicker">
                                        <input class="zr-input zr-picker__input sim-vocab__input" id="simTypeInput" type="text"
                                               autocomplete="off" role="combobox" aria-expanded="false"
                                               aria-autocomplete="list" aria-controls="simTypeList"
                                               placeholder="Search a document type or type a new one"
                                               aria-label="Add a document type">
                                        <div class="zr-picker__list hidden" id="simTypeList" role="listbox" aria-label="Document types in Paperless-ngx"></div>
                                    </div>
                                    <button class="zr-btn zr-btn--ghost zr-btn--icon" id="simTypesReloadBtn" type="button" aria-label="Reload document types">
                                        <svg class="zr-icon zr-icon--sm" id="simTypesReloadIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                    </button>
                                </div>
                                <p class="zr-sm zr-faint sim-hint hidden" id="simTypesNote" aria-live="polite"></p>
                            </div>
                            <div class="sim-vocab__col">
                                <span class="zr-label" id="simTopicsLabel">Topics</span>
                                <div class="zr-chips sim-chips" id="simTopics" role="list" aria-labelledby="simTopicsLabel"></div>
                                <input class="zr-input sim-vocab__input" id="simTopicInput" type="text"
                                       autocomplete="off" placeholder="Add a topic, then press Enter"
                                       aria-label="Add a topic">
                                <p class="zr-sm zr-faint sim-hint hidden" id="simTopicHint" aria-live="polite"></p>
                            </div>
                        </div>
                        <!-- Offered only while the vocabulary holds no type and
                             Paperless-ngx holds at least one: one click puts
                             them into the list, unsaved, as a proposal would. -->
                        <div class="zr-alert zr-alert--info sim-adopt hidden" id="simAdoptTypes"></div>
                        <div class="sim-actions">
<% if (simAiEnabled) { -%>
                            <button class="zr-btn" id="simProposeVocabularyBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" id="simProposeVocabularyIcon" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                Propose from my tags
                            </button>
<% } -%>
                            <button class="zr-btn zr-btn--primary" id="simSaveVocabularyBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                Save vocabulary
                            </button>
                            <!-- The order job again, against exactly these
                                 names: the model proposes no new ones. -->
                            <button class="zr-btn hidden" id="simReproposeBtn" type="button">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                Re-propose with this vocabulary
                            </button>
                        </div>
                    </div>
                </details>

                <!-- The detail view: every proposal of the order, one row each,
                     editable the way round 10 left it. -->
                <section class="zr-module hidden" id="simProposals">
                    <div class="zr-module__head">
                        <h2 class="zr-module__title">Proposals</h2>
                        <span class="zr-module__meta" id="simProposalsMeta"></span>
                    </div>
                    <div class="zr-module__body zr-col zr-col--loose">
                        <div class="sim-actions">
                            <button class="zr-btn zr-btn--primary" id="simProposeSplitsBtn" type="button" disabled>
                                <svg class="zr-icon zr-icon--sm" id="simProposeSplitsIcon" aria-hidden="true"><use href="/icons.svg#i-split"/></svg>
                                Propose splits
                            </button>
                            <span class="zr-sm zr-faint" id="simProposeSplitsHint">Save a vocabulary first</span>
                        </div>

                        <section class="zr-stats sim-stats hidden" id="simStats" aria-label="Proposal counts">
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-tag"/></svg>
                                    Proposals
                                </span>
                                <span class="zr-stat__value" id="simStatProposals">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-inbox"/></svg>
                                    Open
                                </span>
                                <span class="zr-stat__value" id="simStatOpen">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-check"/></svg>
                                    By rule
                                </span>
                                <span class="zr-stat__value" id="simStatRule">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                    By model
                                </span>
                                <span class="zr-stat__value" id="simStatModel">0</span>
                            </div>
                            <div class="zr-stat">
                                <span class="zr-stat__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-split"/></svg>
                                    Applied
                                </span>
                                <span class="zr-stat__value" id="simStatApplied">0</span>
                            </div>
                        </section>

                        <div class="sim-filters" id="simFilters">
                            <div class="sim-filters__field">
                                <span class="zr-label" id="simStatusLabel">Show</span>
                                <div class="zr-segment" id="simStatusFilter" role="group" aria-labelledby="simStatusLabel">
                                    <button type="button" data-status="open" aria-selected="true">Open</button>
                                    <button type="button" data-status="accepted" aria-selected="false">Accepted</button>
                                    <button type="button" data-status="skipped" aria-selected="false">Skipped</button>
                                    <button type="button" data-status="applied" aria-selected="false">Applied</button>
                                </div>
                            </div>
                            <div class="sim-filters__field zr-grow">
                                <label class="zr-label" for="simSearch">Search</label>
                                <input class="zr-input" id="simSearch" type="search" autocomplete="off" placeholder="Filter by tag name">
                            </div>
                        </div>

                        <div class="sim-proposals__alert" id="simProposalsAlert"></div>

                        <!-- The topics of the vocabulary, offered to every
                             topic input of the table below. One list for all
                             rows; the page script fills it after the load. -->
                        <datalist id="simTopicOptions"></datalist>

                        <div class="zr-table-wrap">
                            <table class="zr-table zr-table--stack sim-proposals__table" id="simProposalsTable">
                                <thead>
                                    <tr>
                                        <th class="sim-proposals__actioncol">Action</th>
                                        <th class="sim-proposals__pickcol">Apply</th>
                                        <th>Tag</th>
                                        <th>Documents</th>
                                        <th class="sim-proposals__typecol">&rarr; Type</th>
                                        <th class="sim-proposals__topicscol">&rarr; Topics</th>
                                        <th>Source</th>
                                        <th class="sim-proposals__reasoncol">Reason</th>
                                        <th class="sim-proposals__statuscol">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="simProposalsBody"></tbody>
                            </table>
                        </div>

                        <div class="sim-apply">
                            <span class="zr-sm sim-apply__status hidden" id="simApplyStatus" aria-live="polite"></span>
                            <div class="sim-apply__actions">
                                <button class="zr-btn zr-btn--ghost" id="simSelectOpenBtn" type="button">Select all open</button>
                                <button class="zr-btn zr-btn--ghost" id="simClearSelectionBtn" type="button">Clear</button>
                                <button class="zr-btn" id="simSkipBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye-off"/></svg>
                                    Skip
                                </button>
                                <button class="zr-btn zr-btn--primary" id="simApplyBtn" type="button" disabled>
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-split"/></svg>
                                    Apply selected
                                </button>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

    <script type="module" src="/js/simplify.js"></script>
    <%- include('partials/shell/body-close') %>
