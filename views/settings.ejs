                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="customApiKey" class="zr-field__name">Custom API Key</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="customApiKey" name="customApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.CUSTOM_API_KEY ? 'Configured' : 'Enter Custom API key' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="customApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p class="zr-field__hint">Restart required<%= configuredSecrets.CUSTOM_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
