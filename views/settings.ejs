                                <div id="customSettings" class="zr-col zr-col--loose hidden">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="customBaseUrl" class="zr-field__name">Custom Base URL</label>
                                        <input type="text" id="customBaseUrl" name="customBaseUrl" value="<%= config.CUSTOM_BASE_URL %>" class="zr-input">
