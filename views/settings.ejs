<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Settings' }) %>
    <script src="/vendor/sortable/Sortable.min.js"></script>
    <script src="/js/dialogs.js"></script>
    <script src="/js/chip-list.js"></script>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Settings',
    version: typeof version !== 'undefined' ? version : ''
}) %>
<%
    // The Claude models and effort levels come from services/anthropicSupport.js
    // through the route; a render without them still produces a usable page.
    const anthropic = (typeof anthropicOptions !== 'undefined' && anthropicOptions) || {};
    const anthropicSuggestedModels = Array.isArray(anthropic.suggestedModels) ? anthropic.suggestedModels : [];
    const anthropicEffortLevels = Array.isArray(anthropic.effortLevels) ? anthropic.effortLevels : [];
    const anthropicEffortLabels = { low: 'Low', medium: 'Medium', high: 'High', xhigh: 'Extra high', max: 'Max' };
    const anthropicSelected = config.AI_PROVIDER === 'anthropic';
    const anthropicSwitchOn = (value) => ['yes', 'true', '1'].includes(String(value || 'yes').trim().toLowerCase());
    // A stored OCR key belongs to the OCR provider it was saved for; the save
    // route clears it when the provider crosses to or from Claude.
    const ocrStoredForAnthropic = (config.OCR_PROVIDER || 'mistral') === 'anthropic';
    const ocrKeyConfiguredDefault = ocrStoredForAnthropic ? configuredSecrets.MISTRAL_API_KEY : (configuredSecrets.OCR_API_KEY || configuredSecrets.MISTRAL_API_KEY);
    const ocrKeyConfiguredAnthropic = ocrStoredForAnthropic && configuredSecrets.OCR_API_KEY;

    // What the environment decides (partials/settings-environment.ejs, from
    // services/environmentOverview.js); its topic link counts the variables
    // the topic lists. A render without it shows the topic empty.
    const environmentTopic = (typeof environmentOverview === 'object' && environmentOverview) || null;

    // One topic per view. The ids are the URL hashes (#sso, #ai-provider), and
    // public/js/modules/settings-nav.js maps the hashes the page used before the
    // regrouping (#ai-tab, #sec-provider, ...) onto these. Every entry stays in
    // the one form: switching only toggles .hidden, so saving still sends all.
    // A group's key names it in the topic list (its fold state); an entry's
    // lead is the sentence under its title that says what the topic is for.
    const settingsGroups = [
        // The first entry opens on a bare /settings (partials/settings-quick-start.ejs,
        // which brings its own lead).
        { key: 'essentials', label: 'Essentials', icon: 'i-zap', entries: [
            { id: 'quick-start', title: 'Quick start', featured: true, lead: 'Six decisions Zettelrobbe needs before it analyses your documents. Every other setting starts with a default and has its own topic.' }
        ] },
        { key: 'basics', label: 'Basics', icon: 'i-home', entries: [
            { id: 'connection', title: 'Paperless-ngx connection', lead: 'Where Zettelrobbe reaches Paperless-ngx, with which token, and which address the links to a document open.' },
            { id: 'display', title: 'Display', lead: 'How Zettelrobbe shows dates on its pages.' }
        ] },
        { key: 'analysis', label: 'Document analysis', icon: 'i-cpu', entries: [
            { id: 'ai-provider', title: 'AI provider', lead: 'The service and the model that read your documents, and how much of a document they get.' },
            { id: 'ai-behavior', title: 'What the AI fills in', lead: 'Which fields of a document Zettelrobbe writes, and which tags it adds or takes off once the analysis is written.' },
            { id: 'prompt', title: 'Prompt', lead: 'What the model is told with every document, and which Paperless-ngx names it gets with it.' },
            { id: 'restrictions', title: 'Existing names only', lead: 'Whether the model may create tags, correspondents and document types, or only use the ones Paperless-ngx has.' },
            { id: 'custom-fields', title: 'Custom fields', lead: 'The Paperless-ngx custom fields the model fills in for every document.' },
            { id: 'external-data', title: 'External data', lead: 'Zettelrobbe calls an address of your choice before an analysis and hands the answer to the model with your prompt.' },
            { id: 'ocr', title: 'OCR', lead: 'When Zettelrobbe sends a document to OCR, which service reads it, and how many pages of a PDF it reads.' }
        ] },
        { key: 'processing', label: 'Processing', icon: 'i-clock', entries: [
            { id: 'schedule', title: 'Schedule and tag filters', lead: 'When Zettelrobbe looks for documents it has not analysed yet, and which of them a scan takes or passes over.' },
            { id: 'skip-rules', title: 'Skip rules', badge: 'New', lead: 'Documents that go to the ignored list before Zettelrobbe sends them to OCR or to the model.' }
        ] },
        { key: 'tags', label: 'Tag tools', icon: 'i-tag', entries: [
            { id: 'tidy-up', title: 'Tidy up', lead: 'How the model takes part in Tidy up, and how much a run may spend.' }
        ] },
        { key: 'security', label: 'Sign-in and security', icon: 'i-shield', entries: [
            { id: 'account', title: 'Account and two-factor', lead: 'A code from an authenticator app as a second step when you sign in.' },
            { id: 'sso', title: 'Single sign-on', badge: 'New', lead: 'Signing in through an OpenID Connect provider, in addition to the password.' },
            { id: 'api-key', title: 'API key', lead: 'The key the REST API and the Paperless-ngx post-consume script sign in with.' }
        ] },
        { key: 'system', label: 'System', icon: 'i-server', entries: [
            { id: 'runtime', title: 'Server', lead: 'How the Zettelrobbe server runs: its port, the proxy in front of it, its cookies, how many requests it takes and how much it logs.' },
            { id: 'caching', title: 'Caching and history', lead: 'The tags and previews Zettelrobbe keeps to answer faster, and when it removes its records of documents deleted in Paperless-ngx.' },
            { id: 'quickstart', title: 'Detect models', lead: 'Asks a server such as Ollama or LM Studio which models it offers, and fills in the ones you pick under AI provider and OCR.' },
            { id: 'set-by-environment', title: 'Set by the environment', count: environmentTopic ? environmentTopic.count : 0, lead: 'Which settings the environment decides, usually the lines of your docker-compose file, and how to take them over into the stored settings.' },
            { id: 'environment', title: 'Export', lead: 'The configuration in use as a .env file, to move this instance or to copy its settings.' },
            { id: 'changelog', title: 'Changelog', lead: 'What changed in each release, newest first.' }
        ] }
    ];
    const settingsFirstEntry = settingsGroups[0].entries[0].id;
    const settingsEsc = (value) => String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

    // Single sign-on: the status of the running configuration and the callback
    // URL derived from this request. Both come from the route; a render without
    // them still produces a usable page.
    const oidcSwitchOn = (value, fallback) => ['yes', 'true', '1'].includes(String(value || fallback).trim().toLowerCase());
    const oidcRedirectDetected = (typeof oidcDetectedRedirectUri === 'string' && oidcDetectedRedirectUri) ? oidcDetectedRedirectUri : '';
    const oidcState = (typeof oidcStatus === 'object' && oidcStatus) ? oidcStatus : { enabled: oidcSwitchOn(config.OIDC_ENABLED, 'no'), errors: [] };
    const oidcErrors = Array.isArray(oidcState.errors) ? oidcState.errors.map(String).filter(Boolean) : [];
    const oidcPill = !oidcState.enabled
        ? { tone: '', text: 'Off' }
        : oidcErrors.length
            ? { tone: 'zr-badge--warn', text: 'On, but incomplete: ' + oidcErrors.join(' ') }
            : { tone: 'zr-badge--ok', text: 'On' };

    const entryOpen = (id) => {
        const group = settingsGroups.find((g) => g.entries.some((e) => e.id === id));
        const entry = group.entries.find((e) => e.id === id);
        // Single sign-on says whether the running configuration works; Quick
        // start how many of its steps are done (modules/settings-quick-start.js).
        const pill = id === 'sso'
            ? `<span class="zr-badge ${oidcPill.tone} zr-settings-entry__status" id="oidcStatusPill" title="Status of the running configuration">${settingsEsc(oidcPill.text)}</span>`
            : entry.featured
                ? '<span class="zr-badge zr-badge--brand zr-qs__count" data-qs-count></span>'
                : '';
        // A featured entry stands outside the groups, so it names none.
        const groupLine = entry.featured ? '' : `<p class="zr-settings-entry__group">${settingsEsc(group.label)}</p>`;
        // The head names the topic: its group as a quiet line, its title and
        // one sentence on what it is for. The title takes the focus when the
        // save bar it came from goes away (modules/settings-form.js).
        const lead = entry.lead ? `<p class="zr-settings-entry__lead">${settingsEsc(entry.lead)}</p>` : '';
        // A topic is one card, like the cards of every other page: the head
        // above, the sections in the body, one block after the other
        // (pages/settings.css rules them off). entryClose() ends both.
        return `<section class="zr-settings-entry zr-module${id === settingsFirstEntry ? '' : ' hidden'}" id="entry-${id}" data-entry="${id}" data-group="${settingsEsc(group.label)}" data-title="${settingsEsc(entry.title)}" aria-labelledby="entry-${id}-title">
                            <header class="zr-module__head zr-settings-entry__head">
                                ${groupLine}
                                <div class="zr-settings-entry__titlerow">
                                    <h2 class="zr-settings-entry__title" id="entry-${id}-title" tabindex="-1">${settingsEsc(entry.title)}</h2>
                                    ${pill}
                                </div>
                                ${lead}
                            </header>
                            <div class="zr-module__body zr-module__body--tight zr-settings-entry__body">`;
    };
    const entryClose = () => '</div></section>';

    // A section is a block of the topic card, not a card of its own: the
    // section element itself (<section class="zr-settings-section">) is
    // written out where it stands, with its id, so an old link to #sec-...
    // lands on it. This is the top of the block: its title, with `action` (a
    // button that acts on the whole section) beside it, and under it one line
    // on what the section holds. `desc` may carry a link. The rows follow in
    // .zr-settings-section__body.
    const sectionHead = (id, title, desc, action = '') => `<div class="zr-settings-section__head">
                                        <h3 class="zr-settings-section__title" id="${id}-title">${settingsEsc(title)}</h3>
                                        ${action ? `<div class="zr-settings-section__actions">${action}</div>` : ''}
                                    </div>
                                    ${desc ? `<p class="zr-settings-section__desc">${desc}</p>` : ''}`;
    // A section that folds: Advanced options of the AI sections, Advanced of
    // single sign-on. The same block, its head a summary with a chevron;
    // `attrs` carries the id and any data attributes, `hint` says what is in
    // it while it is closed.
    const disclosureOpen = (attrs, title, hint) => `<details class="zr-settings-section zr-settings-disclosure" ${attrs}>
                                    <summary class="zr-settings-section__head zr-settings-disclosure__summary">
                                        <h3 class="zr-settings-section__title">${settingsEsc(title)}</h3>
                                        <span class="zr-field__hint zr-grow">${settingsEsc(hint)}</span>
                                        <svg class="zr-icon zr-icon--sm zr-settings-disclosure__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                    </summary>`;
%>
<%
    // The topic list: an entry with `featured: true` (Quick start) stands
    // above the groups on its own, ruled off from them; every other entry is
    // listed under its group. A group heading is a button that folds its
    // topics in and out (public/js/modules/settings-nav.js opens the group
    // of the open topic). The phone picker follows the same order.
    const settingsFeatured = settingsGroups.flatMap((group) => group.entries.filter((entry) => entry.featured));
    const settingsNavGroups = (settingsFeatured.length ? [{ featured: true, key: 'featured', label: '', icon: '', entries: settingsFeatured }] : [])
        .concat(settingsGroups.map((group) => ({ featured: false, key: group.key, label: group.label, icon: group.icon, entries: group.entries.filter((entry) => !entry.featured) })))
        .filter((group) => group.entries.length);
%>
            <div class="zr-settings-page" data-module="settings-nav">
                <div class="zr-settings-frame" data-module="settings-form">
                <div class="zr-settings-scroll" data-el="scroller">
                <div class="zr-settings">
                    <%# The topic list is a card like the cards of every other
                        page. On a phone it holds the field and the topic
                        picker; the list itself shows only what a search
                        found. %>
                    <aside class="zr-settings__aside">
                        <div class="zr-module">
                        <div class="zr-module__body zr-settings-side">
                            <div class="zr-settings-find" role="search">
                                <label for="settingsSearch" class="zr-settings-find__label">Find a setting</label>
                                <div class="zr-settings-find__box">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                    <input type="search" class="zr-input" data-el="search" id="settingsSearch"
                                        placeholder="e.g. token limit, cron, tag"
                                        aria-describedby="settingsSearchStatus"
                                        autocomplete="off" spellcheck="false">
                                </div>
                                <p class="zr-settings-find__status" id="settingsSearchStatus" data-el="search-status" role="status" aria-live="polite"></p>
                            </div>
                            <nav class="zr-sectionnav zr-settings-nav" aria-label="Settings topics" data-el="nav">
                                <% settingsNavGroups.forEach((group) => { %>
                                <div class="zr-settings-nav__group<%= group.featured ? ' zr-settings-nav__group--featured' : '' %>" data-nav-group="<%= group.key %>" data-group="<%= group.label %>">
                                    <% if (!group.featured) { %>
                                    <button type="button" class="zr-settings-nav__toggle" id="settingsNavToggle-<%= group.key %>" aria-expanded="false" aria-controls="settingsNavItems-<%= group.key %>" data-nav-toggle="<%= group.key %>">
                                        <span class="zr-grow"><%= group.label %></span>
                                        <span class="zr-settings-nav__count hidden" data-group-count="<%= group.key %>"></span>
                                        <span class="zr-settings-nav__dirty hidden" data-group-dirty="<%= group.key %>" title="Unsaved changes"><span class="zr-sr">Unsaved changes</span></span>
                                        <span class="zr-settings-nav__size"><%= group.entries.length %><span class="zr-sr"><%= group.entries.length === 1 ? ' topic' : ' topics' %></span></span>
                                        <svg class="zr-icon zr-icon--sm zr-settings-nav__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                    </button>
                                    <div class="zr-settings-nav__items" id="settingsNavItems-<%= group.key %>" role="group" aria-labelledby="settingsNavToggle-<%= group.key %>" hidden>
                                    <% } %>
                                    <% group.entries.forEach((entry) => { %>
                                    <a href="#<%= entry.id %>"<%- group.featured ? ' class="zr-settings-nav__featured"' : '' %> data-entry-link="<%= entry.id %>" aria-current="<%= entry.id === settingsFirstEntry ? 'page' : 'false' %>">
                                        <span class="zr-grow"><%= entry.title %></span>
                                        <% if (entry.badge) { %><span class="zr-badge zr-badge--brand"><%= entry.badge %></span><% } %>
                                        <% if (entry.count) { %><span class="zr-settings-nav__count zr-settings-nav__listed" data-entry-listed="<%= entry.id %>"><%= entry.count %><span class="zr-sr"><%= entry.count === 1 ? ' variable listed' : ' variables listed' %></span></span><% } %>
                                        <span class="zr-settings-nav__count hidden" data-entry-count="<%= entry.id %>"></span>
                                        <span class="zr-settings-nav__dirty hidden" data-entry-dirty="<%= entry.id %>" title="Unsaved changes"></span>
                                    </a>
                                    <% }) %>
                                    <% if (!group.featured) { %>
                                    </div>
                                    <% } %>
                                </div>
                                <% }) %>
                            </nav>

                            <div class="zr-only-mobile zr-settings-picker">
                                <label for="settingsEntrySelect" class="zr-sr">Settings topic</label>
                                <select id="settingsEntrySelect" class="zr-input" data-el="select">
                                    <% settingsNavGroups.forEach((group) => { %>
                                    <% group.entries.forEach((entry) => { %>
                                    <option value="<%= entry.id %>" <%= entry.id === settingsFirstEntry ? 'selected' : '' %>><%= group.featured ? entry.title : group.label + ' › ' + entry.title %><%= entry.badge ? ' (' + entry.badge + ')' : '' %><%= entry.count ? ' (' + entry.count + ')' : '' %></option>
                                    <% }) %>
                                    <% }) %>
                                </select>
                            </div>
                        </div>
                        </div>
                    </aside>

                    <div class="zr-stack zr-settings__main">
                    <% if (success) { %>
                        <div class="zr-alert zr-alert--ok">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                            <div class="zr-alert__body"><p><%= success %></p></div>
                        </div>
                    <% } %>
                    <% if (settingsError) { %>
                        <div class="zr-alert zr-alert--danger">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                            <div class="zr-alert__body"><p><%= settingsError %></p></div>
                        </div>
                    <% } %>

                    <form id="setupForm" class="zr-stack"
                        data-locked-env-keys="<%= JSON.stringify(typeof lockedEnvKeys !== 'undefined' && Array.isArray(lockedEnvKeys) ? lockedEnvKeys : []) %>"
                        data-restart-keys="<%= JSON.stringify(typeof restartRequiredKeys !== 'undefined' && Array.isArray(restartRequiredKeys) ? restartRequiredKeys : []) %>"
                        data-boot-id="<%= typeof bootId === 'string' ? bootId : '' %>">
                        <%- entryOpen('quick-start') %>
                                <%- include('partials/settings-quick-start', { settingsGroups, ocrKeyStored: ocrKeyConfiguredDefault }) %>
                        <%- entryClose() %>

                        <%- entryOpen('connection') %>
                                <section class="zr-settings-section" id="sec-connection" aria-labelledby="sec-connection-title">
                                    <%- sectionHead('sec-connection', 'Connection', 'Zettelrobbe reads your documents and writes its results through the Paperless-ngx API.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessUrl" class="zr-field__name">
                                            Paperless-ngx address
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="urlHelp">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                            </button>
                                        </label>
                                        <input type="text" id="paperlessUrl" name="paperlessUrl" value="<%= config.PAPERLESS_API_URL %>" class="zr-input" placeholder="http://your-paperless-instance:8000" inputmode="url" required>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessToken" class="zr-field__name">API token</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="paperlessToken" name="paperlessToken" value="" class="zr-input" placeholder="<%= configuredSecrets.PAPERLESS_API_TOKEN ? 'Configured' : 'Enter API token' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="paperlessToken" aria-label="Show the API token">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg>
                                            </button>
                                        </div>
                                        <% if (configuredSecrets.PAPERLESS_API_TOKEN) { %>
                                        <p class="zr-field__hint">Leave it empty to keep the stored token.</p>
                                        <% } %>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label class="zr-field__name">Address used for links</label>
                                        <!-- Same one-row value + button shape as the secret fields. -->
                                        <div class="zr-inputgroup">
                                            <div id="paperlessDetectedUrlValue" class="zr-input zr-input--static zr-grow">Loading…</div>
                                            <button type="button" id="refreshPublicUrlDetection" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>Refresh
                                            </button>
                                        </div>
                                        <p id="paperlessDetectedUrlMeta" class="zr-field__hint">Asking Paperless-ngx for its public address…</p>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessPublicUrl" class="zr-field__name">Public address (optional)</label>
                                        <input type="text" id="paperlessPublicUrl" name="paperlessPublicUrl" value="<%= config.PAPERLESS_PUBLIC_URL || '' %>" class="zr-input" placeholder="https://paperless.example.com" inputmode="url">
                                        <p class="zr-field__hint">Links to a document in Paperless-ngx open at this address. When empty, Zettelrobbe uses the one Paperless-ngx reports, or else the address above.</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('display') %>
                                <section class="zr-settings-section" id="sec-display" aria-labelledby="sec-display-title">
                                    <%- sectionHead('sec-display', 'Dates', 'Applies to every page of Zettelrobbe. Paperless-ngx keeps its own format.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="dateFormat" class="zr-field__name">Date format</label>
                                            <select id="dateFormat" name="dateFormat" class="zr-input">
                                                <option value="DD.MM.YYYY" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? '' : 'selected' %>>DD.MM.YYYY</option>
                                                <option value="YYYY-MM-DD" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD</option>
                                            </select>
                                            <p class="zr-field__hint">How Zettelrobbe shows dates: 15 August 2026 as 15.08.2026 or as 2026-08-15.</p>
                                        </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%
                            // The AI options (labels, help, basic or advanced, which
                            // providers show them, defaults) come from AI_OPTIONS in
                            // services/aiProviderRules.js. The table below only says which
                            // control each key drives, so the existing ids and names stay.
                            const aiOptionList = Array.isArray(typeof aiOptions !== 'undefined' ? aiOptions : null) ? aiOptions : [];
                            const aiProviderIds = (Array.isArray(typeof aiProviders !== 'undefined' ? aiProviders : null) ? aiProviders : []).map((provider) => provider.id);
                            // The selected provider's connection block is shown from the
                            // first paint; settings.js takes over on a switch.
                            const aiSelectedProvider = String(config.AI_PROVIDER || 'openai').trim().toLowerCase();
                            const aiBlockHidden = (id) => (id === aiSelectedProvider ? '' : 'hidden');
                            const aiSwitchOn = (value, fallback) => ['yes', 'true', '1', 'on'].includes(String(value == null || value === '' ? fallback : value).trim().toLowerCase());
                            const aiOptionControls = {
                                RESPONSE_TOKENS: { id: 'responseTokens', type: 'number', attrs: 'min="1" step="1"' },
                                TOKEN_LIMIT: { id: 'tokenLimit', type: 'number', attrs: 'min="1" step="1"' },
                                AI_TEMPERATURE_ANALYSIS: { id: 'aiTemperatureAnalysis', type: 'number', attrs: 'min="0" max="2" step="0.1"' },
                                AI_REASONING_EFFORT: { id: 'aiReasoningEffort', type: 'select', choices: [{ value: '', label: 'Not sent' }, { value: 'low', label: 'Low' }, { value: 'medium', label: 'Medium' }, { value: 'high', label: 'High' }] },
                                ANTHROPIC_EFFORT: { id: 'anthropicEffort', type: 'select', choices: [{ value: '', label: 'Model default' }].concat(anthropicEffortLevels.map((level) => ({ value: level, label: anthropicEffortLabels[level] || level }))) },
                                ANTHROPIC_MAX_TOKENS: { id: 'anthropicMaxTokens', type: 'number', attrs: 'min="1" step="1"' },
                                ANTHROPIC_STRUCTURED_OUTPUT: { id: 'anthropicStructuredOutput', type: 'switch' },
                                ANTHROPIC_PROMPT_CACHING: { id: 'anthropicPromptCaching', type: 'switch' },
                                ANTHROPIC_API_URL: { id: 'anthropicApiUrl', type: 'text', placeholder: 'https://api.anthropic.com', attrs: 'autocomplete="off" spellcheck="false" inputmode="url"' },
                                OLLAMA_THINK: { id: 'ollamaThink', type: 'switch' },
                                OLLAMA_API_KEY: { id: 'ollamaApiKey', type: 'secret', placeholder: 'Optional' },
                                AZURE_API_VERSION: { id: 'azureApiVersion', type: 'text', attrs: 'autocomplete="off" spellcheck="false"' },
                                DUPLICATES_AI_REVIEW: { id: 'duplicatesAiReview', type: 'switch' },
                                DUPLICATES_GUARD_NEW_NAMES: { id: 'duplicatesGuardNewNames', type: 'switch' },
                                DUPLICATES_AI_MODEL: { id: 'duplicatesAiModel', type: 'model', placeholder: 'Same as the analysis model', button: 'fetchTidyUpModelsBtn' },
                                DUPLICATES_AI_REVIEW_BATCH_SIZE: { id: 'duplicatesAiReviewBatchSize', type: 'number', attrs: 'min="1" max="100" step="1"' },
                                DUPLICATES_AI_CANDIDATE_FLOOR: { id: 'duplicatesAiCandidateFloor', type: 'number', attrs: 'min="0.5" max="0.95" step="0.01"' },
                                DUPLICATES_AI_EXCERPTS: { id: 'duplicatesAiExcerpts', type: 'switch' },
                                DUPLICATES_AI_EXCERPT_CHARS: { id: 'duplicatesAiExcerptChars', type: 'number', attrs: 'min="50" max="500" step="1"' },
                                DUPLICATES_AI_EXCERPT_DOCUMENTS: { id: 'duplicatesAiExcerptDocuments', type: 'number', attrs: 'min="1" max="5" step="1"' },
                                DUPLICATES_AI_TOKEN_BUDGET: { id: 'duplicatesAiTokenBudget', type: 'number', attrs: 'min="0" max="10000000" step="1000"' },
                                DUPLICATES_AI_IDLE_STOP_SECONDS: { id: 'duplicatesAiIdleStopSeconds', type: 'number', attrs: 'min="0" max="3600" step="1"' },
                                DUPLICATES_AI_THINKING: { id: 'duplicatesAiThinking', type: 'switch' },
                                DUPLICATES_AI_TEMPLATE_SWITCH: { id: 'duplicatesAiTemplateSwitch', type: 'switch' },
                                DUPLICATES_AI_REQUEST_SECONDS: { id: 'duplicatesAiRequestSeconds', type: 'number', attrs: 'min="5" max="300" step="5"' },
                                DUPLICATES_AI_CONCURRENCY: { id: 'duplicatesAiConcurrency', type: 'number', attrs: 'min="0" max="8" step="1"' },
                                DUPLICATES_AI_VERDICT_MEMORY_DAYS: { id: 'duplicatesAiVerdictMemoryDays', type: 'number', attrs: 'min="0" max="365" step="1"' },
                                DUPLICATES_AI_SWEEP_NAMES: { id: 'duplicatesAiSweepNames', type: 'number', attrs: 'min="50" max="1000" step="50"' },
                                SIMPLIFY_TAGS_PER_REQUEST: { id: 'simplifyTagsPerRequest', type: 'number', attrs: 'min="10" max="200" step="10"' },
                                SIMPLIFY_VOCABULARY_SIZE: { id: 'simplifyVocabularySize', type: 'number', attrs: 'min="5" max="100" step="5"' }
                            };
                            const aiOptionsIn = (section, level) => aiOptionList.filter((option) => (option.section || 'provider') === section && option.level === level && aiOptionControls[option.key]);
                            const aiOptionField = (option) => {
                                const control = aiOptionControls[option.key];
                                const fallback = option.defaultValue == null ? '' : String(option.defaultValue);
                                const current = config[option.key] == null ? '' : String(config[option.key]);
                                const providers = option.providers === null ? aiProviderIds : option.providers;
                                let hint = option.help;
                                if (fallback) hint += ` Default: ${control.type === 'switch' ? (aiSwitchOn(fallback, 'no') ? 'on' : 'off') : fallback}.`;
                                if (control.type === 'secret' && configuredSecrets[option.key]) hint += ' Leave empty to keep the stored value.';
                                let field;
                                if (control.type === 'switch') {
                                    field = include('partials/settings-switch', { id: control.id, label: option.label, checked: aiSwitchOn(current, fallback || 'no'), hint });
                                } else {
                                    let input;
                                    if (control.type === 'select') {
                                        input = `<select id="${control.id}" name="${control.id}" class="zr-input">`
                                            + control.choices.map((choice) => `<option value="${settingsEsc(choice.value)}" ${choice.value === current ? 'selected' : ''}>${settingsEsc(choice.label)}</option>`).join('')
                                            + '</select>';
                                    } else if (control.type === 'model') {
                                        // A model picker like the provider's own model fields: the
                                        // placeholder means "no model of its own", the stored id
                                        // stays listed, Fetch models (settings.js) fills in what the
                                        // configured provider offers, and "Other…" reveals a text
                                        // field for an id the discovery does not list. Azure has no
                                        // discovery, so its button is hidden there.
                                        input = `<div class="zr-inputgroup"><select id="${control.id}" name="${control.id}" class="zr-input" data-model-picker data-stored-value="${settingsEsc(current)}" data-placeholder="${settingsEsc(control.placeholder)}">`
                                            + `<option value="" ${current ? '' : 'selected'}>${settingsEsc(control.placeholder)}</option>`
                                            + (current ? `<option value="${settingsEsc(current)}" selected>${settingsEsc(current)}</option>` : '')
                                            + '<option value="" data-model-other>Other…</option>'
                                            + '</select>'
                                            + `<button type="button" id="${control.button}" class="zr-btn${aiSelectedProvider === 'azure' ? ' hidden' : ''}" data-model-fetch="${control.id}" data-locked-by="${control.id}">`
                                            + '<svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg><span>Fetch models</span></button></div>'
                                            + `<input type="text" id="${control.id}Other" class="zr-input hidden" value="" autocomplete="off" spellcheck="false" placeholder="Model id" aria-label="${settingsEsc(option.label)}: model id" data-model-other-input="${control.id}" data-locked-by="${control.id}">`;
                                    } else if (control.type === 'secret') {
                                        input = `<div class="zr-inputgroup"><input type="password" id="${control.id}" name="${control.id}" value="" class="zr-input" autocomplete="off" placeholder="${configuredSecrets[option.key] ? 'Configured' : settingsEsc(control.placeholder || fallback)}">`
                                            + `<button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="${control.id}" aria-label="Show the API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button></div>`;
                                    } else {
                                        input = `<input type="${control.type}" id="${control.id}" name="${control.id}" ${control.attrs ? control.attrs + ' ' : ''}value="${settingsEsc(current)}" class="zr-input" placeholder="${settingsEsc(control.placeholder || fallback)}">`;
                                    }
                                    field = `<div class="zr-field zr-field--stacked"><label for="${control.id}" class="zr-field__name">${settingsEsc(option.label)}</label>${input}<p class="zr-field__hint">${settingsEsc(hint)}</p></div>`;
                                }
                                const shown = providers.includes(aiSelectedProvider);
                                return `<div class="zr-settings-option${shown ? '' : ' hidden'}" data-ai-option="${settingsEsc(option.key)}" data-level="${settingsEsc(option.level)}" data-providers="${settingsEsc(providers.join(','))}">${field}</div>`;
                            };
                            // One option, one row of its section: pages/settings.css lays a
                            // short control (number, select, switch) beside its label and a
                            // long one under it, so every control ends on the card's edge.
                            const aiOptionBlock = (list) => list.map(aiOptionField).join('');
                            // One closed disclosure per section; settings-advanced opens or
                            // closes all of them together and remembers the choice.
                            const aiAdvanced = (id, summary, list) => list.length ? `${disclosureOpen(`id="${id}" data-advanced data-module="settings-advanced"`, 'Advanced options', summary)}
                                    <div class="zr-settings-section__body zr-col zr-col--loose">${aiOptionBlock(list)}</div>
                                </details>` : '';
                        %>
                        <%- entryOpen('ai-provider') %>
                                <section class="zr-settings-section" id="sec-provider" aria-labelledby="sec-provider-title">
                                    <%- sectionHead('sec-provider', 'Provider', 'Zettelrobbe sends every document it analyses to this service.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="aiProvider" class="zr-field__name">AI provider</label>
                                        <%
                                            // One list: every provider, the known OpenAI-compatible
                                            // services by name, and "Other" last. The value is the
                                            // provider; data-choice tells the entries of custom apart.
                                            const aiChoiceList = Array.isArray(aiProviderPresets) ? aiProviderPresets : [];
                                            const aiChoiceId = typeof aiProviderChoice === 'string' ? aiProviderChoice : '';
                                        %>
                                        <select id="aiProvider" name="aiProvider" class="zr-input">
                                            <% aiChoiceList.forEach((choice) => { %>
                                            <option value="<%= choice.provider %>" data-choice="<%= choice.id %>" <%= choice.id === aiChoiceId ? 'selected' : '' %>><%= choice.label %></option>
                                            <% }) %>
                                        </select>
                                        <p class="zr-field__hint">The service that reads your documents. Each one asks for its own key and model below.</p>
                                    </div>

                                    <div id="openaiSettings" class="zr-col zr-col--loose <%= aiBlockHidden('openai') %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="openaiKey" class="zr-field__name">OpenAI API key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="openaiKey" name="openaiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.OPENAI_API_KEY ? 'Configured' : 'Enter OpenAI API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="openaiKey" aria-label="Show the API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <% if (configuredSecrets.OPENAI_API_KEY) { %><p class="zr-field__hint">Leave empty to keep the stored key.</p><% } %>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="openaiModel" class="zr-field__name">Model</label>
                                            <select id="openaiModel" name="openaiModel" class="zr-input">
                                                <option value="gpt-3.5-turbo-0125" <%= config.OPENAI_MODEL === 'gpt-3.5-turbo-0125' ? 'selected' : '' %>>GPT-3.5 Turbo</option>
                                                <option value="gpt-4o" <%= config.OPENAI_MODEL === 'gpt-4o' ? 'selected' : '' %>>GPT-4o</option>
                                                <option value="o3-mini" <%= config.OPENAI_MODEL === 'o3-mini' ? 'selected' : '' %>>o3-mini</option>
                                                <option value="gpt-4o-mini" <%= config.OPENAI_MODEL === 'gpt-4o-mini' ? 'selected' : '' %>>GPT-4o-mini</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div id="ollamaSettings" class="zr-col zr-col--loose <%= aiBlockHidden('ollama') %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ollamaUrl" class="zr-field__name">Server address</label>
                                            <input type="text" id="ollamaUrl" name="ollamaUrl" value="<%= config.OLLAMA_API_URL %>" class="zr-input" placeholder="http://localhost:11434" inputmode="url">
                                            <p class="zr-field__hint">Ollama listens on port 11434, for example http://192.168.1.10:11434. In Docker, localhost does not reach Ollama on the host.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ollamaModel" class="zr-field__name">Model</label>
                                            <div class="zr-inputgroup">
                                                <select id="ollamaModel" name="ollamaModel" class="zr-input">
                                                    <option value="<%= config.OLLAMA_MODEL %>" selected><%= config.OLLAMA_MODEL %></option>
                                                </select>
                                                <button type="button" id="fetchAiModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Fetch models lists the models installed on the server.</p>
                                        </div>
                                    </div>

                                    <div id="customSettings" class="zr-col zr-col--loose <%= aiBlockHidden('custom') %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customBaseUrl" class="zr-field__name">Server address</label>
                                            <input type="text" id="customBaseUrl" name="customBaseUrl" value="<%= config.CUSTOM_BASE_URL %>" class="zr-input" placeholder="http://localhost:8080/v1" inputmode="url">
                                            <p class="zr-field__hint">The address of the OpenAI-compatible API, usually ending in /v1.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customApiKey" class="zr-field__name">API key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="customApiKey" name="customApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.CUSTOM_API_KEY ? 'Configured' : 'Enter API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="customApiKey" aria-label="Show the API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint"><%= configuredSecrets.CUSTOM_API_KEY ? 'Leave empty to keep the stored key.' : 'Leave it empty if the server needs no key.' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customModel" class="zr-field__name">Model</label>
                                            <div class="zr-inputgroup">
                                                <select id="customModel" name="customModel" class="zr-input">
                                                    <option value="<%= config.CUSTOM_MODEL %>" selected><%= config.CUSTOM_MODEL %></option>
                                                </select>
                                                <button type="button" id="fetchCustomAiModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Fetch models lists the models the server offers.</p>
                                        </div>
                                    </div>

                                    <div id="azureSettings" class="zr-col zr-col--loose <%= aiBlockHidden('azure') %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureEndpoint" class="zr-field__name">Endpoint</label>
                                            <input type="text" id="azureEndpoint" name="azureEndpoint" value="<%= config.AZURE_ENDPOINT %>" class="zr-input" placeholder="https://your-resource.openai.azure.com" inputmode="url">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureApiKey" class="zr-field__name">Azure API key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="azureApiKey" name="azureApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.AZURE_API_KEY ? 'Configured' : 'Enter Azure API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="azureApiKey" aria-label="Show the API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <% if (configuredSecrets.AZURE_API_KEY) { %><p class="zr-field__hint">Leave empty to keep the stored key.</p><% } %>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureDeploymentName" class="zr-field__name">Deployment</label>
                                            <input type="text" id="azureDeploymentName" name="azureDeploymentName" value="<%= config.AZURE_DEPLOYMENT_NAME %>" class="zr-input">
                                            <p class="zr-field__hint">The name you gave the model deployment in Azure.</p>
                                        </div>
                                    </div>

                                    <div id="anthropicSettings" class="zr-col zr-col--loose <%= anthropicSelected ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="anthropicApiKey" class="zr-field__name">Anthropic API key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="anthropicApiKey" name="anthropicApiKey" value="" class="zr-input" autocomplete="off" placeholder="<%= configuredSecrets.ANTHROPIC_API_KEY ? 'Configured' : 'sk-ant-...' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="anthropicApiKey" aria-label="Show the API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <% if (configuredSecrets.ANTHROPIC_API_KEY) { %><p class="zr-field__hint">Leave empty to keep the stored key.</p><% } %>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="anthropicModel" class="zr-field__name">Model</label>
                                            <div class="zr-inputgroup">
                                                <%
                                                    const anthropicCurrentModel = config.ANTHROPIC_MODEL || anthropic.defaultModel || '';
                                                    const anthropicModelIds = anthropicSuggestedModels.map((model) => model.id);
                                                    if (anthropicCurrentModel && !anthropicModelIds.includes(anthropicCurrentModel)) anthropicModelIds.push(anthropicCurrentModel);
                                                %>
                                                <select id="anthropicModel" name="anthropicModel" class="zr-input">
                                                    <% anthropicModelIds.forEach((id) => { %>
                                                    <option value="<%= id %>" <%= id === anthropicCurrentModel ? 'selected' : '' %>><%= id %></option>
                                                    <% }) %>
                                                </select>
                                                <button type="button" id="fetchAnthropicModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Fetch models lists every model the API key can use.</p>
                                        </div>
                                    </div>
                                    <%- aiOptionBlock(aiOptionsIn('provider', 'basic')) %>
                                    </div>
                                </section>
                                <%- aiAdvanced('sec-provider-advanced', 'How much the model reads and writes, how freely it answers, and what individual providers offer. The defaults suit most archives.', aiOptionsIn('provider', 'advanced')) %>
                        <%- entryClose() %>

                        <%- entryOpen('ai-behavior') %>
                                <section class="zr-settings-section" id="sec-ai-function-limits" aria-labelledby="sec-ai-function-limits-title">
                                    <%- sectionHead('sec-ai-function-limits', 'Fields of a document', 'With a switch off, Zettelrobbe leaves that field as it is. The created date is always taken from the analysis.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%# The five switches post their own checkbox (name, "on"), as
                                        they always did; only the row around them changed. %>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="activateTagging" class="zr-field__name">Tags</label>
                                            <p class="zr-field__hint">Adds the tags the model picks to the ones the document already has.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="activateTagging" name="activateTagging" <%= config.ACTIVATE_TAGGING === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="activateCorrespondents" class="zr-field__name">Correspondent</label>
                                            <p class="zr-field__hint">Sets the correspondent the model names. If the model names none, the document keeps its own.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="activateCorrespondents" name="activateCorrespondents" <%= config.ACTIVATE_CORRESPONDENTS === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="activateDocumentType" class="zr-field__name">Document type</label>
                                            <p class="zr-field__hint">Sets the document type the model picks, such as Invoice or Contract.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="activateDocumentType" name="activateDocumentType" <%= config.ACTIVATE_DOCUMENT_TYPE === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="activateTitle" class="zr-field__name">Title</label>
                                            <p class="zr-field__hint">Replaces the title with one the model writes from the content.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="activateTitle" name="activateTitle" <%= config.ACTIVATE_TITLE === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="activateCustomFields" class="zr-field__name">Custom fields</label>
                                            <p class="zr-field__hint">Fills in the fields listed under <a href="#custom-fields" class="zr-link zr-link--underline">Custom fields</a> with values the model reads from the document.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="activateCustomFields" name="activateCustomFields" <%= config.ACTIVATE_CUSTOM_FIELDS === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-settings-section" id="sec-analysis-tags" aria-labelledby="sec-analysis-tags-title">
                                    <%- sectionHead('sec-analysis-tags', 'Tags after the analysis', 'What Zettelrobbe adds to a document or takes off it once its analysis is written.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'aiProcessedTag',
                                        label: 'Tag analysed documents',
                                        checked: config.ADD_AI_PROCESSED_TAG === 'yes',
                                        hint: 'Adds the tag below to every analysed document, even with Tags switched off. Zettelrobbe creates the tag if it does not exist.'
                                    }) %>
                                    <div id="aiTagNameSection" class="<%= config.ADD_AI_PROCESSED_TAG === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="aiTagName" class="zr-field__name">Tag name</label>
                                        <input type="text" id="aiTagName" name="aiTagName" value="<%= config.AI_PROCESSED_TAG_NAME %>" class="zr-input">
                                        <p class="zr-field__hint">Default: ai-processed.</p>
                                    </div>

                                    <%- include('partials/settings-switch', {
                                        id: 'removeInboxTagsAfterProcessing',
                                        label: 'Remove the inbox tags',
                                        hint: 'Takes every Paperless-ngx inbox tag off a document once its analysis is written.',
                                        checked: config.REMOVE_INBOX_TAGS_AFTER_PROCESSING === 'yes'
                                    }) %>

                                    <div class="zr-field zr-field--stacked">
                                        <label for="removeTagInput" class="zr-field__name">Also remove these tags</label>
                                        <%- include('partials/chip-list', {
                                            id: 'removeTagInput', addId: 'removeTagAddButton', listId: 'removeTagsContainer',
                                            valueId: 'removeTags', items: config.REMOVE_TAGS_AFTER_PROCESSING, envKey: 'REMOVE_TAGS_AFTER_PROCESSING',
                                            placeholder: 'Tag name, then Enter'
                                        }) %>
                                        <p class="zr-field__hint">Zettelrobbe takes these tags off a document once its analysis is written, even when the model proposed one of them.</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('prompt') %>
                                <section class="zr-settings-section" id="sec-ai-behavior" aria-labelledby="sec-ai-behavior-title">
                                    <%- sectionHead('sec-ai-behavior', 'What the model is told', 'Your own instructions to the model, and the Paperless-ngx names it may reuse.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="systemPrompt" class="zr-field__name">Your prompt</label>
                                        <textarea id="systemPrompt" name="systemPrompt" rows="8" class="zr-textarea" placeholder="What the model should look for in your documents and how to name things"><%= config.SYSTEM_PROMPT %></textarea>
                                        <button id="systemPromptBtn" type="button" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-bulb"/></svg>
                                            Example
                                        </button>
                                        <p class="zr-field__hint">The model gets it with every document. Zettelrobbe adds its own rules for the answer after it. Example replaces the text with a prompt to start from.</p>
                                    </div>

                                    <%- include('partials/settings-switch', {
                                        id: 'useExistingData',
                                        label: 'Send the existing names',
                                        checked: config.USE_EXISTING_DATA === 'yes',
                                        hint: 'Lists every Paperless-ngx tag, correspondent and document type before your prompt, so the model can reuse them. Not sent while tags or correspondents are limited to existing names.'
                                    }) %>

                                    <%- include('partials/settings-switch', {
                                        id: 'usePromptTags',
                                        label: 'Use prompt tags instead',
                                        checked: config.USE_PROMPT_TAGS === 'yes',
                                        hint: 'Instead of your prompt, the model gets the tags below and picks from them.'
                                    }) %>

                                    <div id="promptTagsSection" class="<%= config.USE_PROMPT_TAGS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="promptTagInput" class="zr-field__name">Prompt tags</label>
                                        <%- include('partials/chip-list', {
                                            id: 'promptTagInput', addId: 'promptTagAddButton', listId: 'promptTagsContainer',
                                            valueId: 'promptTags', items: config.PROMPT_TAGS, envKey: 'PROMPT_TAGS',
                                            placeholder: 'Tag name, then Enter'
                                        }) %>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('restrictions') %>
                                <section class="zr-settings-section" id="sec-restrictions" aria-labelledby="sec-restrictions-title">
                                    <%- sectionHead('sec-restrictions', 'Tags, correspondents and document types', 'With a switch on, the model may only use a name that already exists in Paperless-ngx. Zettelrobbe leaves out a new name the model proposes instead of creating it.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="restrictToExistingTags" class="zr-field__name">Only existing tags</label>
                                            <p class="zr-field__hint">A tag Paperless-ngx does not have is left out. %RESTRICTED_TAGS% in your prompt gives the model the list.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="restrictToExistingTags" name="restrictToExistingTags" <%= config.RESTRICT_TO_EXISTING_TAGS === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="restrictToExistingCorrespondents" class="zr-field__name">Only existing correspondents</label>
                                            <p class="zr-field__hint">A correspondent Paperless-ngx does not have is left out, and the document keeps its own. %RESTRICTED_CORRESPONDENTS% in your prompt gives the model the list.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="restrictToExistingCorrespondents" name="restrictToExistingCorrespondents" <%= config.RESTRICT_TO_EXISTING_CORRESPONDENTS === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="restrictToExistingDocumentTypes" class="zr-field__name">Only existing document types</label>
                                            <p class="zr-field__hint">A document type Paperless-ngx does not have is left out. %RESTRICTED_DOCUMENT_TYPES% in your prompt gives the model the list.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="restrictToExistingDocumentTypes" name="restrictToExistingDocumentTypes" <%= config.RESTRICT_TO_EXISTING_DOCUMENT_TYPES === 'yes' ? 'checked' : '' %>>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('custom-fields') %>
                                <section class="zr-settings-section" id="sec-custom-fields" aria-labelledby="sec-custom-fields-title">
                                    <%- sectionHead('sec-custom-fields', 'Fields the model fills in', 'The model fills in a value for each field listed here. Saving the settings creates a field that Paperless-ngx does not have yet.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div id="customFieldsList" class="zr-field zr-field--stacked">
                                        <% let _parsedCustomFields = []; try { const _cf = JSON.parse(config.CUSTOM_FIELDS || '{}'); if (Array.isArray(_cf.custom_fields)) _parsedCustomFields = _cf.custom_fields; } catch(e) {} %>
                                        <% if (_parsedCustomFields.length > 0) { %>
                                            <% _parsedCustomFields.forEach((field) => { %>
                                                <div class="custom-field-item zr-row">
                                                    <div class="zr-faint" style="cursor: move"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-grip"/></svg></div>
                                                    <div class="zr-grow">
                                                        <p class="zr-strong" data-field-name><%= field.value %></p>
                                                        <p class="zr-sm zr-faint" data-field-type>Type: <%= field.data_type %> <%= field.data_type === 'monetary' && field.currency ? `(${field.currency})` : '' %></p>
                                                    </div>
                                                    <button type="button" onclick="removeCustomField(this)" class="zr-btn zr-btn--ghost zr-btn--icon zr-btn--danger"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg></button>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
    
                                    <%# Name, type and Add only build the list; the save sends the
                                        list (#customFieldsJson), not these. %>
                                    <div class="zr-row zr-row--wrap customfield-add" data-not-a-setting>
                                        <div class="zr-grow"><input type="text" id="newFieldName" class="zr-input" placeholder="Field name"></div>
                                        <div>
                                            <select id="newFieldType" onchange="toggleCurrencySelect()" class="zr-input">
                                                <option value="string">Text (up to 128 characters)</option>
                                                <option value="longtext">Long text</option>
                                                <option value="float">Number</option>
                                                <option value="integer">Integer</option>
                                                <option value="monetary">Currency</option>
                                                <option value="date">Date</option>
                                                <option value="boolean">Boolean</option>
                                            </select>
                                        </div>
                                        <div>
                                            <select id="currencyCode" class="zr-select hidden">
                                                <option value="EUR">EUR</option>
                                                <option value="USD">USD</option>
                                                <option value="GBP">GBP</option>
                                                <option value="JPY">JPY</option>
                                                <option value="CHF">CHF</option>
                                            </select>
                                        </div>
                                        <div><button type="button" onclick="addCustomField()" class="zr-btn zr-btn--primary zr-btn--block">Add</button></div>
                                    </div>
                                    <input type="hidden" id="customFieldsJson" name="customFields" value='<%= config.CUSTOM_FIELDS || "{\"custom_fields\":[]}" %>' data-setting-label="Custom fields">
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('external-data') %>
                                <section class="zr-settings-section" id="sec-external-api" aria-labelledby="sec-external-api-title">
                                    <%- sectionHead('sec-external-api', 'External API', 'Data from another service that the model reads along with each document.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="externalApiEnabled" class="zr-field__name">Add data from an external API</label>
                                            <p class="zr-field__hint">Zettelrobbe calls the address once per scan and adds up to about 500 tokens of the answer to your prompt for each document the scan analyses. Webhooks and rescans make one call per batch.</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="externalApiEnabled" name="externalApiEnabled" <%= config.EXTERNAL_API_ENABLED === 'yes' ? 'checked' : '' %>>
                                    </div>
    
                                    <div id="externalApiSettings" class="zr-col zr-col--loose <%= config.EXTERNAL_API_ENABLED === 'yes' ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiUrl" class="zr-field__name">Address</label>
                                            <input type="text" id="externalApiUrl" name="externalApiUrl" value="<%= config.EXTERNAL_API_URL || '' %>" class="zr-input" inputmode="url">
                                        </div>
                                        <%- include('partials/settings-switch', {
                                            id: 'externalApiAllowPrivateIps',
                                            label: 'Allow a local network address',
                                            checked: config.EXTERNAL_API_ALLOW_PRIVATE_IPS === 'yes',
                                            hint: 'Lets the address above be a private one, such as 192.168.1.20. localhost stays blocked. Zettelrobbe checks every redirect the same way.'
                                        }) %>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiMethod" class="zr-field__name">HTTP method</label>
                                            <select id="externalApiMethod" name="externalApiMethod" class="zr-input">
                                                <option value="GET" <%= config.EXTERNAL_API_METHOD === 'GET' ? 'selected' : '' %>>GET</option>
                                                <option value="POST" <%= config.EXTERNAL_API_METHOD === 'POST' ? 'selected' : '' %>>POST</option>
                                                <option value="PUT" <%= config.EXTERNAL_API_METHOD === 'PUT' ? 'selected' : '' %>>PUT</option>
                                            </select>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiHeaders" class="zr-field__name">Headers (JSON)</label>
                                            <textarea id="externalApiHeaders" name="externalApiHeaders" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_HEADERS || '' %></textarea>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiBody" class="zr-field__name">Request body (JSON)</label>
                                            <textarea id="externalApiBody" name="externalApiBody" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_BODY || '' %></textarea>
                                            <p class="zr-field__hint">Sent only with POST and PUT.</p>
                                        </div>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-settings-section<%= config.EXTERNAL_API_ENABLED === 'yes' ? '' : ' hidden' %>" id="sec-external-api-answer" aria-labelledby="sec-external-api-answer-title" data-shown-by="externalApiEnabled">
                                    <%- sectionHead('sec-external-api-answer', 'The answer', 'How long Zettelrobbe waits for the answer, and which part of it the model gets.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiTimeout" class="zr-field__name">Timeout (milliseconds)</label>
                                        <input type="number" id="externalApiTimeout" name="externalApiTimeout" value="<%= config.EXTERNAL_API_TIMEOUT || '5000' %>" class="zr-input">
                                        <p class="zr-field__hint">If the address takes longer than this or answers with an error, the analysis runs without its data.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiTransform" class="zr-field__name">Transform path</label>
                                        <input type="text" id="externalApiTransform" name="externalApiTransform" value="<%= config.EXTERNAL_API_TRANSFORM || '' %>" class="zr-input" spellcheck="false" autocomplete="off">
                                        <p class="zr-field__hint">Picks the part of the answer the model gets, such as data.items[0].name: names separated by dots, [0] for the first entry of a list. If the path matches nothing, the model gets the whole answer.</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('ocr') %>
                                <section class="zr-settings-section" id="sec-ocr-fallback" aria-labelledby="sec-ocr-fallback-title">
                                    <%- sectionHead('sec-ocr-fallback', 'Reading with OCR', 'OCR reads the text of a document again when Paperless-ngx recognised too little of it or the analysis failed.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'mistralOcrEnabled',
                                        label: 'Use OCR',
                                        checked: config.MISTRAL_OCR_ENABLED === 'yes',
                                        hint: 'Reads a document again when its text from Paperless-ngx is too short or the analysis fails.'
                                    }) %>
                                    <div id="ocrFieldsContainer" class="zr-field zr-field--stacked <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'hidden' %>">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ocrProvider" class="zr-field__name">OCR provider</label>
                                        <select id="ocrProvider" name="ocrProvider" class="zr-input">
                                            <option value="mistral" <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'selected' : '' %>>Mistral OCR API</option>
                                            <option value="custom" <%= ((config.OCR_PROVIDER || 'mistral') === 'custom' || (config.OCR_PROVIDER || 'mistral') === 'ollama') ? 'selected' : '' %>>Local server (Ollama, LM Studio)</option>
                                            <option value="anthropic" <%= ocrStoredForAnthropic ? 'selected' : '' %>>Claude (Anthropic)</option>
                                        </select>
                                    </div>
                                    <div id="ocrApiUrlContainer" class="zr-field zr-field--stacked">
                                        <label for="ocrApiUrl" class="zr-field__name">Server address (optional)</label>
                                        <input type="text" id="ocrApiUrl" name="ocrApiUrl" value="<%= config.OCR_API_URL || '' %>" class="zr-input" placeholder="Empty uses the provider's default" data-placeholder-default="Empty uses the provider's default" data-placeholder-anthropic="Optional proxy address" inputmode="url">
                                        <p id="ocrApiUrlAnthropicHint" class="zr-field__hint <%= ocrStoredForAnthropic ? '' : 'hidden' %>">Only for a proxy. Empty uses the API address set for Claude under AI provider, else api.anthropic.com.</p>
                                    </div>
                                    <div id="ocrApiKeyContainer" class="zr-field zr-field--stacked">
                                        <label for="ocrApiKey" class="zr-field__name">OCR API key</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="ocrApiKey" name="ocrApiKey" value="" class="zr-input" placeholder="<%= ocrStoredForAnthropic ? (ocrKeyConfiguredAnthropic ? 'Configured' : 'Optional') : (ocrKeyConfiguredDefault ? 'Configured' : 'Required for Mistral') %>" data-placeholder-default="<%= ocrKeyConfiguredDefault ? 'Configured' : 'Required for Mistral' %>" data-placeholder-anthropic="<%= ocrKeyConfiguredAnthropic ? 'Configured' : 'Optional' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="ocrApiKey" aria-label="Show the OCR API key"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p id="ocrApiKeyHint" class="zr-field__hint <%= ocrStoredForAnthropic ? 'hidden' : '' %>">Needed for Mistral, optional for a local server.<%= ocrKeyConfiguredDefault ? ' Leave it empty to keep the stored key.' : '' %></p>
                                        <p id="ocrApiKeyAnthropicHint" class="zr-field__hint <%= ocrStoredForAnthropic ? '' : 'hidden' %>"><%= ocrKeyConfiguredAnthropic ? 'Leave it empty to keep the stored key.' : 'Empty uses the Claude API key set under AI provider.' %></p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="mistralOcrModel" class="zr-field__name">OCR model</label>
                                        <div class="zr-inputgroup">
                                            <select id="mistralOcrModel" name="mistralOcrModel" class="zr-input">
                                                <option value="<%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %>" selected><%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %></option>
                                            </select>
                                            <button type="button" id="fetchOcrModelsBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                <span>Fetch models</span>
                                            </button>
                                        </div>
                                        <p id="ocrModelVisionHint" class="zr-field__hint <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'hidden' : '' %>">Models that read images come first, judged by their name. Others may work too.</p>
                                    </div>
                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="testOcrBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                            <span>Test OCR connection</span>
                                        </button>
                                        <span id="ocrTestState" class="zr-badge">Not tested</span>
                                    </div>
                                    </div>
                                    </div>
                                </section>

                                    <%
                                        // OCR before the first analysis (OCR_BEFORE_AI). An unknown stored
                                        // value reads as off, as config/config.js reads it.
                                        const ocrBeforeAiStored = String(config.OCR_BEFORE_AI || 'off').trim().toLowerCase();
                                        const ocrBeforeAiMode = ['off', 'tagged', 'all'].includes(ocrBeforeAiStored) ? ocrBeforeAiStored : 'off';
                                        const ocrQueueRunsItself = (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes';
                                        const ocrRunRightAway = (config.OCR_RUN_RIGHT_AWAY || 'no') === 'yes';
                                        const ocrQueueIsRead = ocrQueueRunsItself || ocrRunRightAway;
                                    %>
                                <section class="zr-settings-section" id="sec-ocr-when" aria-labelledby="sec-ocr-when-title">
                                    <%- sectionHead('sec-ocr-when', 'When OCR runs', 'Which documents go to the OCR queue, and when Zettelrobbe reads the queue.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div id="ocrBeforeAiContainer" class="zr-col zr-col--loose <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'hidden' %>" data-shown-by="mistralOcrEnabled">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ocrBeforeAi" class="zr-field__name">OCR before the first analysis</label>
                                            <select id="ocrBeforeAi" name="ocrBeforeAi" class="zr-input">
                                                <option value="off" <%= ocrBeforeAiMode === 'off' ? 'selected' : '' %>>Off: OCR only when needed</option>
                                                <option value="tagged" <%= ocrBeforeAiMode === 'tagged' ? 'selected' : '' %>>Documents with a tag</option>
                                                <option value="all" <%= ocrBeforeAiMode === 'all' ? 'selected' : '' %>>Every document not analysed yet</option>
                                            </select>
                                            <p id="ocrBeforeAiHintOff" class="zr-field__hint <%= ocrBeforeAiMode === 'off' ? '' : 'hidden' %>">Documents are analysed with the text Paperless-ngx recognised. OCR only steps in when that text is too short or the analysis fails.</p>
                                            <p id="ocrBeforeAiHintTagged" class="zr-field__hint <%= ocrBeforeAiMode === 'tagged' ? '' : 'hidden' %>">Documents not analysed yet that carry the tag below go to the OCR queue first and are analysed once OCR has read them. All other documents are analysed right away.</p>
                                            <p id="ocrBeforeAiHintAll" class="zr-field__hint <%= ocrBeforeAiMode === 'all' ? '' : 'hidden' %>">Every document Zettelrobbe has not analysed yet goes to the OCR queue first and is analysed once OCR has read it. A local model costs only time. A paid OCR service such as Mistral or Claude bills one OCR run per document, which adds up quickly, especially on the first scan of an existing archive.</p>
                                        </div>
                                        <div id="ocrBeforeAiTagContainer" class="zr-field zr-field--stacked <%= ocrBeforeAiMode === 'tagged' ? '' : 'hidden' %>">
                                            <label for="ocrBeforeAiTag" class="zr-field__name">OCR tag</label>
                                            <input type="text" id="ocrBeforeAiTag" name="ocrBeforeAiTag" value="<%= config.OCR_BEFORE_AI_TAG || 'needs-ocr' %>" class="zr-input" placeholder="needs-ocr" autocomplete="off" spellcheck="false">
                                            <p class="zr-field__hint">The Paperless-ngx tag that sends a document to OCR first. Upper and lower case do not matter. While no tag has this name, no document is sent. To take the tag off afterwards, add it to "Also remove these tags" under What the AI fills in.</p>
                                        </div>
                                        <div id="ocrBeforeAiQueueNote" class="zr-alert <%= ocrQueueIsRead ? 'zr-alert--info' : 'zr-alert--warn' %> <%= ocrBeforeAiMode === 'off' ? 'hidden' : '' %>">
                                            <svg class="zr-icon" aria-hidden="true"><use id="ocrBeforeAiQueueIcon" href="/icons.svg#<%= ocrQueueIsRead ? 'i-info' : 'i-alert' %>"/></svg>
                                            <div class="zr-alert__body zr-col">
                                                <p id="ocrBeforeAiQueueManual" class="zr-sm <%= ocrQueueIsRead ? 'hidden' : '' %>">These documents wait in the OCR queue until someone presses "Process All Pending" on the OCR page. Switch on "Read queued documents right away" or "Run the OCR queue on its own" below to have them read automatically.</p>
                                                <p id="ocrBeforeAiQueueAuto" class="zr-sm <%= ocrQueueRunsItself && !ocrRunRightAway ? '' : 'hidden' %>">These documents wait in the OCR queue until its next automatic run.</p>
                                                <p id="ocrBeforeAiQueueRightAway" class="zr-sm <%= ocrRunRightAway ? '' : 'hidden' %>">OCR reads these documents as soon as the scan or webhook that queued them has finished.</p>
                                                <p class="zr-sm">Each document goes through OCR first at most once. Documents that had OCR before, and rescans you start by hand, are analysed directly.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="minContentLength" class="zr-field__name">Minimum text length</label>
                                        <input type="number" id="minContentLength" name="minContentLength" value="<%= config.MIN_CONTENT_LENGTH || 10 %>" class="zr-input">
                                        <p class="zr-field__hint">In characters. A document with less text goes to the OCR queue, or to the failed list while OCR is off.</p>
                                    </div>
                                    <div id="ocrAutoProcessContainer" class="zr-col zr-col--loose <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'hidden' %>" data-shown-by="mistralOcrEnabled">
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrRunRightAway',
                                            label: 'Read queued documents right away',
                                            checked: ocrRunRightAway,
                                            hint: 'OCR reads a document as soon as the scan, webhook or rescan that queued it has finished. The switch does nothing while OCR is off.'
                                        }) %>
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrAutoProcessEnabled',
                                            label: 'Run the OCR queue on its own',
                                            checked: (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes',
                                            hint: 'When off, the queue waits until someone presses "Process All Pending" on the OCR page.'
                                        }) %>
                                        <div id="ocrAutoProcessOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes' ? '' : 'hidden' %>">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrAutoProcessInterval" class="zr-field__name">Queue schedule (cron)</label>
                                                <input type="text" id="ocrAutoProcessInterval" name="ocrAutoProcessInterval" value="<%= config.OCR_AUTO_PROCESS_INTERVAL || '*/15 * * * *' %>" class="zr-input" placeholder="*/15 * * * *">
                                                <p class="zr-field__hint">Every 15 minutes by default. A run is skipped while a scan is going on.</p>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrAutoProcessBatchSize" class="zr-field__name">Documents per run</label>
                                                <input type="number" id="ocrAutoProcessBatchSize" name="ocrAutoProcessBatchSize" min="1" max="100" step="1" value="<%= config.OCR_AUTO_PROCESS_BATCH_SIZE || 10 %>" class="zr-input">
                                                <p class="zr-field__hint">From 1 to 100. The rest wait for the next run.</p>
                                            </div>
                                        </div>
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrAutoAnalyze',
                                            label: 'Analyse right after OCR',
                                            checked: (config.OCR_AUTO_ANALYZE || 'yes') === 'yes',
                                            hint: 'Keep it on. When off, the next scan analyses the document, but only if Paperless-ngx accepted the OCR text.'
                                        }) %>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-settings-section<%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : ' hidden' %>" id="sec-ocr-reading" aria-labelledby="sec-ocr-reading-title" data-shown-by="mistralOcrEnabled">
                                    <%- sectionHead('sec-ocr-reading', 'How OCR reads a document', 'What the model is told, which pages of a PDF it reads, how long it may take, and how a locked PDF is opened.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div id="ocrPromptContainer" class="zr-field zr-field--stacked <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'hidden' : '' %>">
                                        <label for="ocrPrompt" class="zr-field__name">OCR prompt</label>
                                        <textarea id="ocrPrompt" name="ocrPrompt" rows="8" class="zr-textarea" spellcheck="false" data-default-anthropic="<%= ocrPromptDefaults.anthropic %>" data-default-local="<%= ocrPromptDefaults.local %>"><%= config.OCR_PROMPT || (ocrStoredForAnthropic ? ocrPromptDefaults.anthropic : ocrPromptDefaults.local) %></textarea>
                                        <button id="ocrPromptResetBtn" type="button" class="zr-btn" data-locked-by="ocrPrompt">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            Reset to default
                                        </button>
                                        <p class="zr-field__hint">Sent to the model with every document or page. Mistral OCR takes no prompt. Claude answers [no text] for a document without text.</p>
                                    </div>
                                    <div id="ocrPdfRenderContainer" class="zr-col zr-col--loose">
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrPdfRenderEnabled',
                                            label: 'Read every page of a PDF',
                                            checked: (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes',
                                            hint: 'A local model reads each page with poppler, one request per page. When off, or without poppler, it reads only the thumbnail of the first page.'
                                        }) %>
                                        <div id="ocrPdfRenderOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes' ? '' : 'hidden' %>">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrPdfRenderMaxPages" class="zr-field__name">Pages read per PDF</label>
                                                <input type="number" id="ocrPdfRenderMaxPages" name="ocrPdfRenderMaxPages" min="1" max="50" step="1" value="<%= config.OCR_PDF_RENDER_MAX_PAGES || 10 %>" class="zr-input">
                                                <p class="zr-field__hint">Each page is one request to the model. Pages after this number are not read.</p>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrPdfRenderDpi" class="zr-field__name">Page resolution (DPI)</label>
                                                <input type="number" id="ocrPdfRenderDpi" name="ocrPdfRenderDpi" min="72" max="300" step="1" value="<%= config.OCR_PDF_RENDER_DPI || 150 %>" class="zr-input">
                                                <p class="zr-field__hint">From 72 to 300. Higher values help with small print and make each image larger.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ocrValidationTimeout" class="zr-field__name">OCR timeout</label>
                                        <input type="number" id="ocrValidationTimeout" name="ocrValidationTimeout" min="1" max="7200" step="1" value="<%= Math.round(Number(config.SETUP_OCR_VALIDATION_TIMEOUT_MS || config.SETUP_VALIDATION_TIMEOUT_MS) / 1000) || '' %>" class="zr-input">
                                        <p class="zr-field__hint">In seconds. How long Zettelrobbe waits for one OCR request. Test OCR connection and Fetch models wait as long.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="pdfPasswords" class="zr-field__name">PDF passwords</label>
                                        <textarea id="pdfPasswords" name="pdfPasswords" rows="3" class="zr-textarea" autocomplete="off" spellcheck="false" placeholder="<%= pdfPasswordCount ? `${pdfPasswordCount} stored` : 'One password per line' %>"></textarea>
                                        <p class="zr-field__hint">One password per line, tried on PDFs that need one. Paperless-ngx 3.0+ removes the matching password and keeps the unlocked file as a new version.<% if (pdfPasswordCount) { %><span id="pdfPasswordsAddHint"> New ones are added to the stored list.</span><% } %></p>
                                        <% if (pdfPasswordCount) { %>
                                        <button id="pdfPasswordsDeleteBtn" type="button" class="zr-btn zr-btn--danger" data-locked-by="pdfPasswords" data-count="<%= pdfPasswordCount %>">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                            Delete all passwords
                                        </button>
                                        <% } %>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('schedule') %>
                                <section class="zr-settings-section" id="sec-processing" aria-labelledby="sec-processing-title">
                                    <%- sectionHead('sec-processing', 'Schedule', 'When Zettelrobbe looks for new documents by itself.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="scanInterval" class="zr-field__name">Scan schedule (cron)</label>
                                        <input type="text" id="scanInterval" name="scanInterval" value="<%= config.SCAN_INTERVAL %>" class="zr-input" required>
                                        <p class="zr-field__hint">When Zettelrobbe looks for documents it has not analysed yet. */30 * * * * means every 30 minutes.</p>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <div class="zr-switchrow">
                                            <div class="zr-grow">
                                                <label for="disableAutomaticProcessing" class="zr-field__name">Stop automatic scans</label>
                                                <p class="zr-field__hint">Zettelrobbe no longer scans on its schedule, and the OCR queue stops running on its own. Scan now on the dashboard and the webhook still work.</p>
                                            </div>
                                            <input type="checkbox" class="zr-toggle" id="disableAutomaticProcessing" <%= config.DISABLE_AUTOMATIC_PROCESSING === 'yes' ? 'checked' : '' %>>
                                        </div>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-settings-section" id="sec-tag-filters" aria-labelledby="sec-tag-filters-title">
                                    <%- sectionHead('sec-tag-filters', 'Tag filters', 'Which documents a scan takes, by their tags.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'showTags',
                                        label: 'Only documents with certain tags',
                                        checked: config.PROCESS_PREDEFINED_DOCUMENTS === 'yes',
                                        hint: 'A scan only picks documents that carry at least one of the tags below.'
                                    }) %>
    
                                    <div id="tagsInputSection" class="<%= config.PROCESS_PREDEFINED_DOCUMENTS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="tagInput" class="zr-field__name">Tags</label>
                                        <%- include('partials/chip-list', {
                                            id: 'tagInput', addId: 'tagAddButton', listId: 'tagsContainer',
                                            valueId: 'tags', items: config.TAGS, envKey: 'TAGS',
                                            placeholder: 'Tag name, then Enter'
                                        }) %>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ignoreTagInput" class="zr-field__name">Leave out documents with these tags</label>
                                        <%- include('partials/chip-list', {
                                            id: 'ignoreTagInput', addId: 'ignoreTagAddButton', listId: 'ignoreTagsContainer',
                                            valueId: 'ignoreTags', items: config.IGNORE_TAGS, envKey: 'IGNORE_TAGS',
                                            placeholder: 'Tag name, then Enter'
                                        }) %>
                                        <p class="zr-field__hint">A scan passes over every document that carries one of these tags.</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('skip-rules') %>
                                <section class="zr-settings-section" id="sec-skip-rules" aria-labelledby="sec-skip-rules-title">
                                    <%- sectionHead('sec-skip-rules', 'Documents that skip OCR and the model', 'A matching document goes to the <a href="/ignored" class="zr-link zr-link--underline">ignored list</a>. Take it off that list to process it anyway.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="maxPageCount" class="zr-field__name">Page limit</label>
                                        <input type="number" id="maxPageCount" name="maxPageCount" min="0" step="1" value="<%= config.MAX_PAGE_COUNT || 0 %>" class="zr-input">
                                        <p class="zr-field__hint">A document with more pages, as Paperless-ngx counts them, is skipped. 0 means no limit.</p>
                                    </div>

                                    <div class="zr-field zr-field--stacked">
                                        <label for="ignoreTitlePatternInput" class="zr-field__name">Skip titles containing</label>
                                        <%- include('partials/chip-list', {
                                            id: 'ignoreTitlePatternInput', addId: 'ignoreTitlePatternAddButton', listId: 'ignoreTitlePatternsContainer',
                                            valueId: 'ignoreTitlePatterns', items: config.IGNORE_TITLE_PATTERNS, envKey: 'IGNORE_TITLE_PATTERNS',
                                            placeholder: 'Part of a title or file name, then Enter'
                                        }) %>
                                        <p class="zr-field__hint">Matched anywhere in the title or the original file name, upper or lower case alike. A comma ends a pattern, so a pattern cannot contain one.</p>
                                    </div>

                                    <%- include('partials/settings-switch', {
                                        id: 'ignoreRepeatedContent',
                                        label: 'Skip copies of ignored documents',
                                        checked: String(config.IGNORE_REPEATED_CONTENT || 'yes').toLowerCase() !== 'no',
                                        hint: 'Also skips documents whose text matches one on the ignored list, even as a newly generated PDF.'
                                    }) %>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('runtime') %>
                                <section class="zr-settings-section" id="sec-runtime-controls" aria-labelledby="sec-runtime-controls-title">
                                    <%- sectionHead('sec-runtime-controls', 'Network, limits and logging', 'Saving a change here restarts Zettelrobbe.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="paperlessAiPort" class="zr-field__name">Port</label>
                                            <input type="number" id="paperlessAiPort" name="paperlessAiPort" value="<%= config.PAPERLESS_AI_PORT || 3000 %>" class="zr-input">
                                            <p class="zr-field__hint">The port Zettelrobbe listens on. In Docker, the port mapping has to match.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="trustProxy" class="zr-field__name">Trust proxy</label>
                                            <input type="text" id="trustProxy" name="trustProxy" value="<%= config.TRUST_PROXY %>" class="zr-input" placeholder="false | true | 1 | loopback">
                                            <p class="zr-field__hint">Set it behind a reverse proxy so Zettelrobbe sees each client's address.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="cookieSecureMode" class="zr-field__name">Secure cookies</label>
                                            <select id="cookieSecureMode" name="cookieSecureMode" class="zr-input">
                                                <option value="auto" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'auto' ? 'selected' : '' %>>auto</option>
                                                <option value="always" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'always' ? 'selected' : '' %>>always</option>
                                                <option value="never" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'never' ? 'selected' : '' %>>never</option>
                                            </select>
                                            <p class="zr-field__hint">With auto, cookies are secure over HTTPS. If signing in fails over plain HTTP, choose never.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="globalRateLimitWindowMs" class="zr-field__name">Rate limit window (milliseconds)</label>
                                            <input type="number" id="globalRateLimitWindowMs" name="globalRateLimitWindowMs" value="<%= config.GLOBAL_RATE_LIMIT_WINDOW_MS || 900000 %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="globalRateLimitMax" class="zr-field__name">Requests per window</label>
                                            <input type="number" id="globalRateLimitMax" name="globalRateLimitMax" value="<%= config.GLOBAL_RATE_LIMIT_MAX || 1000 %>" class="zr-input">
                                            <p class="zr-field__hint">API requests per API key, user or IP address. More are refused until the window ends.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="logLevel" class="zr-field__name">Log level</label>
                                            <select id="logLevel" name="logLevel" class="zr-input">
                                                <option value="error" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'error' ? 'selected' : '' %>>error</option>
                                                <option value="warn" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'warn' ? 'selected' : '' %>>warn</option>
                                                <option value="info" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'info' ? 'selected' : '' %>>info (default)</option>
                                                <option value="debug" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'debug' ? 'selected' : '' %>>debug</option>
                                            </select>
                                        </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('tidy-up') %>
                                <section class="zr-settings-section" id="sec-tidy-up" aria-labelledby="sec-tidy-up-title">
                                    <%- sectionHead('sec-tidy-up', 'The model in Tidy up', 'Finding, merging and splitting names work without the model. The model only answers when you start a run on the Tidy up page. Reusing names that exist in another spelling also applies to every analysis.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%- aiOptionBlock(aiOptionsIn('tidy-up', 'basic')) %>
                                    </div>
                                </section>
                                <%- aiAdvanced('sec-tidy-up-advanced', 'What a run may spend, what the model reads and how large its requests are.', aiOptionsIn('tidy-up', 'advanced')) %>
                        <%- entryClose() %>

                        <%- entryOpen('account') %>
                                <!-- One id only: a second id attribute is dropped by the
                                     parser, and getElementById('mfaSettingsSection')
                                     returning null silently disabled the whole MFA
                                     state machine. -->
                                <section class="zr-settings-section" id="mfaSettingsSection" aria-labelledby="mfaSettingsSection-title" data-mfa-available="<%= mfaSettings && mfaSettings.available ? 'yes' : 'no' %>" data-mfa-enabled="<%= mfaSettings && mfaSettings.enabled ? 'yes' : 'no' %>" data-mfa-username="<%= mfaSettings && mfaSettings.username ? mfaSettings.username : '' %>">
                                    <%- sectionHead('mfaSettingsSection', 'Two-factor sign-in (MFA)', 'Applies to the account you are signed in with.') %>
                                    <%# Nothing here is a setting the save sends: MFA has its own requests. %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose" data-not-a-setting>
    
                                    <% if (!(mfaSettings && mfaSettings.available)) { %>
                                        <div class="zr-alert zr-alert--warn">
                                            MFA can only be set up in a signed-in session, not with an API key.
                                        </div>
                                    <% } else { %>
                                        <div class="zr-col zr-col--loose">
                                            <div class="zr-row zr-row--wrap zr-row--between">
                                                <div>
                                                    <p class="zr-field__name">User: <span id="mfaSettingsUser"><%= mfaSettings.username %></span></p>
                                                    <p class="zr-field__hint">With MFA, signing in also asks for a code from an authenticator app.</p>
                                                </div>
                                                <span id="mfaStatusBadge" class="zr-badge <%= mfaSettings.enabled ? 'zr-badge--ok' : '' %>">
                                                    <%= mfaSettings.enabled ? 'Enabled' : 'Disabled' %>
                                                </span>
                                            </div>
    
                                            <div class="zr-field zr-field--stacked">
                                                <label for="mfaCurrentPassword" class="zr-field__name">Current password</label>
                                                <input type="password" id="mfaCurrentPassword" class="zr-input" placeholder="Enter current password">
                                                <p class="zr-field__hint">Needed to switch MFA on or off.</p>
                                            </div>
    
                                            <div class="zr-row zr-row--wrap">
                                                <button type="button" id="mfaEnableBtn" class="zr-btn zr-btn--primary">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                                                    <span>Enable MFA</span>
                                                </button>
                                                <button type="button" id="mfaDisableBtn" class="zr-btn zr-btn--danger">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg>
                                                    <span>Disable MFA</span>
                                                </button>
                                            </div>
    
                                            <div id="mfaProvisioningBox" class="zr-col hidden">
                                                <div class="zr-row">
                                                    <img id="mfaQrImage" class="hidden no-invert" alt="QR code for your authenticator app" />
                                                </div>
                                                <div class="zr-col zr-col--tight">
                                                    <label for="mfaSecretKey" class="zr-field__name">Secret key</label>
                                                    <input type="text" id="mfaSecretKey" class="zr-input" readonly>
                                                </div>
                                                <div class="zr-col zr-col--tight">
                                                    <label for="mfaOtpAuthUri" class="zr-field__name">OTP URI</label>
                                                    <textarea id="mfaOtpAuthUri" rows="3" class="zr-textarea" readonly></textarea>
                                                </div>
                                                <div class="zr-inputgroup">
                                                    <button type="button" id="mfaCopySecretBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                        <span>Copy secret</span>
                                                    </button>
                                                    <button type="button" id="mfaDownloadQrBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-download"/></svg>
                                                        <span>Download QR code</span>
                                                    </button>
                                                </div>
                                                <p class="zr-field__hint">Add the key or the URI to your authenticator app, then enter its code below.</p>
                                            </div>
    
                                            <div class="zr-field zr-field--stacked" id="mfaTokenField">
                                                <label for="mfaToken" class="zr-field__name">Code from the app</label>
                                                <div class="zr-inputgroup">
                                                    <input type="text" id="mfaToken" inputmode="numeric" autocomplete="one-time-code" class="zr-input" placeholder="6-digit code">
                                                    <button type="button" id="mfaVerifyBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                                        <span id="mfaVerifyBtnLabel">Check and switch on</span>
                                                    </button>
                                                </div>
                                                <p id="mfaTokenHint" class="hidden"></p>
                                            </div>
    
                                            <div id="mfaResultMessage" class="hidden"></div>
                                        </div>
                                    <% } %>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('sso') %>
                                <div data-module="settings-sso">
                                <section class="zr-settings-section" id="sec-sso-provider" aria-labelledby="sec-sso-provider-title">
                                    <%- sectionHead('sec-sso-provider', 'Enable single sign-on', 'Where Zettelrobbe sends you to sign in, and how it identifies itself there.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'oidcEnabled',
                                        label: 'Sign in through an OpenID Connect provider',
                                        checked: oidcSwitchOn(config.OIDC_ENABLED, 'no'),
                                        hint: 'OIDC_ENABLED · Signing in with the password keeps working.'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcIssuerUrl" class="zr-field__name">Issuer URL</label>
                                        <input type="text" inputmode="url" id="oidcIssuerUrl" name="oidcIssuerUrl" value="<%= config.OIDC_ISSUER_URL || '' %>" class="zr-input" placeholder="https://auth.example.com/application/o/zettelrobbe/" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_ISSUER_URL · The provider's issuer URL. Its full discovery URL works too.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcClientId" class="zr-field__name">Client ID</label>
                                        <input type="text" id="oidcClientId" name="oidcClientId" value="<%= config.OIDC_CLIENT_ID || '' %>" class="zr-input" placeholder="zettelrobbe" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_CLIENT_ID · The ID of the application you registered with the provider.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcClientSecret" class="zr-field__name">Client secret</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="oidcClientSecret" name="oidcClientSecret" value="" class="zr-input" autocomplete="new-password" placeholder="<%= configuredSecrets.OIDC_CLIENT_SECRET ? 'Configured' : 'Empty for a public client' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="oidcClientSecret" aria-label="Show the client secret"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p class="zr-field__hint">OIDC_CLIENT_SECRET · <%= configuredSecrets.OIDC_CLIENT_SECRET ? 'Leave it empty to keep the stored secret.' : 'Only for a confidential client.' %></p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcRedirectUri" class="zr-field__name">Redirect URI</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" inputmode="url" id="oidcRedirectUri" name="oidcRedirectUri" value="<%= config.OIDC_REDIRECT_URI || '' %>" class="zr-input" placeholder="<%= oidcRedirectDetected %>" data-detected="<%= oidcRedirectDetected %>" autocomplete="off" spellcheck="false">
                                            <button type="button" class="zr-btn" data-el="copy-redirect">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                <span>Copy</span>
                                            </button>
                                        </div>
                                        <p class="zr-field__hint">OIDC_REDIRECT_URI · Register exactly this URL with the provider. Behind a reverse proxy, enter the address people open.</p>
                                        <%# Shown by modules/settings-sso.js when the browser cannot copy: the
                                            address, selected, outside the field it would otherwise fix. %>
                                        <p class="zr-field__hint hidden" data-el="copy-redirect-by-hand">The browser could not copy it. Copy it from here: <code data-el="copy-redirect-text"></code></p>
                                    </div>
                                    <div class="zr-col zr-col--tight zr-sso-test">
                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" class="zr-btn" data-el="test">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plug"/></svg>
                                                <span>Test connection</span>
                                            </button>
                                            <span class="zr-field__hint">Reads the provider's discovery document with the values above. Nothing is saved.</span>
                                        </div>
                                        <div class="hidden" data-el="test-result" role="status" aria-live="polite"></div>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-settings-section" id="sec-sso-access" aria-labelledby="sec-sso-access-title">
                                    <%- sectionHead('sec-sso-access', 'Who may sign in', 'Single sign-on opens the one administrator account, only for the matching e-mail address. Restrict the application at the provider too.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcAdminEmail" class="zr-field__name">Administrator e-mail</label>
                                        <input type="text" inputmode="email" id="oidcAdminEmail" name="oidcAdminEmail" value="<%= config.OIDC_ADMIN_EMAIL || '' %>" class="zr-input" placeholder="you@example.com" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_ADMIN_EMAIL · Your e-mail address at the provider. Upper and lower case do not matter.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcEmailClaim" class="zr-field__name">E-mail claim</label>
                                        <input type="text" id="oidcEmailClaim" name="oidcEmailClaim" value="<%= config.OIDC_EMAIL_CLAIM || 'email' %>" class="zr-input" placeholder="email" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_EMAIL_CLAIM · The claim that carries the e-mail address. Default: email.</p>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'oidcAllowUnverifiedEmail',
                                        label: 'Accept unverified e-mail addresses',
                                        checked: oidcSwitchOn(config.OIDC_ALLOW_UNVERIFIED_EMAIL, 'no'),
                                        hint: 'OIDC_ALLOW_UNVERIFIED_EMAIL · Only for a provider that never confirms addresses. Restrict the application at the provider then. Default: off.'
                                    }) %>
                                    </div>
                                </section>

                                <section class="zr-settings-section" id="sec-sso-button" aria-labelledby="sec-sso-button-title">
                                    <%- sectionHead('sec-sso-button', 'Login button', 'How the button for single sign-on looks on the login page.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-sso-preview" aria-label="Preview of the login button">
                                        <p class="zr-label">Preview</p>
                                        <div class="zr-sso-preview__card zr-col login-sso">
                                            <div class="login-sso__divider zr-sm"><span>or</span></div>
                                            <span class="zr-btn zr-btn--lg zr-btn--block login-sso__button" data-el="preview" aria-hidden="true">
                                                <svg class="zr-icon zr-icon--sm" data-el="preview-default-icon" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                                                <img class="login-sso__icon hidden" data-el="preview-image" alt="">
                                                <span data-el="preview-text">Sign in with SSO</span>
                                            </span>
                                        </div>
                                    </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonText" class="zr-field__name">Text</label>
                                            <input type="text" id="oidcButtonText" name="oidcButtonText" value="<%= config.OIDC_BUTTON_TEXT || '' %>" class="zr-input" maxlength="60" placeholder="Sign in with SSO">
                                            <p class="zr-field__hint">OIDC_BUTTON_TEXT · Up to 60 characters.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonIcon" class="zr-field__name">Icon</label>
                                            <input type="text" id="oidcButtonIcon" name="oidcButtonIcon" value="<%= config.OIDC_BUTTON_ICON || '' %>" class="zr-input" placeholder="Key icon" autocomplete="off" spellcheck="false" inputmode="url">
                                            <p class="zr-field__hint">OIDC_BUTTON_ICON · An https:// image URL, a path on this server such as /favicon.png, or none. Empty shows the key icon.</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonColor" class="zr-field__name">Background</label>
                                            <div class="zr-inputgroup">
                                                <span class="zr-sso-swatch" data-swatch-for="oidcButtonColor" aria-hidden="true"></span>
                                                <input type="text" id="oidcButtonColor" name="oidcButtonColor" value="<%= config.OIDC_BUTTON_COLOR || '' %>" class="zr-input" placeholder="Theme default" autocomplete="off" spellcheck="false">
                                            </div>
                                            <p class="zr-field__hint">OIDC_BUTTON_COLOR · #rrggbb, #rgb, a colour name, rgb(…) or hsl(…).</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonTextColor" class="zr-field__name">Text colour</label>
                                            <div class="zr-inputgroup">
                                                <span class="zr-sso-swatch" data-swatch-for="oidcButtonTextColor" aria-hidden="true"></span>
                                                <input type="text" id="oidcButtonTextColor" name="oidcButtonTextColor" value="<%= config.OIDC_BUTTON_TEXT_COLOR || '' %>" class="zr-input" placeholder="Theme default" autocomplete="off" spellcheck="false">
                                            </div>
                                            <p class="zr-field__hint">OIDC_BUTTON_TEXT_COLOR · The same formats as the background.</p>
                                        </div>
                                    </div>
                                </section>

                                <%- disclosureOpen('id="sec-sso-advanced"', 'Advanced', 'Scopes and token authentication') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcScopeInput" class="zr-field__name">Scopes</label>
                                        <%- include('partials/chip-list', {
                                            id: 'oidcScopeInput', addId: 'oidcScopeAddButton', listId: 'oidcScopesContainer',
                                            valueId: 'oidcScopes', items: String(config.OIDC_SCOPES || 'openid profile email').split(/\s+/),
                                            separator: ' ', envKey: 'OIDC_SCOPES', spellcheck: false,
                                            placeholder: 'Scope, then Enter'
                                        }) %>
                                        <p class="zr-field__hint">OIDC_SCOPES · openid is always added. Keep email, it carries the address. Default: openid profile email.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcTokenAuthMethod" class="zr-field__name">Token authentication</label>
                                        <% const oidcAuthMethod = String(config.OIDC_TOKEN_AUTH_METHOD || '').trim(); %>
                                        <select id="oidcTokenAuthMethod" name="oidcTokenAuthMethod" class="zr-input">
                                            <option value="" <%= oidcAuthMethod === '' ? 'selected' : '' %>>Automatic</option>
                                            <option value="client_secret_basic" <%= oidcAuthMethod === 'client_secret_basic' ? 'selected' : '' %>>client_secret_basic</option>
                                            <option value="client_secret_post" <%= oidcAuthMethod === 'client_secret_post' ? 'selected' : '' %>>client_secret_post</option>
                                            <option value="none" <%= oidcAuthMethod === 'none' ? 'selected' : '' %>>none (public client)</option>
                                        </select>
                                        <p class="zr-field__hint">OIDC_TOKEN_AUTH_METHOD · Automatic picks a method from the secret and what the provider offers.</p>
                                    </div>
                                    </div>
                                </details>
                                </div>
                        <%- entryClose() %>

                        <%- entryOpen('api-key') %>
                                <section class="zr-settings-section" id="sec-api-key" aria-labelledby="sec-api-key-title">
                                    <%- sectionHead('sec-api-key', 'Current key', 'Click the key to copy it. Regenerate replaces it with a new one.') %>
                                    <div class="zr-settings-section__body zr-col">
                                        <div class="zr-inputgroup">
                                            <div id="apiKeyContainer" class="zr-input zr-mono zr-apikey" data-api-key=""
                                                title="Click to copy the API key" role="button" tabindex="0">Loading…</div>
                                            <button type="button" id="regenerateBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" id="regenerateIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                                <span>Regenerate</span>
                                            </button>
                                        </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('caching') %>
                                <section class="zr-settings-section" id="sec-caching" aria-labelledby="sec-caching-title">
                                    <%- sectionHead('sec-caching', 'Caching', 'Zettelrobbe keeps the Paperless-ngx tags for a while and document previews on disk, so its pages load faster.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="tagCacheTTL" class="zr-field__name">
                                            Tag cache lifetime (seconds)
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="tagCacheTTLHelp">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                            </button>
                                        </label>
                                        <input type="number" id="tagCacheTTL" name="tagCacheTTL" min="60" max="3600" value="<%= config.TAG_CACHE_TTL_SECONDS || 300 %>" class="zr-input" required>
                                    </div>
                                    <button type="button" id="clearTagCacheBtn" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" id="clearCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                        <span>Clear tag cache</span>
                                    </button>
    
                                    <div class="zr-col">
                                        <div class="zr-row zr-row--between">
                                            <div>
                                                <p class="zr-field__name">Thumbnail cache</p>
                                                <p class="zr-field__hint">Document previews Zettelrobbe keeps on disk, in <code>data/thumb-cache</code>.</p>
                                            </div>
                                            <button type="button" id="refreshThumbnailCacheStatsBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                                <span>Refresh</span>
                                            </button>
                                        </div>
    
                                        <div class="zr-row zr-row--wrap zr-settings-figures">
                                            <div >
                                                <p class="zr-field__hint">Files</p>
                                                <p id="thumbnailCacheFileCount" class="zr-module__title">-</p>
                                            </div>
                                            <div >
                                                <p class="zr-field__hint">Total size</p>
                                                <p id="thumbnailCacheTotalSize" class="zr-module__title">-</p>
                                            </div>
                                        </div>
    
                                        <button type="button" id="clearThumbnailCacheBtn" class="zr-btn zr-btn--danger">
                                            <svg class="zr-icon zr-icon--sm" id="clearThumbnailCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                            <span>Clear thumbnail cache</span>
                                        </button>
                                    </div>
    
                                    </div>
                                </section>

                                <section class="zr-settings-section" id="sec-history-reconciliation" aria-labelledby="sec-history-reconciliation-title">
                                    <%- sectionHead('sec-history-reconciliation', 'History clean-up', 'Zettelrobbe removes its records of documents that were deleted in Paperless-ngx. A run waits for a scan to finish first. Paperless-ngx itself is not changed.') %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose">
                                        <%- include('partials/settings-switch', {
                                            id: 'reconciliationEnabled',
                                            label: 'Clean up on a schedule',
                                            checked: String(config.RECONCILIATION_ENABLED || 'yes').toLowerCase() === 'yes',
                                            hint: 'Runs the clean-up on the schedule below. With the switch off, it runs only when you press Clean up now.'
                                        }) %>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="reconciliationInterval" class="zr-field__name">Clean-up schedule (cron)</label>
                                            <input type="text" id="reconciliationInterval" name="reconciliationInterval" value="<%= config.RECONCILIATION_INTERVAL || '0 * * * *' %>" class="zr-input" placeholder="0 * * * *">
                                            <p class="zr-field__hint">Every hour by default.</p>
                                        </div>
                                    <div>
                                        <button type="button" id="forceReconcileBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            <span>Clean up now</span>
                                        </button>
                                        <div id="reconcileResult" class="hidden"></div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('quickstart') %>
                                <section class="zr-settings-section" id="sec-quickstart-auto-detect" aria-labelledby="sec-quickstart-auto-detect-title">
                                    <%- sectionHead('sec-quickstart-auto-detect', 'Ask a server', 'Works with Ollama, LM Studio and other OpenAI-compatible servers. Apply fills in <a href="#ai-provider" class="zr-link zr-link--underline">AI provider</a> and <a href="#ocr" class="zr-link zr-link--underline">OCR</a>. Nothing is saved until you apply the models and save.') %>
                                    <%# Nothing here is a setting the save sends: Apply writes the
                                        real fields of AI provider and OCR, and those count. %>
                                    <div class="zr-settings-section__body zr-col zr-col--loose" data-not-a-setting>
    <%
    /* Only the provider actually in use may prefill this field. config.OLLAMA_API_URL
       carries a default of http://localhost:11434 and is therefore never empty, so
       "whichever is set" would hand every OpenAI or Azure install a localhost URL it
       never configured. The stored key follows the same provider, and the route
       below only substitutes it when the detection targets that same server. */
    const quickstartProvider = String(config.AI_PROVIDER || '').toLowerCase();
    const quickstartUrl =
        quickstartProvider === 'ollama' ? (config.OLLAMA_API_URL || '')
        : quickstartProvider === 'custom' ? (config.CUSTOM_BASE_URL || '')
        : '';
    const quickstartKeyStored =
        quickstartProvider === 'ollama' ? Boolean(configuredSecrets.OLLAMA_API_KEY)
        : quickstartProvider === 'custom' ? Boolean(configuredSecrets.CUSTOM_API_KEY)
        : false;
    -%>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="settingsQuickstartUrl" class="zr-field__name">Server address</label>
                                        <input type="text" id="settingsQuickstartUrl" class="zr-input" value="<%= quickstartUrl %>" placeholder="http://192.168.1.5:1234" inputmode="url">
                                        <% if (quickstartUrl) { %>
                                            <p class="zr-field__hint">Taken from the AI provider in use.</p>
                                        <% } %>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="settingsQuickstartApiKey" class="zr-field__name">API key (optional)</label>
                                        <input type="password" id="settingsQuickstartApiKey" class="zr-input" placeholder="<%= quickstartKeyStored ? 'Configured' : 'Optional' %>">
                                        <% if (quickstartKeyStored) { %>
                                            <p class="zr-field__hint">Leave it empty to use the stored key of this server.</p>
                                        <% } %>
                                    </div>
                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="settingsQuickstartDetectBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                            <span>Detect models</span>
                                        </button>
                                        <span id="settingsQuickstartState" class="zr-field__hint">Not detected</span>
                                    </div>
                                    <div id="settingsQuickstartResults" class="zr-col zr-col--loose hidden">
                                        <p id="settingsQuickstartHint" class="zr-field__hint"></p>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="settingsQuickstartAiModel" class="zr-field__name">Model for the analysis</label>
                                            <select id="settingsQuickstartAiModel" class="zr-input"></select>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="settingsQuickstartOcrModel" class="zr-field__name">Model for OCR</label>
                                            <select id="settingsQuickstartOcrModel" class="zr-input"></select>
                                        </div>
                                        <div class="zr-switchrow">
                                            <div class="zr-grow">
                                                <label for="settingsQuickstartEnableOcr" class="zr-field__name">Use this service for OCR</label>
                                                <p class="zr-field__hint">Apply also switches OCR on, with this server and the model for OCR.</p>
                                            </div>
                                            <input type="checkbox" class="zr-toggle" id="settingsQuickstartEnableOcr">
                                        </div>
                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" id="settingsQuickstartApplyBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                                <span>Apply</span>
                                            </button>
                                            <button type="button" id="settingsQuickstartSaveBtn" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                                <span>Test models and save</span>
                                            </button>
                                            <span id="settingsQuickstartApplyHint" class="zr-field__hint"></span>
                                        </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('set-by-environment') %>
                                <%- include('partials/settings-environment', { overview: environmentTopic }) %>
                        <%- entryClose() %>

                        <%- entryOpen('environment') %>
                                <section class="zr-settings-section" id="sec-env-file" aria-labelledby="sec-env-file-title" data-module="env-file">
                                    <%- sectionHead('sec-env-file', 'Configuration as a .env file', 'The configuration in use, grouped by topic, with only the settings that have a value. <a href="#set-by-environment" class="zr-link zr-link--underline">Set by the environment</a> lists what the environment decides.') %>
                                    <div class="zr-settings-section__body zr-col" data-not-a-setting>

                                        <div class="zr-alert zr-alert--warn">
                                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                                            <div class="zr-alert__body">
                                                <p class="zr-sm">
                                                    It contains API tokens and keys in clear text. <code>JWT_SECRET</code>
                                                    is left out. A fresh instance generates its own.
                                                </p>
                                            </div>
                                        </div>

                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" id="envFileShowBtn" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-code"/></svg>
                                                <span>Show configuration</span>
                                            </button>
                                            <button type="button" id="envFileCopyBtn" class="zr-btn hidden">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                <span>Copy</span>
                                            </button>
                                            <span class="zr-sm zr-faint" id="envFileMeta"></span>
                                        </div>
    
                                        <textarea id="envFileOutput" class="zr-textarea zr-mono hidden" rows="18" readonly
                                            spellcheck="false" aria-label="Configuration as a .env file"></textarea>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('changelog') %>
                                <section class="zr-settings-section" id="sec-release-history" aria-labelledby="sec-release-history-title">
                                    <%- sectionHead('sec-release-history', 'Release history', 'The current release is expanded.', `<a href="https://github.com/admonstrator/zettelrobbe/releases" target="_blank" rel="noopener noreferrer" class="changelog-source-link">
                                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-github"/></svg>
                                            <span>Full release notes</span>
                                        </a>`) %>
                                    <%
                                        const releaseList = Array.isArray(changelogReleases) ? changelogReleases : [];
                                        const categoryMeta = {
                                            new: { label: 'New', icon: 'i-plus' },
                                            fix: { label: 'Fix', icon: 'i-wrench' },
                                            improvement: { label: 'Improved', icon: 'i-arrow-up' },
                                            removed: { label: 'Removed', icon: 'i-minus' },
                                            security: { label: 'Security', icon: 'i-shield' },
                                            note: { label: 'Note', icon: 'i-info' }
                                        };
                                    %>

                                    <% if (releaseList.length === 0) { %>
                                    <div class="zr-settings-section__body">
                                        <p class="zr-sm zr-faint">No release history available.</p>
                                    </div>
                                    <% } else { %>
                                        <%# A release is a row of the section that folds, ruled off
                                            from the next one like every row, not a panel of its own. %>
                                        <ol class="changelog-timeline">
                                            <% releaseList.forEach(function (release, releaseIndex) { %>
                                                <li class="changelog-release<%= releaseIndex === 0 ? ' changelog-release--current' : '' %>">
                                                    <details class="changelog-details zr-settings-disclosure"<%= releaseIndex === 0 ? ' open' : '' %>>
                                                        <summary class="changelog-summary zr-settings-disclosure__summary">
                                                            <span class="changelog-version"><%= release.version %></span>
                                                            <% if (releaseIndex === 0) { %>
                                                                <span class="changelog-current-pill">Current</span>
                                                            <% } %>
                                                            <span class="changelog-count"><%= release.entries.length %> change<%= release.entries.length === 1 ? '' : 's' %></span>
                                                            <svg class="zr-icon zr-icon--sm zr-settings-disclosure__chevron" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                                        </summary>
                                                        <ul class="changelog-entries">
                                                            <% release.entries.forEach(function (entry) { %>
                                                                <%
                                                                    const meta = categoryMeta[entry.category] || categoryMeta.note;
                                                                %>
                                                                <li class="changelog-entry">
                                                                    <span class="changelog-badge changelog-badge--<%= entry.category %>">
                                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#<%= meta.icon %>"/></svg>
                                                                        <%= meta.label %>
                                                                    </span>
                                                                    <%# Entries are authored in config/changelog.js and may contain links, so they render as HTML. %>
                                                                    <span class="changelog-text"><%- entry.text %></span>
                                                                </li>
                                                            <% }); %>
                                                        </ul>
                                                    </details>
                                                </li>
                                            <% }); %>
                                        </ol>
                                    <% } %>
                                </section>
                        <%- entryClose() %>

                    </form>
                    </div>
                </div>
                <div class="zr-settings-scroll__reserve" data-el="reserve" aria-hidden="true"></div>
                </div>

                <%# The save bar: the last row of the page column, under the region
                    that scrolls, and there only while a change is not saved
                    (modules/settings-form.js removes the hidden attribute). Its
                    buttons sit outside the form and belong to it through form=. %>
                <div class="zr-actionbar" id="settingsSaveRow" data-el="actionbar" data-dirty="false" role="region" aria-label="Unsaved changes" hidden>
                    <div class="zr-actionbar__inner">
                        <div class="zr-actionbar__status">
                            <p class="zr-actionbar__title">
                                <span data-el="status" aria-live="polite">No unsaved changes</span>
                                <span class="zr-badge zr-badge--warn hidden" data-el="restart">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                    Restart needed
                                </span>
                            </p>
                            <p class="zr-actionbar__list" data-el="changes"></p>
                        </div>
                        <div class="zr-actionbar__actions">
                            <button type="button" class="zr-btn" data-el="reset" disabled>Discard</button>
                            <button type="submit" class="zr-btn zr-btn--primary" data-el="save" form="setupForm">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                Save settings
                            </button>
                        </div>
                    </div>
                </div>
                </div>
            </div>

    <%- include('partials/restart-overlay') %>
    <%- include('partials/model-test-overlay') %>

    <script>
        window.__SETTINGS_BOOTSTRAP__ = {
            aiProviderPresets: <%- JSON.stringify(Array.isArray(aiProviderPresets) ? aiProviderPresets : []).replace(/</g, '\\u003c') %>,
            anthropic: <%- JSON.stringify(anthropic).replace(/</g, '\\u003c') %>
        };
    </script>
    <%- include('partials/scripts/settings-scripts') %>
    <script src="/js/settings.js?v=<%= version || 'dev' %>"></script>
    <%- include('partials/shell/body-close') %>
