                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="azureApiKey" class="zr-field__name">Azure API Key</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="azureApiKey" name="azureApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.AZURE_API_KEY ? 'Configured' : 'Enter Azure API key' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="azureApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p class="zr-field__hint">Restart required<%= configuredSecrets.AZURE_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
