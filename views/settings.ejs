                                        <label for="azureDeploymentName" class="zr-field__name">Deployment</label>
                                        <input type="text" id="azureDeploymentName" name="azureDeploymentName" value="<%= config.AZURE_DEPLOYMENT_NAME %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="azureApiVersion" class="zr-field__name">API Version</label>
                                        <input type="text" id="azureApiVersion" name="azureApiVersion" value="<%= config.AZURE_API_VERSION %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                </div>

                                <h4 class="zr-label">Model Parameters</h4>
                                <div class="zr-formgrid">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="tokenLimit" class="zr-field__name">Token Limit</label>
                                        <input type="number" id="tokenLimit" name="tokenLimit" value="<%= config.TOKEN_LIMIT %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="responseTokens" class="zr-field__name">Response Tokens</label>
                                        <input type="number" id="responseTokens" name="responseTokens" value="<%= config.RESPONSE_TOKENS %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="aiTemperatureAnalysis" class="zr-field__name">Analysis Temperature</label>
                                        <input type="number" id="aiTemperatureAnalysis" name="aiTemperatureAnalysis" value="<%= config.AI_TEMPERATURE_ANALYSIS || '0.3' %>" min="0" max="2" step="0.1" class="zr-input">
                                        <p class="zr-field__hint">Range: 0.0-2.0 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="aiTemperatureGeneration" class="zr-field__name">Generation Temperature</label>
                                        <input type="number" id="aiTemperatureGeneration" name="aiTemperatureGeneration" value="<%= config.AI_TEMPERATURE_GENERATION || '0.7' %>" min="0" max="2" step="0.1" class="zr-input">
                                        <p class="zr-field__hint">Range: 0.0-2.0 · Restart required</p>
                                    </div>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-ai-behavior">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">AI Behavior</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <%- include('partials/settings-switch', {
                                    id: 'aiProcessedTag',
                                    label: 'Add AI-processed tag to documents',
                                    checked: config.ADD_AI_PROCESSED_TAG === 'yes',
                                    hint: 'Restart required'
                                }) %>
                                <div id="aiTagNameSection" class="<%= config.ADD_AI_PROCESSED_TAG === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                    <label for="aiTagName" class="zr-field__name">AI-processed Tag Name</label>
                                    <input type="text" id="aiTagName" name="aiTagName" value="<%= config.AI_PROCESSED_TAG_NAME || 'ai-processed' %>" class="zr-input">
                                    <p class="zr-field__hint">Restart required</p>
                                </div>

                                <%- include('partials/settings-switch', {
                                    id: 'usePromptTags',
                                    label: 'Use specific tags in prompt',
                                    checked: config.USE_PROMPT_TAGS === 'yes',
                                    hint: 'Restart required'
                                }) %>

                                <div id="promptTagsSection" class="<%= config.USE_PROMPT_TAGS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                    <label for="promptTagInput" class="zr-field__name">Prompt Tags</label>
                                    <div class="zr-inputgroup">
                                        <input type="text" id="promptTagInput" class="zr-input" placeholder="Enter a tag and press Enter">
                                        <button type="button" class="zr-btn zr-btn--primary">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                            Add
                                        </button>
                                    </div>
                                    <div id="promptTagsContainer" class="zr-chips">
                                        <% if (config.PROMPT_TAGS && Array.isArray(config.PROMPT_TAGS) && config.PROMPT_TAGS.length > 0) { %>
                                            <% config.PROMPT_TAGS.forEach(tag => { %>
                                                <div class="zr-chip">
                                                    <span><%= tag %></span>
                                                    <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                    <input type="hidden" id="promptTags" name="promptTags" value="<%= Array.isArray(config.PROMPT_TAGS) ? config.PROMPT_TAGS.join(',') : '' %>">
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label for="systemPrompt" class="zr-field__name">Prompt Description</label>
                                    <textarea id="systemPrompt" name="systemPrompt" rows="8" class="zr-textarea" placeholder="Describe how the AI should analyze your documents..."><%= config.SYSTEM_PROMPT %></textarea>
                                    <button id="systemPromptBtn" type="button" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-bulb"/></svg>
                                        Example
                                    </button>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-restrictions">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Restrictions</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-formgrid">
                                    <label for="restrictToExistingTags" class="zr-checktile">
                                        <input type="checkbox" id="restrictToExistingTags" name="restrictToExistingTags" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_TAGS === 'yes' ? 'checked' : '' %>>
                                        <span>Restrict to Existing Tags</span>
                                    </label>
                                    <label for="restrictToExistingCorrespondents" class="zr-checktile">
                                        <input type="checkbox" id="restrictToExistingCorrespondents" name="restrictToExistingCorrespondents" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_CORRESPONDENTS === 'yes' ? 'checked' : '' %>>
                                        <span>Restrict to Existing Correspondents</span>
                                    </label>
                                    <label for="restrictToExistingDocumentTypes" class="zr-checktile">
                                        <input type="checkbox" id="restrictToExistingDocumentTypes" name="restrictToExistingDocumentTypes" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_DOCUMENT_TYPES === 'yes' ? 'checked' : '' %>>
                                        <span>Restrict to Existing Document Types</span>
                                    </label>
                                </div>
                                <p class="zr-field__hint">Restart required</p>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-external-api">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">External API</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-switchrow">
                                    <div class="zr-grow">
                                        <label for="externalApiEnabled" class="zr-field__name">Enable External API Integration</label>
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <input type="checkbox" class="zr-toggle" id="externalApiEnabled" name="externalApiEnabled" <%= config.EXTERNAL_API_ENABLED === 'yes' ? 'checked' : '' %>>
                                </div>

                                <div id="externalApiSettings" class="zr-col zr-col--loose <%= config.EXTERNAL_API_ENABLED === 'yes' ? '' : 'hidden' %>">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiUrl" class="zr-field__name">API URL</label>
                                        <input type="text" id="externalApiUrl" name="externalApiUrl" value="<%= config.EXTERNAL_API_URL || '' %>" class="zr-input">
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiMethod" class="zr-field__name">HTTP Method</label>
                                        <select id="externalApiMethod" name="externalApiMethod" class="zr-input">
                                            <option value="GET" <%= config.EXTERNAL_API_METHOD === 'GET' ? 'selected' : '' %>>GET</option>
                                            <option value="POST" <%= config.EXTERNAL_API_METHOD === 'POST' ? 'selected' : '' %>>POST</option>
                                            <option value="PUT" <%= config.EXTERNAL_API_METHOD === 'PUT' ? 'selected' : '' %>>PUT</option>
                                        </select>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiHeaders" class="zr-field__name">Headers (JSON)</label>
                                        <textarea id="externalApiHeaders" name="externalApiHeaders" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_HEADERS || '' %></textarea>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiBody" class="zr-field__name">Request Body (JSON)</label>
                                        <textarea id="externalApiBody" name="externalApiBody" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_BODY || '' %></textarea>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiTimeout" class="zr-field__name">Timeout (milliseconds)</label>
                                        <input type="number" id="externalApiTimeout" name="externalApiTimeout" value="<%= config.EXTERNAL_API_TIMEOUT || '5000' %>" class="zr-input">
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="externalApiTransform" class="zr-field__name">Transform Path</label>
                                        <textarea id="externalApiTransform" name="externalApiTransform" rows="4" class="zr-textarea"><%= config.EXTERNAL_API_TRANSFORM || '' %></textarea>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'externalApiAllowPrivateIps',
                                        label: 'Allow private IPs for external API',
                                        checked: config.EXTERNAL_API_ALLOW_PRIVATE_IPS === 'yes',
                                        hint: 'Restart required'
                                    }) %>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-ai-function-limits">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">AI Function Limits</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-formgrid">
                                    <label for="activateTagging" class="zr-checktile"><input type="checkbox" id="activateTagging" name="activateTagging" class="zr-toggle" <%= config.ACTIVATE_TAGGING === 'yes' ? 'checked' : '' %>><span>Tags Assignment</span></label>
                                    <label for="activateCorrespondents" class="zr-checktile"><input type="checkbox" id="activateCorrespondents" name="activateCorrespondents" class="zr-toggle" <%= config.ACTIVATE_CORRESPONDENTS === 'yes' ? 'checked' : '' %>><span>Correspondent Detection</span></label>
                                    <label for="activateDocumentType" class="zr-checktile"><input type="checkbox" id="activateDocumentType" name="activateDocumentType" class="zr-toggle" <%= config.ACTIVATE_DOCUMENT_TYPE === 'yes' ? 'checked' : '' %>><span>Document Type Classification</span></label>
                                    <label for="activateTitle" class="zr-checktile"><input type="checkbox" id="activateTitle" name="activateTitle" class="zr-toggle" <%= config.ACTIVATE_TITLE === 'yes' ? 'checked' : '' %>><span>Title Generation</span></label>
                                    <label for="activateCustomFields" class="zr-checktile"><input type="checkbox" id="activateCustomFields" name="activateCustomFields" class="zr-toggle" <%= config.ACTIVATE_CUSTOM_FIELDS === 'yes' ? 'checked' : '' %>><span>Custom Fields</span></label>
                                </div>
                                <p class="zr-field__hint">Restart required</p>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-custom-fields">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Custom Fields</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div id="customFieldsList" class="zr-field zr-field--stacked">
                                    <% let _parsedCustomFields = []; try { const _cf = JSON.parse(config.CUSTOM_FIELDS || '{}'); if (Array.isArray(_cf.custom_fields)) _parsedCustomFields = _cf.custom_fields; } catch(e) {} %>
                                    <% if (_parsedCustomFields.length > 0) { %>
                                        <% _parsedCustomFields.forEach((field) => { %>
                                            <div class="custom-field-item zr-row">
                                                <div class="zr-faint" style="cursor: move"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-grip"/></svg></div>
                                                <div class="zr-grow">
                                                    <p class="zr-strong"><%= field.value %></p>
                                                    <p class="zr-sm zr-faint">Type: <%= field.data_type %> <%= field.data_type === 'monetary' && field.currency ? `(${field.currency})` : '' %></p>
                                                </div>
                                                <button type="button" onclick="removeCustomField(this)" class="zr-btn zr-btn--ghost zr-btn--icon zr-btn--danger"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg></button>
                                            </div>
                                        <% }); %>
                                    <% } %>
                                </div>

                                <div class="zr-row zr-row--wrap customfield-add">
                                    <div class="zr-grow"><input type="text" id="newFieldName" class="zr-input" placeholder="Enter field name..."></div>
                                    <div>
                                        <select id="newFieldType" onchange="toggleCurrencySelect()" class="zr-input">
                                            <option value="string">Text</option>
                                            <option value="float">Number</option>
                                            <option value="integer">Integer</option>
                                            <option value="monetary">Currency</option>
                                            <option value="date">Date</option>
                                            <option value="boolean">Boolean</option>
                                        </select>
                                    </div>
                                    <div>
                                        <select id="currencyCode" class="zr-select hidden">
                                            <option value="EUR">EUR</option>
                                            <option value="USD">USD</option>
                                            <option value="GBP">GBP</option>
                                            <option value="JPY">JPY</option>
                                            <option value="CHF">CHF</option>
                                        </select>
                                    </div>
                                    <div><button type="button" onclick="addCustomField()" class="zr-btn zr-btn--primary zr-btn--block">Add</button></div>
                                </div>
                                <input type="hidden" id="customFieldsJson" name="customFields" value='<%= config.CUSTOM_FIELDS || "{\"custom_fields\":[]}" %>'>
                                <p class="zr-field__hint">Restart required</p>
                                </div>
                            </section>
                        </div>

                        <div id="duplicates-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-duplicates">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Duplicates</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <p class="zr-sm zr-muted">
                                    The Duplicates page finds tags and correspondents that mean the same thing. Finding and merging
                                    them is deterministic and needs none of these settings; they only govern the optional AI review
                                    that judges the proposed groups when you ask for it. Nothing here starts a scan or a merge on its own.
                                </p>
                                <%- include('partials/settings-switch', {
                                    id: 'duplicatesAiReview',
                                    label: 'Offer the AI review on the Duplicates page',
                                    checked: (config.DUPLICATES_AI_REVIEW || 'yes') === 'yes',
                                    hint: 'Default: on · Off keeps the model off the page: Find duplicates and Scan apply the spelling rules only · Restart required'
                                }) %>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiModel" class="zr-field__name">Model for the judge</label>
                                    <input type="text" id="duplicatesAiModel" name="duplicatesAiModel" value="<%= config.DUPLICATES_AI_MODEL || '' %>" class="zr-input" placeholder="Leave empty to use the configured model">
                                    <p class="zr-field__hint">A stronger model of the same provider, used only for judging duplicates · Default: empty, which means the provider's configured model · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiReviewBatchSize" class="zr-field__name">Pairs per model request</label>
                                    <input type="number" id="duplicatesAiReviewBatchSize" name="duplicatesAiReviewBatchSize" min="1" max="100" step="1" value="<%= config.DUPLICATES_AI_REVIEW_BATCH_SIZE || 25 %>" class="zr-input">
                                    <p class="zr-field__hint">How many name pairs one request asks about; fewer pairs mean more requests, more pairs need a larger context (1-100) · Default: 25 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiCandidateFloor" class="zr-field__name">Lowest matcher score shown to the model</label>
                                    <input type="number" id="duplicatesAiCandidateFloor" name="duplicatesAiCandidateFloor" min="0.5" max="0.95" step="0.01" value="<%= config.DUPLICATES_AI_CANDIDATE_FLOOR || '0.6' %>" class="zr-input">
                                    <p class="zr-field__hint">Near-misses below your sensitivity but above this score are judged too; a lower value asks about more pairs (0.50-0.95) · Default: 0.6 · Restart required</p>
                                </div>
                                <%- include('partials/settings-switch', {
                                    id: 'duplicatesAiExcerpts',
                                    label: 'Read document excerpts for spelling-only pairs',
                                    checked: (config.DUPLICATES_AI_EXCERPTS || 'yes') === 'yes',
                                    hint: 'Default: on · Sends a short excerpt of a couple of documents when the matcher linked a pair by spelling alone, so a typo-like pair that means two different things can be told apart · Restart required'
                                }) %>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiExcerptChars" class="zr-field__name">Excerpt length in characters</label>
                                    <input type="number" id="duplicatesAiExcerptChars" name="duplicatesAiExcerptChars" min="50" max="500" step="1" value="<%= config.DUPLICATES_AI_EXCERPT_CHARS || 300 %>" class="zr-input">
                                    <p class="zr-field__hint">How much of each document the judge gets to read; longer excerpts cost tokens (50-500) · Default: 300 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiExcerptDocuments" class="zr-field__name">Documents per entry for excerpts</label>
                                    <input type="number" id="duplicatesAiExcerptDocuments" name="duplicatesAiExcerptDocuments" min="1" max="5" step="1" value="<%= config.DUPLICATES_AI_EXCERPT_DOCUMENTS || 2 %>" class="zr-input">
                                    <p class="zr-field__hint">How many documents of each tag or correspondent are sampled for those excerpts (1-5) · Default: 2 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiTokenBudget" class="zr-field__name">Token budget per review</label>
                                    <input type="number" id="duplicatesAiTokenBudget" name="duplicatesAiTokenBudget" min="0" max="10000000" step="1000" value="<%= config.DUPLICATES_AI_TOKEN_BUDGET || 200000 %>" class="zr-input">
                                    <p class="zr-field__hint">The most one review may spend across all its requests; when it is reached the review stops and keeps the verdicts it has, and 0 means no limit (0-10000000) · Default: 200000 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiIdleStopSeconds" class="zr-field__name">Stop an unwatched review after (seconds)</label>
                                    <input type="number" id="duplicatesAiIdleStopSeconds" name="duplicatesAiIdleStopSeconds" min="0" max="3600" step="1" value="<%= config.DUPLICATES_AI_IDLE_STOP_SECONDS || 60 %>" class="zr-input">
                                    <p class="zr-field__hint">A review nobody has been watching for this long stops itself, so a closed tab cannot leave the model running, and 0 means never (0-3600) · Default: 60 · Restart required</p>
                                </div>
                                <%- include('partials/settings-switch', {
                                    id: 'duplicatesAiThinking',
                                    label: 'Let the judge think',
                                    checked: (config.DUPLICATES_AI_THINKING || 'no') === 'yes',
                                    hint: 'Reasoning models write their thoughts before the answer and spend the whole answer budget on them. Off, the judge gets its evidence instead and answers in a fraction of the time and cost. On only if your model answers badly without it. Default: off · Restart required.'
                                }) %>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiRequestSeconds" class="zr-field__name">Seconds per model request</label>
                                    <input type="number" id="duplicatesAiRequestSeconds" name="duplicatesAiRequestSeconds" min="5" max="300" step="5" value="<%= config.DUPLICATES_AI_REQUEST_SECONDS || 30 %>" class="zr-input">
                                    <p class="zr-field__hint">The judge measures your model on a small first request and then asks about as many pairs per request as fit into this many seconds. Shorter means more, smaller requests and more frequent progress. Default: 30 · Restart required.</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiConcurrency" class="zr-field__name">Model requests at once</label>
                                    <input type="number" id="duplicatesAiConcurrency" name="duplicatesAiConcurrency" min="0" max="8" step="1" value="<%= config.DUPLICATES_AI_CONCURRENCY || 0 %>" class="zr-input">
                                    <p class="zr-field__hint">0 lets the judge choose: one for Ollama, three for a hosted endpoint. Wall time divides by it, tokens do not. Default: 0 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiVerdictMemoryDays" class="zr-field__name">Remember verdicts for (days)</label>
                                    <input type="number" id="duplicatesAiVerdictMemoryDays" name="duplicatesAiVerdictMemoryDays" min="0" max="365" step="1" value="<%= config.DUPLICATES_AI_VERDICT_MEMORY_DAYS || 90 %>" class="zr-input">
                                    <p class="zr-field__hint">A pair the model judged is not asked again while both names are unchanged; 0 switches the memory off. Default: 90 · Restart required</p>
                                </div>
                                <%- include('partials/settings-switch', {
                                    id: 'duplicatesGuardNewNames',
                                    label: 'Reuse an existing name instead of creating a near-duplicate',
                                    checked: (config.DUPLICATES_GUARD_NEW_NAMES || 'yes') === 'yes',
                                    hint: 'When document analysis proposes a tag or correspondent that is the same word in another spelling (case, umlauts, legal form, plural, word order), the existing one is used and the mapping is listed on the Duplicates page. A typo-like match is only logged. Default: on · Restart required.'
                                }) %>
                                <div class="zr-field zr-field--stacked">
                                    <label for="duplicatesAiSweepNames" class="zr-field__name">Names per request for the semantic sweep</label>
                                    <input type="number" id="duplicatesAiSweepNames" name="duplicatesAiSweepNames" min="50" max="1000" step="50" value="<%= config.DUPLICATES_AI_SWEEP_NAMES || 300 %>" class="zr-input">
                                    <p class="zr-field__hint">How many names the model sees per request when it looks at the whole list. Default: 300 · Restart required.</p>
                                </div>
                                </div>
                            </section>
                        </div>

                        <div id="simplify-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-simplify">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Simplify tags</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <p class="zr-sm zr-muted">
                                    The Simplify tags page turns a compound tag such as "Stromrechnung" into a document type
                                    ("Rechnung") and topic tags ("Strom"). Decomposing against a saved vocabulary is a rule and
                                    needs no model; these two settings only govern the optional proposals the model makes.
                                </p>
                                <div class="zr-field zr-field--stacked">
                                    <label for="simplifyTagsPerRequest" class="zr-field__name">Tags per model request</label>
                                    <input type="number" id="simplifyTagsPerRequest" name="simplifyTagsPerRequest" min="10" max="200" step="10" value="<%= config.SIMPLIFY_TAGS_PER_REQUEST || 50 %>" class="zr-input">
                                    <p class="zr-field__hint">How many tag names one request asks the model to decompose; fewer names mean more requests (10-200) · Default: 50 · Restart required</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="simplifyVocabularySize" class="zr-field__name">Vocabulary size</label>
                                    <input type="number" id="simplifyVocabularySize" name="simplifyVocabularySize" min="5" max="100" step="5" value="<%= config.SIMPLIFY_VOCABULARY_SIZE || 25 %>" class="zr-input">
                                    <p class="zr-field__hint">How many entries the proposed vocabulary should aim at, document types and topics together (5-100) · Default: 25 · Restart required</p>
                                </div>
                                </div>
                            </section>
                        </div>

                        <div id="ocr-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-ocr-fallback">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">OCR Fallback</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <%- include('partials/settings-switch', {
                                    id: 'mistralOcrEnabled',
                                    label: 'Enable OCR',
                                    checked: config.MISTRAL_OCR_ENABLED === 'yes',
                                    hint: 'Restart required'
                                }) %>
                                <div id="ocrFieldsContainer" class="zr-field zr-field--stacked <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'hidden' %>">
                                <div class="zr-field zr-field--stacked">
                                    <label for="ocrProvider" class="zr-field__name">OCR Provider</label>
                                    <select id="ocrProvider" name="ocrProvider" class="zr-input">
                                        <option value="mistral" <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'selected' : '' %>>Mistral OCR API</option>
                                        <option value="custom" <%= ((config.OCR_PROVIDER || 'mistral') === 'custom' || (config.OCR_PROVIDER || 'mistral') === 'ollama') ? 'selected' : '' %>>Custom (Ollama, LM Studio, local models)</option>
                                    </select>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                <div id="ocrApiUrlContainer" class="zr-field zr-field--stacked">
                                    <label for="ocrApiUrl" class="zr-field__name">OCR API URL (optional override)</label>
                                    <input type="text" id="ocrApiUrl" name="ocrApiUrl" value="<%= config.OCR_API_URL || '' %>" class="zr-input" placeholder="Leave empty to use provider default">
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                <div id="ocrApiKeyContainer" class="zr-field zr-field--stacked">
                                    <label for="ocrApiKey" class="zr-field__name">OCR API Key</label>
                                    <div class="zr-inputgroup">
                                        <input type="password" id="ocrApiKey" name="ocrApiKey" value="" class="zr-input" placeholder="<%= (configuredSecrets.OCR_API_KEY || configuredSecrets.MISTRAL_API_KEY) ? 'Configured' : 'Required for Mistral' %>">
                                        <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="ocrApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                    </div>
                                    <p class="zr-field__hint">Restart required · Optional for local and custom providers<%= (configuredSecrets.OCR_API_KEY || configuredSecrets.MISTRAL_API_KEY) ? ' · Leave empty to keep the stored value' : '' %></p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="mistralOcrModel" class="zr-field__name">OCR Model</label>
                                    <div class="zr-inputgroup">
                                        <select id="mistralOcrModel" name="mistralOcrModel" class="zr-input">
                                            <option value="<%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %>" selected><%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %></option>
                                        </select>
                                        <button type="button" id="fetchOcrModelsBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                            <span>Fetch OCR Models</span>
                                        </button>
                                    </div>
                                    <p id="ocrModelVisionHint" class="zr-field__hint <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'hidden' : '' %>">Vision support is detected from the model name, so the list is grouped rather than filtered &middot; models outside the recommended group may still work</p>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                <div id="ocrPdfRenderContainer" class="zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'ocrPdfRenderEnabled',
                                        label: 'Render PDF Pages (poppler)',
                                        checked: (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes',
                                        hint: 'Render PDF pages with poppler (pdftoppm) so local vision models can OCR multi-page documents; falls back to the first-page thumbnail when poppler is not installed · Restart required'
                                    }) %>
                                    <div id="ocrPdfRenderOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes' ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ocrPdfRenderMaxPages" class="zr-field__name">Max PDF Pages per Document</label>
                                            <input type="number" id="ocrPdfRenderMaxPages" name="ocrPdfRenderMaxPages" min="1" max="50" step="1" value="<%= config.OCR_PDF_RENDER_MAX_PAGES || 10 %>" class="zr-input">
                                            <p class="zr-field__hint">Each page is one vision model request; pages beyond the limit are skipped · Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ocrPdfRenderDpi" class="zr-field__name">PDF Render Resolution (DPI)</label>
                                            <input type="number" id="ocrPdfRenderDpi" name="ocrPdfRenderDpi" min="72" max="300" step="1" value="<%= config.OCR_PDF_RENDER_DPI || 150 %>" class="zr-input">
                                            <p class="zr-field__hint">Higher values improve OCR accuracy but increase image size (72–300) · Restart required</p>
                                        </div>
                                    </div>
                                </div>
                                <div id="ocrAutoProcessContainer" class="zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'ocrAutoProcessEnabled',
                                        label: 'Process OCR Queue Automatically',
                                        checked: (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes',
                                        hint: 'Work through queued documents on a schedule instead of pressing "Process All Pending" on the OCR page · Restart required'
                                    }) %>
                                    <div id="ocrAutoProcessOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes' ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ocrAutoProcessInterval" class="zr-field__name">OCR Processing Interval (Cron)</label>
                                            <input type="text" id="ocrAutoProcessInterval" name="ocrAutoProcessInterval" value="<%= config.OCR_AUTO_PROCESS_INTERVAL || '*/15 * * * *' %>" class="zr-input" placeholder="*/15 * * * *">
                                            <p class="zr-field__hint">Default: every 15 minutes · Runs are skipped while a document scan is active · Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ocrAutoProcessBatchSize" class="zr-field__name">Documents per Run</label>
                                            <input type="number" id="ocrAutoProcessBatchSize" name="ocrAutoProcessBatchSize" min="1" max="100" step="1" value="<%= config.OCR_AUTO_PROCESS_BATCH_SIZE || 10 %>" class="zr-input">
                                            <p class="zr-field__hint">Caps how many queued documents one run handles; the rest follow at the next interval (1-100) · Restart required</p>
                                        </div>
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrAutoAnalyze',
                                            label: 'AI Analysis After OCR',
                                            checked: (config.OCR_AUTO_ANALYZE || 'yes') === 'yes',
                                            hint: 'Analyse each document right after OCR. Keep this on: when Paperless-ngx rejects the content write-back the OCR text only exists locally, where a regular scan would never see it · Restart required'
                                        }) %>
                                    </div>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="ocrValidationTimeout" class="zr-field__name">OCR Timeout</label>
                                    <div class="zr-row">
                                        <input type="number" id="ocrValidationTimeout" name="ocrValidationTimeout" min="1" max="7200" step="1" value="<%= Math.round(Number(config.SETUP_OCR_VALIDATION_TIMEOUT_MS || config.SETUP_VALIDATION_TIMEOUT_MS || 30000) / 1000) %>" class="zr-input">
                                        <span class="zr-xs zr-faint" style="white-space: nowrap">seconds</span>
                                    </div>
                                    <p class="zr-field__hint">Used for OCR model loading, connection tests and document processing</p>
                                </div>
                                <div class="zr-row zr-row--wrap">
                                    <button type="button" id="testOcrBtn" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                        <span>Test OCR Connection</span>
                                    </button>
                                    <span id="ocrTestState" class="zr-badge">Not tested</span>
                                </div>
                                </div>
                                </div>
                            </section>
                        </div>

                        <div id="troubleshooting-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-caching">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Caching</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-field zr-field--stacked">
                                    <label for="tagCacheTTL" class="zr-row">
                                        Tag Cache Lifetime (Seconds)
                                        <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="tagCacheTTLHelp">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                        </button>
                                    </label>
                                    <input type="number" id="tagCacheTTL" name="tagCacheTTL" min="60" max="3600" value="<%= config.TAG_CACHE_TTL_SECONDS || 300 %>" class="zr-input" required>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                <button type="button" id="clearTagCacheBtn" class="zr-btn">
                                    <svg class="zr-icon zr-icon--sm" id="clearCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                    <span>Clear Tag Cache Now</span>
                                </button>

                                <div class="zr-col">
                                    <div class="zr-row zr-row--between">
                                        <div>
                                            <p class="zr-field__name">Thumbnail Cache</p>
                                            <p class="zr-field__hint">Local cached previews stored in <code>public/images</code>.</p>
                                        </div>
                                        <button type="button" id="refreshThumbnailCacheStatsBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            <span>Refresh</span>
                                        </button>
                                    </div>

                                    <div class="zr-formgrid">
                                        <div >
                                            <p class="zr-field__hint">Files</p>
                                            <p id="thumbnailCacheFileCount" class="zr-module__title">-</p>
                                        </div>
                                        <div >
                                            <p class="zr-field__hint">Total Size</p>
                                            <p id="thumbnailCacheTotalSize" class="zr-module__title">-</p>
                                        </div>
                                    </div>

                                    <button type="button" id="clearThumbnailCacheBtn" class="zr-btn zr-btn--danger">
                                        <svg class="zr-icon zr-icon--sm" id="clearThumbnailCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                        <span>Clear Thumbnail Cache</span>
                                    </button>
                                </div>

                                </div>
                            </section>

                            <section class="zr-module" id="sec-runtime-controls">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Runtime Controls</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-formgrid">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="globalRateLimitWindowMs" class="zr-field__name">Global rate-limit window (ms)</label>
                                        <input type="number" id="globalRateLimitWindowMs" name="globalRateLimitWindowMs" value="<%= config.GLOBAL_RATE_LIMIT_WINDOW_MS || 900000 %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="globalRateLimitMax" class="zr-field__name">Global rate-limit max requests</label>
                                        <input type="number" id="globalRateLimitMax" name="globalRateLimitMax" value="<%= config.GLOBAL_RATE_LIMIT_MAX || 1000 %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="trustProxy" class="zr-field__name">Trust Proxy</label>
                                        <input type="text" id="trustProxy" name="trustProxy" value="<%= config.TRUST_PROXY %>" class="zr-input" placeholder="false | true | 1 | loopback">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="cookieSecureMode" class="zr-field__name">Cookie Secure Mode</label>
                                        <select id="cookieSecureMode" name="cookieSecureMode" class="zr-input">
                                            <option value="auto" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'auto' ? 'selected' : '' %>>auto</option>
                                            <option value="always" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'always' ? 'selected' : '' %>>always</option>
                                            <option value="never" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'never' ? 'selected' : '' %>>never</option>
                                        </select>
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="minContentLength" class="zr-field__name">Minimum content length</label>
                                        <input type="number" id="minContentLength" name="minContentLength" value="<%= config.MIN_CONTENT_LENGTH || 10 %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessAiPort" class="zr-field__name">Zettelrobbe Port</label>
                                        <input type="number" id="paperlessAiPort" name="paperlessAiPort" value="<%= config.PAPERLESS_AI_PORT || 3000 %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="logLevel" class="zr-field__name">Log Level</label>
                                        <select id="logLevel" name="logLevel" class="zr-input">
                                            <option value="error" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'error' ? 'selected' : '' %>>error</option>
                                            <option value="warn" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'warn' ? 'selected' : '' %>>warn</option>
                                            <option value="info" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'info' ? 'selected' : '' %>>info (default)</option>
                                            <option value="debug" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'debug' ? 'selected' : '' %>>debug</option>
                                        </select>
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-history-reconciliation">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">History Reconciliation</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <p class="zr-sm zr-muted">
                                    Automatically removes stale history entries for documents that have been deleted in Paperless-ngx.
                                    Reconciliation runs on a configurable cron schedule and waits for any active scan to finish before starting.
                                </p>
                                <div class="zr-formgrid">
                                    <%- include('partials/settings-switch', {
                                        id: 'reconciliationEnabled',
                                        label: 'Automatic Reconciliation',
                                        checked: String(config.RECONCILIATION_ENABLED || 'yes').toLowerCase() === 'yes',
                                        hint: 'Restart required'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="reconciliationInterval" class="zr-field__name">Reconciliation Interval (Cron)</label>
                                        <input type="text" id="reconciliationInterval" name="reconciliationInterval" value="<%= config.RECONCILIATION_INTERVAL || '0 * * * *' %>" class="zr-input" placeholder="0 * * * *">
                                        <p class="zr-field__hint">Default: every hour · Restart required</p>
                                    </div>
                                </div>
                                <div>
                                    <button type="button" id="forceReconcileBtn" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                        <span>Force Reconciliation Now</span>
                                    </button>
                                    <div id="reconcileResult" class="hidden"></div>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-local-overrides">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Local Overrides</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-field zr-field--stacked">
                                    <p class="zr-sm zr-muted">Reset local runtime overrides to fall back to container-managed environment values after restart.</p>
                                    <button type="button" id="resetLocalOverridesBtn" data-runtime-override-keys="<%- JSON.stringify(runtimeOverrideKeys || []).replace(/</g, '\\u003c').replace(/\"/g, '&quot;') %>" data-runtime-override-details="<%- JSON.stringify(runtimeOverrideDetails || {}).replace(/</g, '\\u003c').replace(/\"/g, '&quot;') %>" data-locked-env-keys="<%- JSON.stringify(lockedEnvKeys || []).replace(/</g, '\\u003c').replace(/\"/g, '&quot;') %>" data-locked-env-details="<%- JSON.stringify(lockedEnvDetails || {}).replace(/</g, '\\u003c').replace(/\"/g, '&quot;') %>" class="zr-btn zr-btn--danger">
                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-undo"/></svg>
                                        <span>Reset Local Overrides (Password Required)</span>
                                    </button>
                                    <p class="zr-field__hint">Removes only local override data (`data/runtime-overrides.json`). Requires your current account password and an interactive user session. Restart to apply container-managed ENV values.</p>
                                </div>
                                </div>
                            </section>
                        </div>

                        <div id="env-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-env-file" data-module="env-file">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Environment file</h2>
                                </div>
                                <div class="zr-module__body zr-col">
                                    <p class="zr-sm zr-muted">
                                        The running configuration as a <code>.env</code> file — the same variables the
                                        fields on this page write, grouped by topic and limited to what is actually set.
                                        Use it to move this instance or to pin its settings into a docker compose file.
                                    </p>

                                    <div class="zr-alert zr-alert--warn">
                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                                        <div class="zr-alert__body">
                                            <p class="zr-sm">
                                                This includes API tokens and keys in clear text. <code>JWT_SECRET</code>
                                                is left out on purpose — a fresh instance generates its own.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="envFileShowBtn" class="zr-btn zr-btn--primary">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-code"/></svg>
                                            <span>Show configuration</span>
                                        </button>
                                        <button type="button" id="envFileCopyBtn" class="zr-btn hidden">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                            <span>Copy</span>
                                        </button>
                                        <span class="zr-sm zr-faint" id="envFileMeta"></span>
                                    </div>

                                    <textarea id="envFileOutput" class="zr-textarea zr-mono hidden" rows="18" readonly
                                        spellcheck="false" aria-label="Configuration as a .env file"></textarea>
                                </div>
                            </section>
                        </div>

                        <div id="changelog-tab" class="zr-col zr-col--loose">
                            <section class="zr-module__body zr-col zr-col--loose">
                                <div class="changelog-header">
                                    <div>
                                        <h3 class="zr-module__title">Release History</h3>
                                        <p class="zr-field__hint">What changed in each release, newest first. The current release is expanded.</p>
                                    </div>
                                    <a href="https://github.com/admonstrator/zettelrobbe/releases" target="_blank" rel="noopener noreferrer" class="changelog-source-link">
                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-github"/></svg>
                                        <span>Full release notes</span>
                                    </a>
                                </div>

                                <%
                                    const releaseList = Array.isArray(changelogReleases) ? changelogReleases : [];
                                    const categoryMeta = {
                                        new: { label: 'New', icon: 'i-plus' },
                                        fix: { label: 'Fix', icon: 'i-wrench' },
                                        improvement: { label: 'Improved', icon: 'i-arrow-up' },
                                        removed: { label: 'Removed', icon: 'i-minus' },
                                        security: { label: 'Security', icon: 'i-shield' },
                                        note: { label: 'Note', icon: 'i-info' }
                                    };
                                %>

                                <% if (releaseList.length === 0) { %>
                                    <p class="zr-sm zr-faint">No release history available.</p>
                                <% } else { %>
                                    <ol class="changelog-timeline">
                                        <% releaseList.forEach(function (release, releaseIndex) { %>
                                            <li class="changelog-release<%= releaseIndex === 0 ? ' changelog-release--current' : '' %>">
                                                <span class="changelog-dot" aria-hidden="true"></span>
                                                <details class="changelog-details"<%= releaseIndex === 0 ? ' open' : '' %>>
                                                    <summary class="changelog-summary">
                                                        <span class="changelog-version"><%= release.version %></span>
                                                        <% if (releaseIndex === 0) { %>
                                                            <span class="changelog-current-pill">Current</span>
                                                        <% } %>
                                                        <span class="changelog-count"><%= release.entries.length %> change<%= release.entries.length === 1 ? '' : 's' %></span>
                                                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                                    </summary>
                                                    <ul class="changelog-entries">
                                                        <% release.entries.forEach(function (entry) { %>
                                                            <%
                                                                const meta = categoryMeta[entry.category] || categoryMeta.note;
                                                            %>
                                                            <li class="changelog-entry">
                                                                <span class="changelog-badge changelog-badge--<%= entry.category %>">
                                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#<%= meta.icon %>"/></svg>
                                                                    <%= meta.label %>
                                                                </span>
                                                                <%# Entries are authored in config/changelog.js and may contain links, so they render as HTML. %>
                                                                <span class="changelog-text"><%- entry.text %></span>
                                                            </li>
                                                        <% }); %>
                                                    </ul>
                                                </details>
                                            </li>
                                        <% }); %>
                                    </ol>
                                <% } %>
                            </section>
                        </div>

                        <div class="zr-actionbar" id="settingsSaveRow" data-el="actionbar" data-dirty="false">
                            <span class="zr-actionbar__status" data-el="status">All changes saved</span>
                            <span class="zr-badge zr-badge--warn hidden" data-el="restart">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                restart required
                            </span>
                            <button type="button" class="zr-btn" data-el="reset" disabled>Discard</button>
                            <button type="submit" class="zr-btn zr-btn--primary" data-el="save">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                Save configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>

    <%- include('partials/restart-overlay') %>
    <%- include('partials/model-test-overlay') %>

    <script>
        window.__SETTINGS_BOOTSTRAP__ = {
            aiProviderPresets: <%- JSON.stringify(Array.isArray(aiProviderPresets) ? aiProviderPresets : []).replace(/</g, '\\u003c') %>
        };
    </script>
    <%- include('partials/scripts/settings-scripts') %>
    <script src="/js/settings.js?v=<%= version || 'dev' %>"></script>
    <%- include('partials/shell/body-close') %>
