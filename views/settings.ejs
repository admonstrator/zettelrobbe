<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Settings' }) %>
    <script src="/vendor/sortable/Sortable.min.js"></script>
    <script src="/js/dialogs.js"></script>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Settings',
    version: typeof version !== 'undefined' ? version : ''
}) %>
            <div class="zr-settings" data-module="settings-form">
                <aside class="zr-only-desktop">
                    <nav class="zr-sectionnav" data-module="section-nav">
                        <!-- Same order as the sections on the page, or the
                             scroll-spy highlight jumps around while scrolling. -->
                        <a href="#system-tab" aria-current="true">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-server"/></svg>
                            System
                        </a>
                        <a href="#mfa-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg>
                            Security
                        </a>
                        <a href="#ai-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-cpu"/></svg>
                            AI
                        </a>
                        <a href="#duplicates-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-merge"/></svg>
                            Duplicates
                        </a>
                        <a href="#simplify-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-split"/></svg>
                            Simplify tags
                        </a>
                        <a href="#ocr-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-scan"/></svg>
                            OCR
                        </a>
                        <a href="#troubleshooting-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wrench"/></svg>
                            Maintenance
                        </a>
                        <a href="#env-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-code"/></svg>
                            Environment
                        </a>
                        <a href="#changelog-tab">
                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-zap"/></svg>
                            Changelog
                        </a>
                    </nav>
                </aside>

                <nav class="zr-sectionnav zr-only-mobile">
                    <a href="#system-tab" aria-current="true">System</a>
                    <a href="#mfa-tab">Security</a>
                    <a href="#ai-tab">AI</a>
                    <a href="#duplicates-tab">Duplicates</a>
                    <a href="#simplify-tab">Simplify tags</a>
                    <a href="#ocr-tab">OCR</a>
                    <a href="#troubleshooting-tab">Maintenance</a>
                    <a href="#env-tab">Environment</a>
                    <a href="#changelog-tab">Changelog</a>
                </nav>

                <div class="zr-col zr-col--loose">
                    <% if (success) { %>
                        <div class="zr-alert zr-alert--ok">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                            <div class="zr-alert__body"><p><%= success %></p></div>
                        </div>
                    <% } %>
                    <% if (settingsError) { %>
                        <div class="zr-alert zr-alert--danger">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                            <div class="zr-alert__body"><p><%= settingsError %></p></div>
                        </div>
                    <% } %>

                    <div class="zr-alert zr-alert--info">
                        <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-info"/></svg>
                        <div class="zr-alert__body">
                            <p>Every field maps to a runtime environment variable, and says whether a
                            restart is required. Values injected by the container win over anything set
                            here. <a href="#env-tab" class="zr-link zr-link--underline">Environment</a>
                            shows the whole configuration as a <code>.env</code> file.</p>
                        </div>
                    </div>

                    <form id="setupForm" class="zr-col zr-col--loose">
                        <div id="system-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-connection">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Connection</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-field zr-field--stacked">
                                    <label for="paperlessUrl" class="zr-field__name">
                                        Paperless-ngx API URL
                                        <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="urlHelp">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                        </button>
                                    </label>
                                    <input type="text" id="paperlessUrl" name="paperlessUrl" value="<%= config.PAPERLESS_API_URL %>" class="zr-input" placeholder="http://your-paperless-instance:8000" required>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label class="zr-field__name">Detected Public URL</label>
                                    <!-- Same one-row value + button shape as the secret fields. -->
                                    <div class="zr-inputgroup">
                                        <div id="paperlessDetectedUrlValue" class="zr-input zr-input--static zr-grow">Loading…</div>
                                        <button type="button" id="refreshPublicUrlDetection" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>Refresh
                                        </button>
                                    </div>
                                    <p id="paperlessDetectedUrlMeta" class="zr-field__hint">Checking Paperless API for configured public URL…</p>
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label for="paperlessPublicUrl" class="zr-field__name">Paperless Public URL Override (optional)</label>
                                    <input type="text" id="paperlessPublicUrl" name="paperlessPublicUrl" value="<%= config.PAPERLESS_PUBLIC_URL || '' %>" class="zr-input" placeholder="https://paperless.example.com">
                                    <p class="zr-field__hint">Leave empty to use auto-detection/fallback</p>
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label for="paperlessToken" class="zr-field__name">API Token</label>
                                    <div class="zr-inputgroup">
                                        <input type="password" id="paperlessToken" name="paperlessToken" value="" class="zr-input" placeholder="<%= configuredSecrets.PAPERLESS_API_TOKEN ? 'Configured' : 'Enter API token' %>">
                                        <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="paperlessToken">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg>
                                        </button>
                                    </div>
                                    <p class="zr-field__hint">Restart required<%= configuredSecrets.PAPERLESS_API_TOKEN ? ' · Leave empty to keep the stored value' : '' %></p>
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label for="paperlessUsername" class="zr-field__name">Paperless-ngx Username</label>
                                    <input type="text" id="paperlessUsername" name="paperlessUsername" value="<%= config.PAPERLESS_USERNAME %>" class="zr-input" required>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-processing">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Processing</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-field zr-field--stacked">
                                    <label for="scanInterval" class="zr-field__name">Scan Interval (Cron Format)</label>
                                    <input type="text" id="scanInterval" name="scanInterval" value="<%= config.SCAN_INTERVAL %>" class="zr-input" required>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="disableAutomaticProcessing" class="zr-field__name">Disable automatic processing</label>
                                            <p class="zr-field__hint">If enabled, scans are not processed by AI automatically · Restart required</p>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="disableAutomaticProcessing" <%= config.DISABLE_AUTOMATIC_PROCESSING === 'yes' ? 'checked' : '' %>>
                                    </div>
                                </div>

                                <%- include('partials/settings-switch', {
                                    id: 'useExistingData',
                                    label: 'Use existing correspondents and tags',
                                    checked: config.USE_EXISTING_DATA === 'yes',
                                    hint: 'Restart required'
                                }) %>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-tag-filters">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Tag Filters</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <%- include('partials/settings-switch', {
                                    id: 'showTags',
                                    label: 'Process only specific pre-tagged documents',
                                    checked: config.PROCESS_PREDEFINED_DOCUMENTS === 'yes',
                                    hint: 'Restart required'
                                }) %>

                                <div id="tagsInputSection" class="<%= config.PROCESS_PREDEFINED_DOCUMENTS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                    <label for="tagInput" class="zr-field__name">Tags</label>
                                    <div class="zr-inputgroup">
                                        <input type="text" id="tagInput" class="zr-input" placeholder="Enter a tag and press Enter">
                                        <button type="button" id="tagAddButton" class="zr-btn zr-btn--primary">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                            Add
                                        </button>
                                    </div>
                                    <div id="tagsContainer" class="zr-chips">
                                        <% if (config.TAGS && Array.isArray(config.TAGS) && config.TAGS.length > 0) { %>
                                            <% config.TAGS.forEach(tag => { %>
                                                <div class="zr-chip">
                                                    <span><%= tag %></span>
                                                    <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                    <input type="hidden" id="tags" name="tags" value="<%= Array.isArray(config.TAGS) ? config.TAGS.join(',') : '' %>">
                                </div>

                                <div class="zr-field zr-field--stacked">
                                    <label for="ignoreTagInput" class="zr-field__name">Ignore Tags</label>
                                    <div class="zr-inputgroup">
                                        <input type="text" id="ignoreTagInput" class="zr-input" placeholder="Tag name, then Enter">
                                        <button type="button" id="ignoreTagAddButton" class="zr-btn zr-btn--primary">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                            Add
                                        </button>
                                    </div>
                                    <div id="ignoreTagsContainer" class="zr-chips">
                                        <% if (config.IGNORE_TAGS && Array.isArray(config.IGNORE_TAGS) && config.IGNORE_TAGS.length > 0) { %>
                                            <% config.IGNORE_TAGS.forEach(tag => { %>
                                                <div class="zr-chip">
                                                    <span><%= tag %></span>
                                                    <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
                                    <input type="hidden" id="ignoreTags" name="ignoreTags" value="<%= Array.isArray(config.IGNORE_TAGS) ? config.IGNORE_TAGS.join(',') : '' %>">
                                    <p class="zr-field__hint">Restart required</p>
                                </div>
                                </div>
                            </section>

                            <section class="zr-module" id="sec-display">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Display</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-formgrid">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="dateFormat" class="zr-field__name">Date Format</label>
                                        <select id="dateFormat" name="dateFormat" class="zr-input">
                                            <option value="DD.MM.YYYY" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? '' : 'selected' %>>DD.MM.YYYY</option>
                                            <option value="YYYY-MM-DD" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD</option>
                                        </select>
                                        <p class="zr-field__hint">Every date in the interface: 15 August 2026 reads as 15.08.2026 or 2026-08-15 · Restart required</p>
                                    </div>
                                </div>
                                </div>
                            </section>

                        </div>

                        <div id="mfa-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-api-key">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">API key</h2>
                                </div>
                                <div class="zr-module__body zr-col">
                                    <p class="zr-sm zr-muted">Used by the REST API and the Paperless-ngx post-consume script.</p>
                                    <div class="zr-inputgroup">
                                        <div id="apiKeyContainer" class="zr-input zr-mono zr-apikey" data-api-key=""
                                            title="Click to copy API key" role="button" tabindex="0">Loading…</div>
                                        <button type="button" id="regenerateBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" id="regenerateIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            <span>Regenerate</span>
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <!-- One id only: a second id attribute is dropped by the
                                 parser, and getElementById('mfaSettingsSection')
                                 returning null silently disabled the whole MFA
                                 state machine. -->
                            <section class="zr-module" id="mfaSettingsSection" data-mfa-available="<%= mfaSettings && mfaSettings.available ? 'yes' : 'no' %>" data-mfa-enabled="<%= mfaSettings && mfaSettings.enabled ? 'yes' : 'no' %>" data-mfa-username="<%= mfaSettings && mfaSettings.username ? mfaSettings.username : '' %>">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Account Security (TOTP)</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">

                                <% if (!(mfaSettings && mfaSettings.available)) { %>
                                    <div class="zr-alert zr-alert--warn">
                                        MFA controls are available only for interactive user sessions (not API key authentication).
                                    </div>
                                <% } else { %>
                                    <div class="zr-col zr-col--loose">
                                        <div class="zr-row zr-row--wrap zr-row--between">
                                            <div>
                                                <p class="zr-field__name">User: <span id="mfaSettingsUser"><%= mfaSettings.username %></span></p>
                                                <p class="zr-field__hint">Configure two-factor authentication for this account.</p>
                                            </div>
                                            <span id="mfaStatusBadge" class="zr-badge <%= mfaSettings.enabled ? 'zr-badge--ok' : '' %>">
                                                <%= mfaSettings.enabled ? 'Enabled' : 'Disabled' %>
                                            </span>
                                        </div>

                                        <div class="zr-field zr-field--stacked">
                                            <label for="mfaCurrentPassword" class="zr-field__name">Current Password</label>
                                            <input type="password" id="mfaCurrentPassword" class="zr-input" placeholder="Enter current password">
                                            <p class="zr-field__hint">Required to start activation and to disable MFA.</p>
                                        </div>

                                        <div class="zr-formgrid">
                                            <button type="button" id="mfaEnableBtn" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                                                <span>Enable MFA</span>
                                            </button>
                                            <button type="button" id="mfaDisableBtn" class="zr-btn zr-btn--danger">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg>
                                                <span>Disable MFA</span>
                                            </button>
                                        </div>

                                        <div id="mfaProvisioningBox" class="zr-col hidden">
                                            <div class="zr-row">
                                                <img id="mfaQrImage" class="hidden no-invert" alt="MFA provisioning QR code" />
                                            </div>
                                            <div class="zr-col zr-col--tight">
                                                <label for="mfaSecretKey" class="zr-field__name">Secret Key</label>
                                                <input type="text" id="mfaSecretKey" class="zr-input" readonly>
                                            </div>
                                            <div class="zr-col zr-col--tight">
                                                <label for="mfaOtpAuthUri" class="zr-field__name">OTP URI</label>
                                                <textarea id="mfaOtpAuthUri" rows="3" class="zr-textarea" readonly></textarea>
                                            </div>
                                            <div class="zr-inputgroup">
                                                <button type="button" id="mfaCopySecretBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                    <span>Copy Secret</span>
                                                </button>
                                                <button type="button" id="mfaDownloadQrBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-download"/></svg>
                                                    <span>Download QR</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Use either the key or URI in your authenticator app, then enter a code below.</p>
                                        </div>

                                        <div class="zr-field zr-field--stacked" id="mfaTokenField">
                                            <label for="mfaToken" class="zr-field__name">Authenticator Code</label>
                                            <div class="zr-inputgroup">
                                                <input type="text" id="mfaToken" inputmode="numeric" autocomplete="one-time-code" class="zr-input" placeholder="Enter 6-digit code">
                                                <button type="button" id="mfaVerifyBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                                    <span id="mfaVerifyBtnLabel">Validate & Activate</span>
                                                </button>
                                            </div>
                                            <p id="mfaTokenHint" class="hidden"></p>
                                        </div>

                                        <div id="mfaResultMessage" class="hidden"></div>
                                    </div>
                                <% } %>
                                </div>
                            </section>
                        </div>

                        <div id="ai-tab" class="zr-col zr-col--loose">
                            <section class="zr-module" id="sec-quickstart-auto-detect">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Quickstart auto-detect</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <p class="zr-field__hint">Point at a local AI server (LM Studio, Ollama, or any OpenAI-compatible endpoint). Detection lists the running models and classifies them for AI analysis and OCR. These two fields drive the detection run only &mdash; what gets saved is what you apply to the AI and OCR settings below.</p>
<%
/* Only the provider actually in use may prefill this field. config.OLLAMA_API_URL
   carries a default of http://localhost:11434 and is therefore never empty, so
   "whichever is set" would hand every OpenAI or Azure install a localhost URL it
   never configured. The stored key follows the same provider, and the route
   below only substitutes it when the detection targets that same server. */
const quickstartProvider = String(config.AI_PROVIDER || '').toLowerCase();
const quickstartUrl =
    quickstartProvider === 'ollama' ? (config.OLLAMA_API_URL || '')
    : quickstartProvider === 'custom' ? (config.CUSTOM_BASE_URL || '')
    : '';
const quickstartKeyStored =
    quickstartProvider === 'ollama' ? Boolean(configuredSecrets.OLLAMA_API_KEY)
    : quickstartProvider === 'custom' ? Boolean(configuredSecrets.CUSTOM_API_KEY)
    : false;
-%>
                                <div class="zr-field zr-field--stacked">
                                    <label for="settingsQuickstartUrl" class="zr-field__name">AI server URL</label>
                                    <input type="text" id="settingsQuickstartUrl" class="zr-input" value="<%= quickstartUrl %>" placeholder="http://192.168.1.5:1234">
                                    <% if (quickstartUrl) { %>
                                        <p class="zr-field__hint">Prefilled from the configured AI server</p>
                                    <% } %>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="settingsQuickstartApiKey" class="zr-field__name">API key (optional)</label>
                                    <input type="password" id="settingsQuickstartApiKey" class="zr-input" placeholder="<%= quickstartKeyStored ? 'Configured' : 'Optional' %>">
                                    <% if (quickstartKeyStored) { %>
                                        <p class="zr-field__hint">Leave empty to use the stored key for this server</p>
                                    <% } %>
                                </div>
                                <div class="zr-row zr-row--wrap">
                                    <button type="button" id="settingsQuickstartDetectBtn" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                        <span>Detect models</span>
                                    </button>
                                    <span id="settingsQuickstartState" class="zr-field__hint">Not detected</span>
                                </div>
                                <div id="settingsQuickstartResults" class="zr-col zr-col--loose hidden">
                                    <p id="settingsQuickstartHint" class="zr-field__hint"></p>
                                    <div class="zr-formgrid">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="settingsQuickstartAiModel" class="zr-field__name">Suggested AI model</label>
                                            <select id="settingsQuickstartAiModel" class="zr-input"></select>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="settingsQuickstartOcrModel" class="zr-field__name">OCR model</label>
                                            <select id="settingsQuickstartOcrModel" class="zr-input"></select>
                                        </div>
                                    </div>
                                    <div class="zr-row">
                                        <input type="checkbox" class="zr-toggle" id="settingsQuickstartEnableOcr">
                                        <label for="settingsQuickstartEnableOcr" class="zr-field__name">Use this service for OCR</label>
                                    </div>
                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="settingsQuickstartApplyBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                            <span>Apply to fields</span>
                                        </button>
                                        <button type="button" id="settingsQuickstartSaveBtn" class="zr-btn zr-btn--primary">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                            <span>Test models &amp; save</span>
                                        </button>
                                        <span id="settingsQuickstartApplyHint" class="zr-field__hint"></span>
                                    </div>
                                </div>
                                </div>
                            </section>
                            <section class="zr-module" id="sec-provider">
                                <div class="zr-module__head">
                                    <h2 class="zr-module__title">Provider</h2>
                                </div>
                                <div class="zr-module__body zr-col zr-col--loose">
                                <div class="zr-field zr-field--stacked">
                                    <label for="aiPreset" class="zr-field__name">Provider preset</label>
                                    <select id="aiPreset" class="zr-input"></select>
                                    <p id="aiPresetHint" class="zr-field__hint">Manual mode: choose provider and enter values yourself.</p>
                                </div>
                                <div class="zr-field zr-field--stacked">
                                    <label for="aiProvider" class="zr-field__name">AI Provider</label>
                                    <select id="aiProvider" name="aiProvider" class="zr-input">
                                        <option value="openai" <%= config.AI_PROVIDER === 'openai' ? 'selected' : '' %>>OpenAI (ChatGPT)</option>
                                        <option value="ollama" <%= config.AI_PROVIDER === 'ollama' ? 'selected' : '' %>>Ollama (Local LLM)</option>
                                        <option value="custom" <%= config.AI_PROVIDER === 'custom' ? 'selected' : '' %>>Custom</option>
                                        <option value="azure" <%= config.AI_PROVIDER === 'azure' ? 'selected' : '' %>>Azure</option>
                                    </select>
                                    <p class="zr-field__hint">Restart required</p>
                                </div>

                                <div id="openaiSettings" class="zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="openaiKey" class="zr-field__name">OpenAI API Key</label>
