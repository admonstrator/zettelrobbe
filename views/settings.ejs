<!DOCTYPE html>
<html lang="en" data-theme="<%= theme || 'light' %>">
<%- include('partials/shell/head-start', { pageTitle: 'Settings' }) %>
    <script src="/vendor/sortable/Sortable.min.js"></script>
    <script src="/js/dialogs.js"></script>
<%- include('partials/shell/head-end') %>
<%- include('partials/shell/body-open', {
    pageTitle: 'Settings',
    version: typeof version !== 'undefined' ? version : ''
}) %>
<%
    // The Claude models and effort levels come from services/anthropicSupport.js
    // through the route; a render without them still produces a usable page.
    const anthropic = (typeof anthropicOptions !== 'undefined' && anthropicOptions) || {};
    const anthropicSuggestedModels = Array.isArray(anthropic.suggestedModels) ? anthropic.suggestedModels : [];
    const anthropicEffortLevels = Array.isArray(anthropic.effortLevels) ? anthropic.effortLevels : [];
    const anthropicEffortLabels = { low: 'Low', medium: 'Medium', high: 'High', xhigh: 'Extra high', max: 'Max' };
    const anthropicSelected = config.AI_PROVIDER === 'anthropic';
    const anthropicSwitchOn = (value) => ['yes', 'true', '1'].includes(String(value || 'yes').trim().toLowerCase());
    // A stored OCR key belongs to the OCR provider it was saved for; the save
    // route clears it when the provider crosses to or from Claude.
    const ocrStoredForAnthropic = (config.OCR_PROVIDER || 'mistral') === 'anthropic';
    const ocrKeyConfiguredDefault = ocrStoredForAnthropic ? configuredSecrets.MISTRAL_API_KEY : (configuredSecrets.OCR_API_KEY || configuredSecrets.MISTRAL_API_KEY);
    const ocrKeyConfiguredAnthropic = ocrStoredForAnthropic && configuredSecrets.OCR_API_KEY;

    // One topic per view. The ids are the URL hashes (#sso, #ai-provider), and
    // public/js/modules/settings-nav.js maps the hashes the page used before the
    // regrouping (#ai-tab, #sec-provider, ...) onto these. Every entry stays in
    // the one form: switching only toggles .hidden, so saving still sends all.
    const settingsGroups = [
        { label: 'Basics', icon: 'i-home', entries: [
            { id: 'connection', title: 'Paperless-ngx connection' },
            { id: 'display', title: 'Display' }
        ] },
        { label: 'Document analysis', icon: 'i-cpu', entries: [
            { id: 'ai-provider', title: 'AI provider' },
            { id: 'ai-behavior', title: 'What the AI fills in' },
            { id: 'restrictions', title: 'Restrictions and limits' },
            { id: 'custom-fields', title: 'Custom fields' },
            { id: 'external-data', title: 'External data' },
            { id: 'ocr', title: 'OCR fallback' }
        ] },
        { label: 'Processing', icon: 'i-clock', entries: [
            { id: 'schedule', title: 'Schedule and tag filters' },
            { id: 'skip-rules', title: 'Skip rules', badge: 'New' },
            { id: 'runtime', title: 'Runtime controls' }
        ] },
        { label: 'Tag tools', icon: 'i-tag', entries: [
            { id: 'duplicates', title: 'Duplicates' },
            { id: 'simplify', title: 'Simplify tags' }
        ] },
        { label: 'Sign-in and security', icon: 'i-shield', entries: [
            { id: 'account', title: 'Account and two-factor' },
            { id: 'sso', title: 'Single sign-on', badge: 'New' },
            { id: 'api-key', title: 'API key' }
        ] },
        { label: 'System', icon: 'i-server', entries: [
            { id: 'caching', title: 'Caching and history' },
            { id: 'quickstart', title: 'Quickstart auto-detect' },
            { id: 'environment', title: 'Export' },
            { id: 'changelog', title: 'Changelog' }
        ] }
    ];
    const settingsFirstEntry = settingsGroups[0].entries[0].id;
    const settingsEsc = (value) => String(value == null ? '' : value)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

    // Single sign-on: the status of the running configuration and the callback
    // URL derived from this request. Both come from the route; a render without
    // them still produces a usable page.
    const oidcSwitchOn = (value, fallback) => ['yes', 'true', '1'].includes(String(value || fallback).trim().toLowerCase());
    const oidcRedirectDetected = (typeof oidcDetectedRedirectUri === 'string' && oidcDetectedRedirectUri) ? oidcDetectedRedirectUri : '';
    const oidcState = (typeof oidcStatus === 'object' && oidcStatus) ? oidcStatus : { enabled: oidcSwitchOn(config.OIDC_ENABLED, 'no'), errors: [] };
    const oidcErrors = Array.isArray(oidcState.errors) ? oidcState.errors.map(String).filter(Boolean) : [];
    const oidcPill = !oidcState.enabled
        ? { tone: '', text: 'Off' }
        : oidcErrors.length
            ? { tone: 'zr-badge--warn', text: 'On, but incomplete: ' + oidcErrors.join(' ') }
            : { tone: 'zr-badge--ok', text: 'On' };

    const entryOpen = (id) => {
        const group = settingsGroups.find((g) => g.entries.some((e) => e.id === id));
        const entry = group.entries.find((e) => e.id === id);
        const pill = id === 'sso'
            ? `<span class="zr-badge ${oidcPill.tone} zr-settings-entry__status" id="oidcStatusPill" title="Status of the running configuration">${settingsEsc(oidcPill.text)}</span>`
            : '';
        return `<section class="zr-settings-entry zr-col zr-col--loose${id === settingsFirstEntry ? '' : ' hidden'}" id="entry-${id}" data-entry="${id}" data-group="${settingsEsc(group.label)}" data-title="${settingsEsc(entry.title)}" aria-labelledby="entry-${id}-title">
                            <header class="zr-settings-entry__head">
                                <p class="zr-label">${settingsEsc(group.label)}</p>
                                <div class="zr-settings-entry__titlerow">
                                    <h2 class="zr-settings-entry__title" id="entry-${id}-title">${settingsEsc(entry.title)}</h2>
                                    ${pill}
                                </div>
                            </header>`;
    };
    const entryClose = () => '</section>';
%>
            <div class="zr-settings-page" data-module="settings-nav">
                <div class="zr-viewhead zr-settings-search">
                    <div class="zr-settings-search__box" role="search">
                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                        <input type="search" class="zr-input" data-el="search" id="settingsSearch"
                            placeholder="Search settings (e.g. scan interval, OCR model)"
                            aria-label="Search settings" aria-controls="settingsSearchResults"
                            aria-expanded="false" autocomplete="off" spellcheck="false">
                        <div class="zr-settings-search__results hidden" id="settingsSearchResults" data-el="results" role="listbox" aria-label="Matching settings"></div>
                    </div>
                </div>

                <div class="zr-settings" data-module="settings-form">
                    <aside class="zr-only-desktop">
                        <nav class="zr-sectionnav zr-settings-nav" aria-label="Settings topics" data-el="nav">
                            <% settingsGroups.forEach((group) => { %>
                            <div class="zr-settings-nav__group" data-group="<%= group.label %>">
                                <p class="zr-settings-nav__label">
                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#<%= group.icon %>"/></svg>
                                    <%= group.label %>
                                </p>
                                <% group.entries.forEach((entry) => { %>
                                <a href="#<%= entry.id %>" data-entry-link="<%= entry.id %>" aria-current="<%= entry.id === settingsFirstEntry ? 'page' : 'false' %>">
                                    <span class="zr-grow"><%= entry.title %></span>
                                    <% if (entry.badge) { %><span class="zr-badge zr-badge--brand"><%= entry.badge %></span><% } %>
                                    <span class="zr-settings-nav__dirty hidden" data-entry-dirty="<%= entry.id %>" title="Unsaved changes"></span>
                                </a>
                                <% }) %>
                            </div>
                            <% }) %>
                        </nav>
                    </aside>

                    <div class="zr-only-mobile zr-settings-picker">
                        <label for="settingsEntrySelect" class="zr-sr">Settings topic</label>
                        <select id="settingsEntrySelect" class="zr-input" data-el="select">
                            <% settingsGroups.forEach((group) => { %>
                            <% group.entries.forEach((entry) => { %>
                            <option value="<%= entry.id %>" <%= entry.id === settingsFirstEntry ? 'selected' : '' %>><%= group.label %> › <%= entry.title %><%= entry.badge ? ' (' + entry.badge + ')' : '' %></option>
                            <% }) %>
                            <% }) %>
                        </select>
                    </div>

                    <div class="zr-col zr-col--loose zr-settings__main">
                    <% if (success) { %>
                        <div class="zr-alert zr-alert--ok">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-check-circle"/></svg>
                            <div class="zr-alert__body"><p><%= success %></p></div>
                        </div>
                    <% } %>
                    <% if (settingsError) { %>
                        <div class="zr-alert zr-alert--danger">
                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                            <div class="zr-alert__body"><p><%= settingsError %></p></div>
                        </div>
                    <% } %>

                    <form id="setupForm" class="zr-col zr-col--loose"
                        data-locked-env-keys="<%= JSON.stringify(typeof lockedEnvKeys !== 'undefined' && Array.isArray(lockedEnvKeys) ? lockedEnvKeys : []) %>"
                        data-restart-keys="<%= JSON.stringify(typeof restartRequiredKeys !== 'undefined' && Array.isArray(restartRequiredKeys) ? restartRequiredKeys : []) %>"
                        data-boot-id="<%= typeof bootId === 'string' ? bootId : '' %>">
                        <%- entryOpen('connection') %>
                                <section class="zr-module" id="sec-connection">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Connection</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessUrl" class="zr-field__name">
                                            Paperless-ngx API URL
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="urlHelp">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                            </button>
                                        </label>
                                        <input type="text" id="paperlessUrl" name="paperlessUrl" value="<%= config.PAPERLESS_API_URL %>" class="zr-input" placeholder="http://your-paperless-instance:8000" required>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label class="zr-field__name">Detected Public URL</label>
                                        <!-- Same one-row value + button shape as the secret fields. -->
                                        <div class="zr-inputgroup">
                                            <div id="paperlessDetectedUrlValue" class="zr-input zr-input--static zr-grow">Loading…</div>
                                            <button type="button" id="refreshPublicUrlDetection" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>Refresh
                                            </button>
                                        </div>
                                        <p id="paperlessDetectedUrlMeta" class="zr-field__hint">Checking Paperless API for configured public URL…</p>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessPublicUrl" class="zr-field__name">Paperless public URL (optional)</label>
                                        <input type="text" id="paperlessPublicUrl" name="paperlessPublicUrl" value="<%= config.PAPERLESS_PUBLIC_URL || '' %>" class="zr-input" placeholder="https://paperless.example.com">
                                        <p class="zr-field__hint">Leave empty to use auto-detection/fallback</p>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessToken" class="zr-field__name">API Token</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="paperlessToken" name="paperlessToken" value="" class="zr-input" placeholder="<%= configuredSecrets.PAPERLESS_API_TOKEN ? 'Configured' : 'Enter API token' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="paperlessToken">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg>
                                            </button>
                                        </div>
                                        <% if (configuredSecrets.PAPERLESS_API_TOKEN) { %>
                                        <p class="zr-field__hint">Leave empty to keep the stored value</p>
                                        <% } %>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="paperlessUsername" class="zr-field__name">Paperless-ngx Username</label>
                                        <input type="text" id="paperlessUsername" name="paperlessUsername" value="<%= config.PAPERLESS_USERNAME %>" class="zr-input" required>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('display') %>
                                <section class="zr-module" id="sec-display">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Display</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-formgrid">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="dateFormat" class="zr-field__name">Date Format</label>
                                            <select id="dateFormat" name="dateFormat" class="zr-input">
                                                <option value="DD.MM.YYYY" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? '' : 'selected' %>>DD.MM.YYYY</option>
                                                <option value="YYYY-MM-DD" <%= String(config.DATE_FORMAT || 'DD.MM.YYYY').toUpperCase() === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD</option>
                                            </select>
                                            <p class="zr-field__hint">Every date in the interface: 15 August 2026 reads as 15.08.2026 or 2026-08-15</p>
                                        </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('ai-provider') %>
                                <section class="zr-module" id="sec-provider">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Provider</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="aiPreset" class="zr-field__name">Provider preset</label>
                                        <select id="aiPreset" class="zr-input"></select>
                                        <p id="aiPresetHint" class="zr-field__hint">Manual mode: choose provider and enter values yourself.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="aiProvider" class="zr-field__name">AI Provider</label>
                                        <select id="aiProvider" name="aiProvider" class="zr-input">
                                            <option value="openai" <%= config.AI_PROVIDER === 'openai' ? 'selected' : '' %>>OpenAI (ChatGPT)</option>
                                            <option value="ollama" <%= config.AI_PROVIDER === 'ollama' ? 'selected' : '' %>>Ollama (Local LLM)</option>
                                            <option value="custom" <%= config.AI_PROVIDER === 'custom' ? 'selected' : '' %>>Custom</option>
                                            <option value="azure" <%= config.AI_PROVIDER === 'azure' ? 'selected' : '' %>>Azure</option>
                                            <option value="anthropic" <%= anthropicSelected ? 'selected' : '' %>>Anthropic (Claude)</option>
                                        </select>
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
    
                                    <div id="openaiSettings" class="zr-col zr-col--loose">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="openaiKey" class="zr-field__name">OpenAI API Key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="openaiKey" name="openaiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.OPENAI_API_KEY ? 'Configured' : 'Enter OpenAI API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="openaiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint">Restart required<%= configuredSecrets.OPENAI_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="openaiModel" class="zr-field__name">OpenAI Model</label>
                                            <select id="openaiModel" name="openaiModel" class="zr-input">
                                                <option value="gpt-3.5-turbo-0125" <%= config.OPENAI_MODEL === 'gpt-3.5-turbo-0125' ? 'selected' : '' %>>GPT-3.5 Turbo</option>
                                                <option value="gpt-4o" <%= config.OPENAI_MODEL === 'gpt-4o' ? 'selected' : '' %>>GPT-4o</option>
                                                <option value="o3-mini" <%= config.OPENAI_MODEL === 'o3-mini' ? 'selected' : '' %>>o3-mini</option>
                                                <option value="gpt-4o-mini" <%= config.OPENAI_MODEL === 'gpt-4o-mini' ? 'selected' : '' %>>GPT-4o-mini</option>
                                            </select>
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                    </div>
    
                                    <div id="ollamaSettings" class="zr-col zr-col--loose hidden">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ollamaUrl" class="zr-field__name">Ollama API URL</label>
                                            <input type="text" id="ollamaUrl" name="ollamaUrl" value="<%= config.OLLAMA_API_URL %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ollamaApiKey" class="zr-field__name">Ollama API Key (optional)</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="ollamaApiKey" name="ollamaApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.OLLAMA_API_KEY ? 'Configured' : 'Optional' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="ollamaApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint">Restart required · Only needed if your endpoint requires a token<%= configuredSecrets.OLLAMA_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="ollamaModel" class="zr-field__name">Ollama Model</label>
                                            <div class="zr-inputgroup">
                                                <select id="ollamaModel" name="ollamaModel" class="zr-input">
                                                    <option value="<%= config.OLLAMA_MODEL %>" selected><%= config.OLLAMA_MODEL %></option>
                                                </select>
                                                <button type="button" id="fetchAiModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch Models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                    </div>
    
                                    <div id="customSettings" class="zr-col zr-col--loose hidden">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customBaseUrl" class="zr-field__name">Custom Base URL</label>
                                            <input type="text" id="customBaseUrl" name="customBaseUrl" value="<%= config.CUSTOM_BASE_URL %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customApiKey" class="zr-field__name">Custom API Key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="customApiKey" name="customApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.CUSTOM_API_KEY ? 'Configured' : 'Enter Custom API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="customApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint">Restart required<%= configuredSecrets.CUSTOM_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="customModel" class="zr-field__name">Custom Model</label>
                                            <div class="zr-inputgroup">
                                                <select id="customModel" name="customModel" class="zr-input">
                                                    <option value="<%= config.CUSTOM_MODEL %>" selected><%= config.CUSTOM_MODEL %></option>
                                                </select>
                                                <button type="button" id="fetchCustomAiModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch Models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                    </div>
    
                                    <div id="azureSettings" class="zr-col zr-col--loose hidden">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureEndpoint" class="zr-field__name">Azure Endpoint</label>
                                            <input type="text" id="azureEndpoint" name="azureEndpoint" value="<%= config.AZURE_ENDPOINT %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureApiKey" class="zr-field__name">Azure API Key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="azureApiKey" name="azureApiKey" value="" class="zr-input" placeholder="<%= configuredSecrets.AZURE_API_KEY ? 'Configured' : 'Enter Azure API key' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="azureApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint">Restart required<%= configuredSecrets.AZURE_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureDeploymentName" class="zr-field__name">Deployment</label>
                                            <input type="text" id="azureDeploymentName" name="azureDeploymentName" value="<%= config.AZURE_DEPLOYMENT_NAME %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="azureApiVersion" class="zr-field__name">API Version</label>
                                            <input type="text" id="azureApiVersion" name="azureApiVersion" value="<%= config.AZURE_API_VERSION %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                    </div>
    
                                    <div id="anthropicSettings" class="zr-col zr-col--loose <%= anthropicSelected ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="anthropicApiKey" class="zr-field__name">Anthropic API Key</label>
                                            <div class="zr-inputgroup">
                                                <input type="password" id="anthropicApiKey" name="anthropicApiKey" value="" class="zr-input" autocomplete="off" placeholder="<%= configuredSecrets.ANTHROPIC_API_KEY ? 'Configured' : 'sk-ant-...' %>">
                                                <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="anthropicApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                            </div>
                                            <p class="zr-field__hint">Restart required<%= configuredSecrets.ANTHROPIC_API_KEY ? ' · Leave empty to keep the stored value' : '' %></p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="anthropicModel" class="zr-field__name">Claude Model</label>
                                            <div class="zr-inputgroup">
                                                <%
                                                    const anthropicCurrentModel = config.ANTHROPIC_MODEL || anthropic.defaultModel || '';
                                                    const anthropicModelIds = anthropicSuggestedModels.map((model) => model.id);
                                                    if (anthropicCurrentModel && !anthropicModelIds.includes(anthropicCurrentModel)) anthropicModelIds.push(anthropicCurrentModel);
                                                %>
                                                <select id="anthropicModel" name="anthropicModel" class="zr-input">
                                                    <% anthropicModelIds.forEach((id) => { %>
                                                    <option value="<%= id %>" <%= id === anthropicCurrentModel ? 'selected' : '' %>><%= id %></option>
                                                    <% }) %>
                                                </select>
                                                <button type="button" id="fetchAnthropicModelsBtn" class="zr-btn">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                    <span>Fetch Models</span>
                                                </button>
                                            </div>
                                            <p class="zr-field__hint">Restart required · Fetch Models lists every model the API key can use</p>
                                        </div>
                                        <div class="zr-formgrid">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="anthropicEffort" class="zr-field__name">Effort</label>
                                                <select id="anthropicEffort" name="anthropicEffort" class="zr-input">
                                                    <option value="" <%= config.ANTHROPIC_EFFORT ? '' : 'selected' %>>Model default</option>
                                                    <% anthropicEffortLevels.forEach((level) => { %>
                                                    <option value="<%= level %>" <%= config.ANTHROPIC_EFFORT === level ? 'selected' : '' %>><%= anthropicEffortLabels[level] || level %></option>
                                                    <% }) %>
                                                </select>
                                                <p class="zr-field__hint">Higher levels think longer and spend more tokens · Restart required</p>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="anthropicMaxTokens" class="zr-field__name">Max Tokens</label>
                                                <input type="number" id="anthropicMaxTokens" name="anthropicMaxTokens" value="<%= config.ANTHROPIC_MAX_TOKENS || anthropic.defaultMaxTokens || '' %>" min="1" step="1" class="zr-input">
                                                <p class="zr-field__hint">Cap per request; thinking counts toward it · Restart required</p>
                                            </div>
                                        </div>
                                        <%- include('partials/settings-switch', {
                                            id: 'anthropicStructuredOutput',
                                            label: 'Structured output',
                                            checked: anthropicSwitchOn(config.ANTHROPIC_STRUCTURED_OUTPUT),
                                            hint: 'Constrain the analysis answer to a JSON schema · Restart required'
                                        }) %>
                                        <%- include('partials/settings-switch', {
                                            id: 'anthropicPromptCaching',
                                            label: 'Prompt caching',
                                            checked: anthropicSwitchOn(config.ANTHROPIC_PROMPT_CACHING),
                                            hint: 'Cache the system prompt, which repeats for every document of a scan · Restart required'
                                        }) %>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="anthropicApiUrl" class="zr-field__name">API URL (optional)</label>
                                            <input type="text" id="anthropicApiUrl" name="anthropicApiUrl" value="<%= config.ANTHROPIC_API_URL || '' %>" class="zr-input" placeholder="https://api.anthropic.com" autocomplete="off" spellcheck="false">
                                            <p class="zr-field__hint">Only for a proxy; leave empty for api.anthropic.com · Restart required</p>
                                        </div>
                                    </div>
    
                                    <h4 class="zr-label">Model Parameters</h4>
                                    <div class="zr-formgrid">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="tokenLimit" class="zr-field__name">Token Limit</label>
                                            <input type="number" id="tokenLimit" name="tokenLimit" value="<%= config.TOKEN_LIMIT %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="responseTokens" class="zr-field__name">Response Tokens</label>
                                            <input type="number" id="responseTokens" name="responseTokens" value="<%= config.RESPONSE_TOKENS %>" class="zr-input">
                                            <p class="zr-field__hint">Restart required</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="aiTemperatureAnalysis" class="zr-field__name">Analysis Temperature</label>
                                            <input type="number" id="aiTemperatureAnalysis" name="aiTemperatureAnalysis" value="<%= config.AI_TEMPERATURE_ANALYSIS || '0.3' %>" min="0" max="2" step="0.1" class="zr-input">
                                            <p class="zr-field__hint">Range: 0.0-2.0 · Restart required</p>
                                            <p class="zr-field__hint <%= anthropicSelected ? '' : 'hidden' %>" data-anthropic-hint>Claude models ignore the temperature</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="aiTemperatureGeneration" class="zr-field__name">Generation Temperature</label>
                                            <input type="number" id="aiTemperatureGeneration" name="aiTemperatureGeneration" value="<%= config.AI_TEMPERATURE_GENERATION || '0.7' %>" min="0" max="2" step="0.1" class="zr-input">
                                            <p class="zr-field__hint">Range: 0.0-2.0 · Restart required</p>
                                            <p class="zr-field__hint <%= anthropicSelected ? '' : 'hidden' %>" data-anthropic-hint>Claude models ignore the temperature</p>
                                        </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('ai-behavior') %>
                                <section class="zr-module" id="sec-ai-behavior">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">AI Behavior</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'aiProcessedTag',
                                        label: 'Add AI-processed tag to documents',
                                        checked: config.ADD_AI_PROCESSED_TAG === 'yes',
                                        hint: 'Restart required'
                                    }) %>
                                    <div id="aiTagNameSection" class="<%= config.ADD_AI_PROCESSED_TAG === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="aiTagName" class="zr-field__name">AI-processed Tag Name</label>
                                        <input type="text" id="aiTagName" name="aiTagName" value="<%= config.AI_PROCESSED_TAG_NAME || 'ai-processed' %>" class="zr-input">
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
    
                                    <%- include('partials/settings-switch', {
                                        id: 'usePromptTags',
                                        label: 'Use specific tags in prompt',
                                        checked: config.USE_PROMPT_TAGS === 'yes',
                                        hint: 'Restart required'
                                    }) %>
    
                                    <div id="promptTagsSection" class="<%= config.USE_PROMPT_TAGS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="promptTagInput" class="zr-field__name">Prompt Tags</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" id="promptTagInput" class="zr-input" placeholder="Enter a tag and press Enter">
                                            <button type="button" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                                Add
                                            </button>
                                        </div>
                                        <div id="promptTagsContainer" class="zr-chips">
                                            <% if (config.PROMPT_TAGS && Array.isArray(config.PROMPT_TAGS) && config.PROMPT_TAGS.length > 0) { %>
                                                <% config.PROMPT_TAGS.forEach(tag => { %>
                                                    <div class="zr-chip">
                                                        <span><%= tag %></span>
                                                        <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                        <input type="hidden" id="promptTags" name="promptTags" value="<%= Array.isArray(config.PROMPT_TAGS) ? config.PROMPT_TAGS.join(',') : '' %>">
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="systemPrompt" class="zr-field__name">Prompt Description</label>
                                        <textarea id="systemPrompt" name="systemPrompt" rows="8" class="zr-textarea" placeholder="Describe how the AI should analyze your documents..."><%= config.SYSTEM_PROMPT %></textarea>
                                        <button id="systemPromptBtn" type="button" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-bulb"/></svg>
                                            Example
                                        </button>
                                        <p class="zr-field__hint">Restart required</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('restrictions') %>
                                <section class="zr-module" id="sec-restrictions">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Restrictions</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-formgrid">
                                        <label for="restrictToExistingTags" class="zr-checktile">
                                            <input type="checkbox" id="restrictToExistingTags" name="restrictToExistingTags" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_TAGS === 'yes' ? 'checked' : '' %>>
                                            <span>Restrict to Existing Tags</span>
                                        </label>
                                        <label for="restrictToExistingCorrespondents" class="zr-checktile">
                                            <input type="checkbox" id="restrictToExistingCorrespondents" name="restrictToExistingCorrespondents" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_CORRESPONDENTS === 'yes' ? 'checked' : '' %>>
                                            <span>Restrict to Existing Correspondents</span>
                                        </label>
                                        <label for="restrictToExistingDocumentTypes" class="zr-checktile">
                                            <input type="checkbox" id="restrictToExistingDocumentTypes" name="restrictToExistingDocumentTypes" class="zr-toggle" <%= config.RESTRICT_TO_EXISTING_DOCUMENT_TYPES === 'yes' ? 'checked' : '' %>>
                                            <span>Restrict to Existing Document Types</span>
                                        </label>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-module" id="sec-ai-function-limits">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">AI Function Limits</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-formgrid">
                                        <label for="activateTagging" class="zr-checktile"><input type="checkbox" id="activateTagging" name="activateTagging" class="zr-toggle" <%= config.ACTIVATE_TAGGING === 'yes' ? 'checked' : '' %>><span>Tags Assignment</span></label>
                                        <label for="activateCorrespondents" class="zr-checktile"><input type="checkbox" id="activateCorrespondents" name="activateCorrespondents" class="zr-toggle" <%= config.ACTIVATE_CORRESPONDENTS === 'yes' ? 'checked' : '' %>><span>Correspondent Detection</span></label>
                                        <label for="activateDocumentType" class="zr-checktile"><input type="checkbox" id="activateDocumentType" name="activateDocumentType" class="zr-toggle" <%= config.ACTIVATE_DOCUMENT_TYPE === 'yes' ? 'checked' : '' %>><span>Document Type Classification</span></label>
                                        <label for="activateTitle" class="zr-checktile"><input type="checkbox" id="activateTitle" name="activateTitle" class="zr-toggle" <%= config.ACTIVATE_TITLE === 'yes' ? 'checked' : '' %>><span>Title Generation</span></label>
                                        <label for="activateCustomFields" class="zr-checktile"><input type="checkbox" id="activateCustomFields" name="activateCustomFields" class="zr-toggle" <%= config.ACTIVATE_CUSTOM_FIELDS === 'yes' ? 'checked' : '' %>><span>Custom Fields</span></label>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('custom-fields') %>
                                <section class="zr-module" id="sec-custom-fields">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Custom Fields</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div id="customFieldsList" class="zr-field zr-field--stacked">
                                        <% let _parsedCustomFields = []; try { const _cf = JSON.parse(config.CUSTOM_FIELDS || '{}'); if (Array.isArray(_cf.custom_fields)) _parsedCustomFields = _cf.custom_fields; } catch(e) {} %>
                                        <% if (_parsedCustomFields.length > 0) { %>
                                            <% _parsedCustomFields.forEach((field) => { %>
                                                <div class="custom-field-item zr-row">
                                                    <div class="zr-faint" style="cursor: move"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-grip"/></svg></div>
                                                    <div class="zr-grow">
                                                        <p class="zr-strong" data-field-name><%= field.value %></p>
                                                        <p class="zr-sm zr-faint" data-field-type>Type: <%= field.data_type %> <%= field.data_type === 'monetary' && field.currency ? `(${field.currency})` : '' %></p>
                                                    </div>
                                                    <button type="button" onclick="removeCustomField(this)" class="zr-btn zr-btn--ghost zr-btn--icon zr-btn--danger"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg></button>
                                                </div>
                                            <% }); %>
                                        <% } %>
                                    </div>
    
                                    <div class="zr-row zr-row--wrap customfield-add">
                                        <div class="zr-grow"><input type="text" id="newFieldName" class="zr-input" placeholder="Enter field name..."></div>
                                        <div>
                                            <select id="newFieldType" onchange="toggleCurrencySelect()" class="zr-input">
                                                <option value="string">Text (up to 128 characters)</option>
                                                <option value="longtext">Long text</option>
                                                <option value="float">Number</option>
                                                <option value="integer">Integer</option>
                                                <option value="monetary">Currency</option>
                                                <option value="date">Date</option>
                                                <option value="boolean">Boolean</option>
                                            </select>
                                        </div>
                                        <div>
                                            <select id="currencyCode" class="zr-select hidden">
                                                <option value="EUR">EUR</option>
                                                <option value="USD">USD</option>
                                                <option value="GBP">GBP</option>
                                                <option value="JPY">JPY</option>
                                                <option value="CHF">CHF</option>
                                            </select>
                                        </div>
                                        <div><button type="button" onclick="addCustomField()" class="zr-btn zr-btn--primary zr-btn--block">Add</button></div>
                                    </div>
                                    <input type="hidden" id="customFieldsJson" name="customFields" value='<%= config.CUSTOM_FIELDS || "{\"custom_fields\":[]}" %>'>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('external-data') %>
                                <section class="zr-module" id="sec-external-api">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">External API</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-switchrow">
                                        <div class="zr-grow">
                                            <label for="externalApiEnabled" class="zr-field__name">Enable External API Integration</label>
                                        </div>
                                        <input type="checkbox" class="zr-toggle" id="externalApiEnabled" name="externalApiEnabled" <%= config.EXTERNAL_API_ENABLED === 'yes' ? 'checked' : '' %>>
                                    </div>
    
                                    <div id="externalApiSettings" class="zr-col zr-col--loose <%= config.EXTERNAL_API_ENABLED === 'yes' ? '' : 'hidden' %>">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiUrl" class="zr-field__name">API URL</label>
                                            <input type="text" id="externalApiUrl" name="externalApiUrl" value="<%= config.EXTERNAL_API_URL || '' %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiMethod" class="zr-field__name">HTTP Method</label>
                                            <select id="externalApiMethod" name="externalApiMethod" class="zr-input">
                                                <option value="GET" <%= config.EXTERNAL_API_METHOD === 'GET' ? 'selected' : '' %>>GET</option>
                                                <option value="POST" <%= config.EXTERNAL_API_METHOD === 'POST' ? 'selected' : '' %>>POST</option>
                                                <option value="PUT" <%= config.EXTERNAL_API_METHOD === 'PUT' ? 'selected' : '' %>>PUT</option>
                                            </select>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiHeaders" class="zr-field__name">Headers (JSON)</label>
                                            <textarea id="externalApiHeaders" name="externalApiHeaders" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_HEADERS || '' %></textarea>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiBody" class="zr-field__name">Request Body (JSON)</label>
                                            <textarea id="externalApiBody" name="externalApiBody" rows="3" class="zr-textarea"><%= config.EXTERNAL_API_BODY || '' %></textarea>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiTimeout" class="zr-field__name">Timeout (milliseconds)</label>
                                            <input type="number" id="externalApiTimeout" name="externalApiTimeout" value="<%= config.EXTERNAL_API_TIMEOUT || '5000' %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="externalApiTransform" class="zr-field__name">Transform Path</label>
                                            <textarea id="externalApiTransform" name="externalApiTransform" rows="4" class="zr-textarea"><%= config.EXTERNAL_API_TRANSFORM || '' %></textarea>
                                        </div>
                                        <%- include('partials/settings-switch', {
                                            id: 'externalApiAllowPrivateIps',
                                            label: 'Allow private IPs for external API',
                                            checked: config.EXTERNAL_API_ALLOW_PRIVATE_IPS === 'yes'
                                        }) %>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('ocr') %>
                                <section class="zr-module" id="sec-ocr-fallback">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">OCR Fallback</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'mistralOcrEnabled',
                                        label: 'Enable OCR',
                                        checked: config.MISTRAL_OCR_ENABLED === 'yes'
                                    }) %>
                                    <div id="ocrFieldsContainer" class="zr-field zr-field--stacked <%= config.MISTRAL_OCR_ENABLED === 'yes' ? '' : 'hidden' %>">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ocrProvider" class="zr-field__name">OCR Provider</label>
                                        <select id="ocrProvider" name="ocrProvider" class="zr-input">
                                            <option value="mistral" <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'selected' : '' %>>Mistral OCR API</option>
                                            <option value="custom" <%= ((config.OCR_PROVIDER || 'mistral') === 'custom' || (config.OCR_PROVIDER || 'mistral') === 'ollama') ? 'selected' : '' %>>Custom (Ollama, LM Studio, local models)</option>
                                            <option value="anthropic" <%= ocrStoredForAnthropic ? 'selected' : '' %>>Claude (Anthropic)</option>
                                        </select>
                                    </div>
                                    <div id="ocrApiUrlContainer" class="zr-field zr-field--stacked">
                                        <label for="ocrApiUrl" class="zr-field__name">OCR API URL (optional)</label>
                                        <input type="text" id="ocrApiUrl" name="ocrApiUrl" value="<%= config.OCR_API_URL || '' %>" class="zr-input" placeholder="Leave empty to use provider default" data-placeholder-default="Leave empty to use provider default" data-placeholder-anthropic="Optional proxy URL">
                                        <p id="ocrApiUrlAnthropicHint" class="zr-field__hint <%= ocrStoredForAnthropic ? '' : 'hidden' %>">Only for a proxy; empty uses the Anthropic API URL of the AI provider, then api.anthropic.com</p>
                                    </div>
                                    <div id="ocrApiKeyContainer" class="zr-field zr-field--stacked">
                                        <label for="ocrApiKey" class="zr-field__name">OCR API Key</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="ocrApiKey" name="ocrApiKey" value="" class="zr-input" placeholder="<%= ocrStoredForAnthropic ? (ocrKeyConfiguredAnthropic ? 'Configured' : 'Optional') : (ocrKeyConfiguredDefault ? 'Configured' : 'Required for Mistral') %>" data-placeholder-default="<%= ocrKeyConfiguredDefault ? 'Configured' : 'Required for Mistral' %>" data-placeholder-anthropic="<%= ocrKeyConfiguredAnthropic ? 'Configured' : 'Optional' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="ocrApiKey"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p id="ocrApiKeyHint" class="zr-field__hint <%= ocrStoredForAnthropic ? 'hidden' : '' %>">Optional for local and custom providers<%= ocrKeyConfiguredDefault ? ' · Leave empty to keep the stored value' : '' %></p>
                                        <p id="ocrApiKeyAnthropicHint" class="zr-field__hint <%= ocrStoredForAnthropic ? '' : 'hidden' %>"><%= ocrKeyConfiguredAnthropic ? 'Leave empty to keep the stored value' : 'Empty uses the Anthropic API key from the AI provider' %></p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="mistralOcrModel" class="zr-field__name">OCR Model</label>
                                        <div class="zr-inputgroup">
                                            <select id="mistralOcrModel" name="mistralOcrModel" class="zr-input">
                                                <option value="<%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %>" selected><%= config.MISTRAL_OCR_MODEL || 'mistral-ocr-latest' %></option>
                                            </select>
                                            <button type="button" id="fetchOcrModelsBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-list"/></svg>
                                                <span>Fetch OCR Models</span>
                                            </button>
                                        </div>
                                        <p id="ocrModelVisionHint" class="zr-field__hint <%= (config.OCR_PROVIDER || 'mistral') === 'mistral' ? 'hidden' : '' %>">Vision support is detected from the model name, so the list is grouped rather than filtered &middot; models outside the recommended group may still work</p>
                                    </div>
                                    <div id="ocrPdfRenderContainer" class="zr-col zr-col--loose">
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrPdfRenderEnabled',
                                            label: 'Render PDF Pages (poppler)',
                                            checked: (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes',
                                            hint: 'Render PDF pages with poppler (pdftoppm) so local vision models can OCR multi-page documents; falls back to the first-page thumbnail when poppler is not installed'
                                        }) %>
                                        <div id="ocrPdfRenderOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_PDF_RENDER_ENABLED || 'yes') === 'yes' ? '' : 'hidden' %>">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrPdfRenderMaxPages" class="zr-field__name">Max PDF Pages per Document</label>
                                                <input type="number" id="ocrPdfRenderMaxPages" name="ocrPdfRenderMaxPages" min="1" max="50" step="1" value="<%= config.OCR_PDF_RENDER_MAX_PAGES || 10 %>" class="zr-input">
                                                <p class="zr-field__hint">Each page is one vision model request; pages beyond the limit are skipped</p>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrPdfRenderDpi" class="zr-field__name">PDF Render Resolution (DPI)</label>
                                                <input type="number" id="ocrPdfRenderDpi" name="ocrPdfRenderDpi" min="72" max="300" step="1" value="<%= config.OCR_PDF_RENDER_DPI || 150 %>" class="zr-input">
                                                <p class="zr-field__hint">Higher values improve OCR accuracy but increase image size (72–300)</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div id="ocrAutoProcessContainer" class="zr-col zr-col--loose">
                                        <%- include('partials/settings-switch', {
                                            id: 'ocrAutoProcessEnabled',
                                            label: 'Process OCR Queue Automatically',
                                            checked: (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes',
                                            hint: 'Work through queued documents on a schedule instead of pressing "Process All Pending" on the OCR page'
                                        }) %>
                                        <div id="ocrAutoProcessOptionsContainer" class="zr-col zr-col--loose <%= (config.OCR_AUTO_PROCESS_ENABLED || 'no') === 'yes' ? '' : 'hidden' %>">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrAutoProcessInterval" class="zr-field__name">OCR Processing Interval (Cron)</label>
                                                <input type="text" id="ocrAutoProcessInterval" name="ocrAutoProcessInterval" value="<%= config.OCR_AUTO_PROCESS_INTERVAL || '*/15 * * * *' %>" class="zr-input" placeholder="*/15 * * * *">
                                                <p class="zr-field__hint">Default: every 15 minutes · Runs are skipped while a document scan is active</p>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="ocrAutoProcessBatchSize" class="zr-field__name">Documents per Run</label>
                                                <input type="number" id="ocrAutoProcessBatchSize" name="ocrAutoProcessBatchSize" min="1" max="100" step="1" value="<%= config.OCR_AUTO_PROCESS_BATCH_SIZE || 10 %>" class="zr-input">
                                                <p class="zr-field__hint">Caps how many queued documents one run handles; the rest follow at the next interval (1-100)</p>
                                            </div>
                                            <%- include('partials/settings-switch', {
                                                id: 'ocrAutoAnalyze',
                                                label: 'AI Analysis After OCR',
                                                checked: (config.OCR_AUTO_ANALYZE || 'yes') === 'yes',
                                                hint: 'Analyse each document right after OCR. Keep this on: when Paperless-ngx rejects the content write-back the OCR text only exists locally, where a regular scan would never see it'
                                            }) %>
                                        </div>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ocrValidationTimeout" class="zr-field__name">OCR Timeout</label>
                                        <div class="zr-row">
                                            <input type="number" id="ocrValidationTimeout" name="ocrValidationTimeout" min="1" max="7200" step="1" value="<%= Math.round(Number(config.SETUP_OCR_VALIDATION_TIMEOUT_MS || config.SETUP_VALIDATION_TIMEOUT_MS || 30000) / 1000) %>" class="zr-input">
                                            <span class="zr-xs zr-faint" style="white-space: nowrap">seconds</span>
                                        </div>
                                        <p class="zr-field__hint">Used for OCR model loading, connection tests and document processing</p>
                                    </div>
                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="testOcrBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                            <span>Test OCR Connection</span>
                                        </button>
                                        <span id="ocrTestState" class="zr-badge">Not tested</span>
                                    </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('schedule') %>
                                <section class="zr-module" id="sec-processing">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Processing</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="scanInterval" class="zr-field__name">Scan Interval (Cron Format)</label>
                                        <input type="text" id="scanInterval" name="scanInterval" value="<%= config.SCAN_INTERVAL %>" class="zr-input" required>
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <div class="zr-switchrow">
                                            <div class="zr-grow">
                                                <label for="disableAutomaticProcessing" class="zr-field__name">Disable automatic processing</label>
                                                <p class="zr-field__hint">If enabled, scans are not processed by AI automatically</p>
                                            </div>
                                            <input type="checkbox" class="zr-toggle" id="disableAutomaticProcessing" <%= config.DISABLE_AUTOMATIC_PROCESSING === 'yes' ? 'checked' : '' %>>
                                        </div>
                                    </div>
    
                                    <%- include('partials/settings-switch', {
                                        id: 'useExistingData',
                                        label: 'Use existing correspondents and tags',
                                        checked: config.USE_EXISTING_DATA === 'yes'
                                    }) %>
                                    </div>
                                </section>

                                <section class="zr-module" id="sec-tag-filters">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Tag Filters</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'showTags',
                                        label: 'Process only specific pre-tagged documents',
                                        checked: config.PROCESS_PREDEFINED_DOCUMENTS === 'yes'
                                    }) %>
    
                                    <div id="tagsInputSection" class="<%= config.PROCESS_PREDEFINED_DOCUMENTS === 'yes' ? '' : 'hidden' %> zr-field zr-field--stacked">
                                        <label for="tagInput" class="zr-field__name">Tags</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" id="tagInput" class="zr-input" placeholder="Enter a tag and press Enter">
                                            <button type="button" id="tagAddButton" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                                Add
                                            </button>
                                        </div>
                                        <div id="tagsContainer" class="zr-chips">
                                            <% if (config.TAGS && Array.isArray(config.TAGS) && config.TAGS.length > 0) { %>
                                                <% config.TAGS.forEach(tag => { %>
                                                    <div class="zr-chip">
                                                        <span><%= tag %></span>
                                                        <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                        <input type="hidden" id="tags" name="tags" value="<%= Array.isArray(config.TAGS) ? config.TAGS.join(',') : '' %>">
                                    </div>
    
                                    <div class="zr-field zr-field--stacked">
                                        <label for="ignoreTagInput" class="zr-field__name">Ignore Tags</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" id="ignoreTagInput" class="zr-input" placeholder="Tag name, then Enter">
                                            <button type="button" id="ignoreTagAddButton" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                                Add
                                            </button>
                                        </div>
                                        <div id="ignoreTagsContainer" class="zr-chips">
                                            <% if (config.IGNORE_TAGS && Array.isArray(config.IGNORE_TAGS) && config.IGNORE_TAGS.length > 0) { %>
                                                <% config.IGNORE_TAGS.forEach(tag => { %>
                                                    <div class="zr-chip">
                                                        <span><%= tag %></span>
                                                        <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                    </div>
                                                <% }); %>
                                            <% } %>
                                        </div>
                                        <input type="hidden" id="ignoreTags" name="ignoreTags" value="<%= Array.isArray(config.IGNORE_TAGS) ? config.IGNORE_TAGS.join(',') : '' %>">
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('skip-rules') %>
                                <section class="zr-module" id="sec-skip-rules">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Documents that skip OCR and AI</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-sm zr-muted">A document that matches a rule goes straight to the <a href="/ignored">ignored list</a>, with the rule as its reason. Take it off the list to have it processed anyway.</p>

                                    <div class="zr-field zr-field--stacked">
                                        <label for="maxPageCount" class="zr-field__name">Page limit</label>
                                        <input type="number" id="maxPageCount" name="maxPageCount" min="0" step="1" value="<%= config.MAX_PAGE_COUNT || 0 %>" class="zr-input">
                                        <p class="zr-field__hint">Documents with more pages are skipped. 0 means no limit. Uses the page count from Paperless-ngx.</p>
                                    </div>

                                    <div class="zr-field zr-field--stacked">
                                        <label for="ignoreTitlePatternInput" class="zr-field__name">Skip titles containing</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" id="ignoreTitlePatternInput" class="zr-input" placeholder="Part of a title or file name, then Enter">
                                            <button type="button" id="ignoreTitlePatternAddButton" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plus"/></svg>
                                                Add
                                            </button>
                                        </div>
                                        <div id="ignoreTitlePatternsContainer" class="zr-chips">
                                            <% (Array.isArray(config.IGNORE_TITLE_PATTERNS) ? config.IGNORE_TITLE_PATTERNS : []).forEach(pattern => { %>
                                                <div class="zr-chip">
                                                    <span><%= pattern %></span>
                                                    <button type="button" class="zr-link"><svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-x"/></svg></button>
                                                </div>
                                            <% }); %>
                                        </div>
                                        <input type="hidden" id="ignoreTitlePatterns" name="ignoreTitlePatterns" value="<%= Array.isArray(config.IGNORE_TITLE_PATTERNS) ? config.IGNORE_TITLE_PATTERNS.join(',') : '' %>">
                                        <p class="zr-field__hint">Matched anywhere in the title or the original file name, upper or lower case alike.</p>
                                    </div>

                                    <%- include('partials/settings-switch', {
                                        id: 'ignoreRepeatedContent',
                                        label: 'Skip copies of ignored documents',
                                        checked: String(config.IGNORE_REPEATED_CONTENT || 'yes').toLowerCase() !== 'no',
                                        hint: 'A document whose text is the same as one on the ignored list is skipped too. Compares the text Paperless-ngx recognised, so a newly generated PDF of the same terms still counts.'
                                    }) %>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('runtime') %>
                                <section class="zr-module" id="sec-runtime-controls">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Runtime Controls</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-formgrid">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="globalRateLimitWindowMs" class="zr-field__name">Global rate-limit window (ms)</label>
                                            <input type="number" id="globalRateLimitWindowMs" name="globalRateLimitWindowMs" value="<%= config.GLOBAL_RATE_LIMIT_WINDOW_MS || 900000 %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="globalRateLimitMax" class="zr-field__name">Global rate-limit max requests</label>
                                            <input type="number" id="globalRateLimitMax" name="globalRateLimitMax" value="<%= config.GLOBAL_RATE_LIMIT_MAX || 1000 %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="trustProxy" class="zr-field__name">Trust Proxy</label>
                                            <input type="text" id="trustProxy" name="trustProxy" value="<%= config.TRUST_PROXY %>" class="zr-input" placeholder="false | true | 1 | loopback">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="cookieSecureMode" class="zr-field__name">Cookie Secure Mode</label>
                                            <select id="cookieSecureMode" name="cookieSecureMode" class="zr-input">
                                                <option value="auto" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'auto' ? 'selected' : '' %>>auto</option>
                                                <option value="always" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'always' ? 'selected' : '' %>>always</option>
                                                <option value="never" <%= String(config.COOKIE_SECURE_MODE || 'auto').toLowerCase() === 'never' ? 'selected' : '' %>>never</option>
                                            </select>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="minContentLength" class="zr-field__name">Minimum content length</label>
                                            <input type="number" id="minContentLength" name="minContentLength" value="<%= config.MIN_CONTENT_LENGTH || 10 %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="paperlessAiPort" class="zr-field__name">Zettelrobbe Port</label>
                                            <input type="number" id="paperlessAiPort" name="paperlessAiPort" value="<%= config.PAPERLESS_AI_PORT || 3000 %>" class="zr-input">
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="logLevel" class="zr-field__name">Log Level</label>
                                            <select id="logLevel" name="logLevel" class="zr-input">
                                                <option value="error" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'error' ? 'selected' : '' %>>error</option>
                                                <option value="warn" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'warn' ? 'selected' : '' %>>warn</option>
                                                <option value="info" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'info' ? 'selected' : '' %>>info (default)</option>
                                                <option value="debug" <%= String(config.LOG_LEVEL || 'info').toLowerCase() === 'debug' ? 'selected' : '' %>>debug</option>
                                            </select>
                                        </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('duplicates') %>
                                <section class="zr-module" id="sec-duplicates">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Duplicates</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-sm zr-muted">
                                        The Duplicates page finds tags and correspondents that mean the same thing. Finding and merging
                                        them is deterministic and needs none of these settings; they only govern the optional AI review
                                        that judges the proposed groups when you ask for it. Nothing here starts a scan or a merge on its own.
                                    </p>
                                    <%- include('partials/settings-switch', {
                                        id: 'duplicatesAiReview',
                                        label: 'Offer the AI review on the Duplicates page',
                                        checked: (config.DUPLICATES_AI_REVIEW || 'yes') === 'yes',
                                        hint: 'Default: on · Off keeps the model off the page: Find duplicates and Scan apply the spelling rules only · Restart required'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiModel" class="zr-field__name">Model for the judge</label>
                                        <input type="text" id="duplicatesAiModel" name="duplicatesAiModel" value="<%= config.DUPLICATES_AI_MODEL || '' %>" class="zr-input" placeholder="Leave empty to use the configured model">
                                        <p class="zr-field__hint">A stronger model of the same provider, used only for judging duplicates · Default: empty, which means the provider's configured model · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiReviewBatchSize" class="zr-field__name">Pairs per model request</label>
                                        <input type="number" id="duplicatesAiReviewBatchSize" name="duplicatesAiReviewBatchSize" min="1" max="100" step="1" value="<%= config.DUPLICATES_AI_REVIEW_BATCH_SIZE || 25 %>" class="zr-input">
                                        <p class="zr-field__hint">How many name pairs one request asks about; fewer pairs mean more requests, more pairs need a larger context (1-100) · Default: 25 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiCandidateFloor" class="zr-field__name">Lowest matcher score shown to the model</label>
                                        <input type="number" id="duplicatesAiCandidateFloor" name="duplicatesAiCandidateFloor" min="0.5" max="0.95" step="0.01" value="<%= config.DUPLICATES_AI_CANDIDATE_FLOOR || '0.6' %>" class="zr-input">
                                        <p class="zr-field__hint">Near-misses below your sensitivity but above this score are judged too; a lower value asks about more pairs (0.50-0.95) · Default: 0.6 · Restart required</p>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'duplicatesAiExcerpts',
                                        label: 'Read document excerpts for spelling-only pairs',
                                        checked: (config.DUPLICATES_AI_EXCERPTS || 'yes') === 'yes',
                                        hint: 'Default: on · Sends a short excerpt of a couple of documents when the matcher linked a pair by spelling alone, so a typo-like pair that means two different things can be told apart · Restart required'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiExcerptChars" class="zr-field__name">Excerpt length in characters</label>
                                        <input type="number" id="duplicatesAiExcerptChars" name="duplicatesAiExcerptChars" min="50" max="500" step="1" value="<%= config.DUPLICATES_AI_EXCERPT_CHARS || 300 %>" class="zr-input">
                                        <p class="zr-field__hint">How much of each document the judge gets to read; longer excerpts cost tokens (50-500) · Default: 300 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiExcerptDocuments" class="zr-field__name">Documents per entry for excerpts</label>
                                        <input type="number" id="duplicatesAiExcerptDocuments" name="duplicatesAiExcerptDocuments" min="1" max="5" step="1" value="<%= config.DUPLICATES_AI_EXCERPT_DOCUMENTS || 2 %>" class="zr-input">
                                        <p class="zr-field__hint">How many documents of each tag or correspondent are sampled for those excerpts (1-5) · Default: 2 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiTokenBudget" class="zr-field__name">Token budget per review</label>
                                        <input type="number" id="duplicatesAiTokenBudget" name="duplicatesAiTokenBudget" min="0" max="10000000" step="1000" value="<%= config.DUPLICATES_AI_TOKEN_BUDGET || 200000 %>" class="zr-input">
                                        <p class="zr-field__hint">The most one review may spend across all its requests; when it is reached the review stops and keeps the verdicts it has, and 0 means no limit (0-10000000) · Default: 200000 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiIdleStopSeconds" class="zr-field__name">Stop an unwatched review after (seconds)</label>
                                        <input type="number" id="duplicatesAiIdleStopSeconds" name="duplicatesAiIdleStopSeconds" min="0" max="3600" step="1" value="<%= config.DUPLICATES_AI_IDLE_STOP_SECONDS || 60 %>" class="zr-input">
                                        <p class="zr-field__hint">A review nobody has been watching for this long stops itself, so a closed tab cannot leave the model running, and 0 means never (0-3600) · Default: 60 · Restart required</p>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'duplicatesAiThinking',
                                        label: 'Let the judge think',
                                        checked: (config.DUPLICATES_AI_THINKING || 'no') === 'yes',
                                        hint: 'Reasoning models write their thoughts before the answer and spend the whole answer budget on them. Off, the judge gets its evidence instead and answers in a fraction of the time and cost. On only if your model answers badly without it. Default: off · Restart required.'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiRequestSeconds" class="zr-field__name">Seconds per model request</label>
                                        <input type="number" id="duplicatesAiRequestSeconds" name="duplicatesAiRequestSeconds" min="5" max="300" step="5" value="<%= config.DUPLICATES_AI_REQUEST_SECONDS || 30 %>" class="zr-input">
                                        <p class="zr-field__hint">The judge measures your model on a small first request and then asks about as many pairs per request as fit into this many seconds. Shorter means more, smaller requests and more frequent progress. Default: 30 · Restart required.</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiConcurrency" class="zr-field__name">Model requests at once</label>
                                        <input type="number" id="duplicatesAiConcurrency" name="duplicatesAiConcurrency" min="0" max="8" step="1" value="<%= config.DUPLICATES_AI_CONCURRENCY || 0 %>" class="zr-input">
                                        <p class="zr-field__hint">0 lets the judge choose: one for Ollama, three for a hosted endpoint. Wall time divides by it, tokens do not. Default: 0 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiVerdictMemoryDays" class="zr-field__name">Remember verdicts for (days)</label>
                                        <input type="number" id="duplicatesAiVerdictMemoryDays" name="duplicatesAiVerdictMemoryDays" min="0" max="365" step="1" value="<%= config.DUPLICATES_AI_VERDICT_MEMORY_DAYS || 90 %>" class="zr-input">
                                        <p class="zr-field__hint">A pair the model judged is not asked again while both names are unchanged; 0 switches the memory off. Default: 90 · Restart required</p>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'duplicatesGuardNewNames',
                                        label: 'Reuse an existing name instead of creating a near-duplicate',
                                        checked: (config.DUPLICATES_GUARD_NEW_NAMES || 'yes') === 'yes',
                                        hint: 'When document analysis proposes a tag or correspondent that is the same word in another spelling (case, umlauts, legal form, plural, word order), the existing one is used and the mapping is listed on the Duplicates page. A typo-like match is only logged. Default: on · Restart required.'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="duplicatesAiSweepNames" class="zr-field__name">Names per request for the semantic sweep</label>
                                        <input type="number" id="duplicatesAiSweepNames" name="duplicatesAiSweepNames" min="50" max="1000" step="50" value="<%= config.DUPLICATES_AI_SWEEP_NAMES || 300 %>" class="zr-input">
                                        <p class="zr-field__hint">How many names the model sees per request when it looks at the whole list. Default: 300 · Restart required.</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('simplify') %>
                                <section class="zr-module" id="sec-simplify">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Simplify tags</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-sm zr-muted">
                                        The Simplify tags page turns a compound tag such as "Stromrechnung" into a document type
                                        ("Rechnung") and topic tags ("Strom"). Decomposing against a saved vocabulary is a rule and
                                        needs no model; these two settings only govern the optional proposals the model makes.
                                    </p>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="simplifyTagsPerRequest" class="zr-field__name">Tags per model request</label>
                                        <input type="number" id="simplifyTagsPerRequest" name="simplifyTagsPerRequest" min="10" max="200" step="10" value="<%= config.SIMPLIFY_TAGS_PER_REQUEST || 50 %>" class="zr-input">
                                        <p class="zr-field__hint">How many tag names one request asks the model to decompose; fewer names mean more requests (10-200) · Default: 50 · Restart required</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="simplifyVocabularySize" class="zr-field__name">Vocabulary size</label>
                                        <input type="number" id="simplifyVocabularySize" name="simplifyVocabularySize" min="5" max="100" step="5" value="<%= config.SIMPLIFY_VOCABULARY_SIZE || 25 %>" class="zr-input">
                                        <p class="zr-field__hint">How many entries the proposed vocabulary should aim at, document types and topics together (5-100) · Default: 25 · Restart required</p>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('account') %>
                                <!-- One id only: a second id attribute is dropped by the
                                     parser, and getElementById('mfaSettingsSection')
                                     returning null silently disabled the whole MFA
                                     state machine. -->
                                <section class="zr-module" id="mfaSettingsSection" data-mfa-available="<%= mfaSettings && mfaSettings.available ? 'yes' : 'no' %>" data-mfa-enabled="<%= mfaSettings && mfaSettings.enabled ? 'yes' : 'no' %>" data-mfa-username="<%= mfaSettings && mfaSettings.username ? mfaSettings.username : '' %>">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Account Security (TOTP)</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
    
                                    <% if (!(mfaSettings && mfaSettings.available)) { %>
                                        <div class="zr-alert zr-alert--warn">
                                            MFA controls are available only for interactive user sessions (not API key authentication).
                                        </div>
                                    <% } else { %>
                                        <div class="zr-col zr-col--loose">
                                            <div class="zr-row zr-row--wrap zr-row--between">
                                                <div>
                                                    <p class="zr-field__name">User: <span id="mfaSettingsUser"><%= mfaSettings.username %></span></p>
                                                    <p class="zr-field__hint">Configure two-factor authentication for this account.</p>
                                                </div>
                                                <span id="mfaStatusBadge" class="zr-badge <%= mfaSettings.enabled ? 'zr-badge--ok' : '' %>">
                                                    <%= mfaSettings.enabled ? 'Enabled' : 'Disabled' %>
                                                </span>
                                            </div>
    
                                            <div class="zr-field zr-field--stacked">
                                                <label for="mfaCurrentPassword" class="zr-field__name">Current Password</label>
                                                <input type="password" id="mfaCurrentPassword" class="zr-input" placeholder="Enter current password">
                                                <p class="zr-field__hint">Required to start activation and to disable MFA.</p>
                                            </div>
    
                                            <div class="zr-formgrid">
                                                <button type="button" id="mfaEnableBtn" class="zr-btn zr-btn--primary">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                                                    <span>Enable MFA</span>
                                                </button>
                                                <button type="button" id="mfaDisableBtn" class="zr-btn zr-btn--danger">
                                                    <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-shield"/></svg>
                                                    <span>Disable MFA</span>
                                                </button>
                                            </div>
    
                                            <div id="mfaProvisioningBox" class="zr-col hidden">
                                                <div class="zr-row">
                                                    <img id="mfaQrImage" class="hidden no-invert" alt="MFA provisioning QR code" />
                                                </div>
                                                <div class="zr-col zr-col--tight">
                                                    <label for="mfaSecretKey" class="zr-field__name">Secret Key</label>
                                                    <input type="text" id="mfaSecretKey" class="zr-input" readonly>
                                                </div>
                                                <div class="zr-col zr-col--tight">
                                                    <label for="mfaOtpAuthUri" class="zr-field__name">OTP URI</label>
                                                    <textarea id="mfaOtpAuthUri" rows="3" class="zr-textarea" readonly></textarea>
                                                </div>
                                                <div class="zr-inputgroup">
                                                    <button type="button" id="mfaCopySecretBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                        <span>Copy Secret</span>
                                                    </button>
                                                    <button type="button" id="mfaDownloadQrBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-download"/></svg>
                                                        <span>Download QR</span>
                                                    </button>
                                                </div>
                                                <p class="zr-field__hint">Use either the key or URI in your authenticator app, then enter a code below.</p>
                                            </div>
    
                                            <div class="zr-field zr-field--stacked" id="mfaTokenField">
                                                <label for="mfaToken" class="zr-field__name">Authenticator Code</label>
                                                <div class="zr-inputgroup">
                                                    <input type="text" id="mfaToken" inputmode="numeric" autocomplete="one-time-code" class="zr-input" placeholder="Enter 6-digit code">
                                                    <button type="button" id="mfaVerifyBtn" class="zr-btn">
                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-flask"/></svg>
                                                        <span id="mfaVerifyBtnLabel">Validate & Activate</span>
                                                    </button>
                                                </div>
                                                <p id="mfaTokenHint" class="hidden"></p>
                                            </div>
    
                                            <div id="mfaResultMessage" class="hidden"></div>
                                        </div>
                                    <% } %>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('sso') %>
                                <div class="zr-col zr-col--loose" data-module="settings-sso">
                                <section class="zr-module" id="sec-sso-provider">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Enable single sign-on</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <%- include('partials/settings-switch', {
                                        id: 'oidcEnabled',
                                        label: 'Sign in through an OpenID Connect provider',
                                        checked: oidcSwitchOn(config.OIDC_ENABLED, 'no'),
                                        hint: 'OIDC_ENABLED · Password sign-in keeps working next to it'
                                    }) %>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcIssuerUrl" class="zr-field__name">Issuer URL</label>
                                        <input type="text" inputmode="url" id="oidcIssuerUrl" name="oidcIssuerUrl" value="<%= config.OIDC_ISSUER_URL || '' %>" class="zr-input" placeholder="https://auth.example.com/application/o/zettelrobbe/" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_ISSUER_URL · The provider's issuer; the full discovery URL works too</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcClientId" class="zr-field__name">Client ID</label>
                                        <input type="text" id="oidcClientId" name="oidcClientId" value="<%= config.OIDC_CLIENT_ID || '' %>" class="zr-input" placeholder="zettelrobbe" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_CLIENT_ID · Client ID of the application registered at the provider</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcClientSecret" class="zr-field__name">Client secret</label>
                                        <div class="zr-inputgroup">
                                            <input type="password" id="oidcClientSecret" name="oidcClientSecret" value="" class="zr-input" autocomplete="new-password" placeholder="<%= configuredSecrets.OIDC_CLIENT_SECRET ? 'Configured' : 'Empty for a public client' %>">
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon zr-input__reveal" data-input="oidcClientSecret" aria-label="Show client secret"><svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-eye"/></svg></button>
                                        </div>
                                        <p class="zr-field__hint">OIDC_CLIENT_SECRET · <%= configuredSecrets.OIDC_CLIENT_SECRET ? 'Leave empty to keep the stored value' : 'Only for a confidential client' %></p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcRedirectUri" class="zr-field__name">Redirect URI</label>
                                        <div class="zr-inputgroup">
                                            <input type="text" inputmode="url" id="oidcRedirectUri" name="oidcRedirectUri" value="<%= config.OIDC_REDIRECT_URI || '' %>" class="zr-input" placeholder="<%= oidcRedirectDetected %>" data-detected="<%= oidcRedirectDetected %>" autocomplete="off" spellcheck="false">
                                            <button type="button" class="zr-btn" data-el="copy-redirect">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                <span>Copy</span>
                                            </button>
                                        </div>
                                        <p class="zr-field__hint">OIDC_REDIRECT_URI · Register exactly this URL at the provider · Empty uses the address shown, set it behind a reverse proxy</p>
                                    </div>
                                    <div class="zr-col zr-col--tight zr-sso-test">
                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" class="zr-btn" data-el="test">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-plug"/></svg>
                                                <span>Test connection</span>
                                            </button>
                                            <span class="zr-field__hint">Reads the provider's discovery document with the values above, before you save</span>
                                        </div>
                                        <div class="hidden" data-el="test-result" role="status" aria-live="polite"></div>
                                    </div>
                                    </div>
                                </section>

                                <section class="zr-module" id="sec-sso-access">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Who may sign in</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-sm zr-muted">Single sign-on adds no users: it signs in to the one administrator account, and only the identity whose e-mail address matches gets in. Restrict the application at the provider as well.</p>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcAdminEmail" class="zr-field__name">Administrator e-mail</label>
                                        <input type="text" inputmode="email" id="oidcAdminEmail" name="oidcAdminEmail" value="<%= config.OIDC_ADMIN_EMAIL || '' %>" class="zr-input" placeholder="you@example.com" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_ADMIN_EMAIL · Your address at the provider, compared without regard to case</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcEmailClaim" class="zr-field__name">E-mail claim</label>
                                        <input type="text" id="oidcEmailClaim" name="oidcEmailClaim" value="<%= config.OIDC_EMAIL_CLAIM || 'email' %>" class="zr-input" placeholder="email" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_EMAIL_CLAIM · The claim that carries the address · Default: email</p>
                                    </div>
                                    <%- include('partials/settings-switch', {
                                        id: 'oidcAllowUnverifiedEmail',
                                        label: 'Accept unverified e-mail addresses',
                                        checked: oidcSwitchOn(config.OIDC_ALLOW_UNVERIFIED_EMAIL, 'no'),
                                        hint: 'OIDC_ALLOW_UNVERIFIED_EMAIL · Only for providers that never confirm addresses; restrict the application at the provider then · Default: off'
                                    }) %>
                                    </div>
                                </section>

                                <section class="zr-module" id="sec-sso-button">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Login button</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-sso-preview" aria-label="Preview of the login button">
                                        <p class="zr-label">Preview</p>
                                        <div class="zr-sso-preview__card zr-col login-sso">
                                            <div class="login-sso__divider zr-sm"><span>or</span></div>
                                            <span class="zr-btn zr-btn--lg zr-btn--block login-sso__button" data-el="preview" aria-hidden="true">
                                                <svg class="zr-icon zr-icon--sm" data-el="preview-default-icon" aria-hidden="true"><use href="/icons.svg#i-key"/></svg>
                                                <img class="login-sso__icon hidden" data-el="preview-image" alt="">
                                                <span data-el="preview-text">Sign in with SSO</span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="zr-formgrid">
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonText" class="zr-field__name">Text</label>
                                            <input type="text" id="oidcButtonText" name="oidcButtonText" value="<%= config.OIDC_BUTTON_TEXT || '' %>" class="zr-input" maxlength="60" placeholder="Sign in with SSO">
                                            <p class="zr-field__hint">OIDC_BUTTON_TEXT · Up to 60 characters</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonIcon" class="zr-field__name">Icon</label>
                                            <input type="text" id="oidcButtonIcon" name="oidcButtonIcon" value="<%= config.OIDC_BUTTON_ICON || '' %>" class="zr-input" placeholder="Key icon" autocomplete="off" spellcheck="false">
                                            <p class="zr-field__hint">OIDC_BUTTON_ICON · An https:// image URL, a path on this server such as /favicon.png, or none · Empty shows the key icon</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonColor" class="zr-field__name">Background</label>
                                            <div class="zr-inputgroup">
                                                <span class="zr-sso-swatch" data-swatch-for="oidcButtonColor" aria-hidden="true"></span>
                                                <input type="text" id="oidcButtonColor" name="oidcButtonColor" value="<%= config.OIDC_BUTTON_COLOR || '' %>" class="zr-input" placeholder="Theme default" autocomplete="off" spellcheck="false">
                                            </div>
                                            <p class="zr-field__hint">OIDC_BUTTON_COLOR · #rrggbb, #rgb, a colour name, rgb(…) or hsl(…)</p>
                                        </div>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="oidcButtonTextColor" class="zr-field__name">Text colour</label>
                                            <div class="zr-inputgroup">
                                                <span class="zr-sso-swatch" data-swatch-for="oidcButtonTextColor" aria-hidden="true"></span>
                                                <input type="text" id="oidcButtonTextColor" name="oidcButtonTextColor" value="<%= config.OIDC_BUTTON_TEXT_COLOR || '' %>" class="zr-input" placeholder="Theme default" autocomplete="off" spellcheck="false">
                                            </div>
                                            <p class="zr-field__hint">OIDC_BUTTON_TEXT_COLOR · Same formats as the background</p>
                                        </div>
                                    </div>
                                    </div>
                                </section>

                                <details class="zr-module zr-sso-advanced" id="sec-sso-advanced">
                                    <summary class="zr-module__head">
                                        <h2 class="zr-module__title">Advanced</h2>
                                        <span class="zr-field__hint zr-grow">Scopes and token authentication</span>
                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                    </summary>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcScopes" class="zr-field__name">Scopes</label>
                                        <input type="text" id="oidcScopes" name="oidcScopes" value="<%= config.OIDC_SCOPES || 'openid profile email' %>" class="zr-input" placeholder="openid profile email" autocomplete="off" spellcheck="false">
                                        <p class="zr-field__hint">OIDC_SCOPES · openid is always added; keep email, it carries the address · Default: openid profile email</p>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="oidcTokenAuthMethod" class="zr-field__name">Token authentication</label>
                                        <% const oidcAuthMethod = String(config.OIDC_TOKEN_AUTH_METHOD || '').trim(); %>
                                        <select id="oidcTokenAuthMethod" name="oidcTokenAuthMethod" class="zr-input">
                                            <option value="" <%= oidcAuthMethod === '' ? 'selected' : '' %>>Automatic</option>
                                            <option value="client_secret_basic" <%= oidcAuthMethod === 'client_secret_basic' ? 'selected' : '' %>>client_secret_basic</option>
                                            <option value="client_secret_post" <%= oidcAuthMethod === 'client_secret_post' ? 'selected' : '' %>>client_secret_post</option>
                                            <option value="none" <%= oidcAuthMethod === 'none' ? 'selected' : '' %>>none (public client)</option>
                                        </select>
                                        <p class="zr-field__hint">OIDC_TOKEN_AUTH_METHOD · Automatic uses none without a secret, otherwise client_secret_basic unless the provider only offers client_secret_post</p>
                                    </div>
                                    </div>
                                </details>
                                </div>
                        <%- entryClose() %>

                        <%- entryOpen('api-key') %>
                                <section class="zr-module" id="sec-api-key">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">API key</h2>
                                    </div>
                                    <div class="zr-module__body zr-col">
                                        <p class="zr-sm zr-muted">Used by the REST API and the Paperless-ngx post-consume script.</p>
                                        <div class="zr-inputgroup">
                                            <div id="apiKeyContainer" class="zr-input zr-mono zr-apikey" data-api-key=""
                                                title="Click to copy API key" role="button" tabindex="0">Loading…</div>
                                            <button type="button" id="regenerateBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" id="regenerateIcon" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                                <span>Regenerate</span>
                                            </button>
                                        </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('caching') %>
                                <section class="zr-module" id="sec-caching">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Caching</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <div class="zr-field zr-field--stacked">
                                        <label for="tagCacheTTL" class="zr-row">
                                            Tag Cache Lifetime (Seconds)
                                            <button type="button" class="zr-btn zr-btn--ghost zr-btn--icon" id="tagCacheTTLHelp">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-help"/></svg>
                                            </button>
                                        </label>
                                        <input type="number" id="tagCacheTTL" name="tagCacheTTL" min="60" max="3600" value="<%= config.TAG_CACHE_TTL_SECONDS || 300 %>" class="zr-input" required>
                                    </div>
                                    <button type="button" id="clearTagCacheBtn" class="zr-btn">
                                        <svg class="zr-icon zr-icon--sm" id="clearCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                        <span>Clear Tag Cache Now</span>
                                    </button>
    
                                    <div class="zr-col">
                                        <div class="zr-row zr-row--between">
                                            <div>
                                                <p class="zr-field__name">Thumbnail Cache</p>
                                                <p class="zr-field__hint">Local cached previews stored in <code>public/images</code>.</p>
                                            </div>
                                            <button type="button" id="refreshThumbnailCacheStatsBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                                <span>Refresh</span>
                                            </button>
                                        </div>
    
                                        <div class="zr-formgrid">
                                            <div >
                                                <p class="zr-field__hint">Files</p>
                                                <p id="thumbnailCacheFileCount" class="zr-module__title">-</p>
                                            </div>
                                            <div >
                                                <p class="zr-field__hint">Total Size</p>
                                                <p id="thumbnailCacheTotalSize" class="zr-module__title">-</p>
                                            </div>
                                        </div>
    
                                        <button type="button" id="clearThumbnailCacheBtn" class="zr-btn zr-btn--danger">
                                            <svg class="zr-icon zr-icon--sm" id="clearThumbnailCacheIcon" aria-hidden="true"><use href="/icons.svg#i-trash"/></svg>
                                            <span>Clear Thumbnail Cache</span>
                                        </button>
                                    </div>
    
                                    </div>
                                </section>

                                <section class="zr-module" id="sec-history-reconciliation">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">History Reconciliation</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-sm zr-muted">
                                        Automatically removes stale history entries for documents that have been deleted in Paperless-ngx.
                                        Reconciliation runs on a configurable cron schedule and waits for any active scan to finish before starting.
                                    </p>
                                    <div class="zr-formgrid">
                                        <%- include('partials/settings-switch', {
                                            id: 'reconciliationEnabled',
                                            label: 'Automatic Reconciliation',
                                            checked: String(config.RECONCILIATION_ENABLED || 'yes').toLowerCase() === 'yes'
                                        }) %>
                                        <div class="zr-field zr-field--stacked">
                                            <label for="reconciliationInterval" class="zr-field__name">Reconciliation Interval (Cron)</label>
                                            <input type="text" id="reconciliationInterval" name="reconciliationInterval" value="<%= config.RECONCILIATION_INTERVAL || '0 * * * *' %>" class="zr-input" placeholder="0 * * * *">
                                            <p class="zr-field__hint">Default: every hour</p>
                                        </div>
                                    </div>
                                    <div>
                                        <button type="button" id="forceReconcileBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                            <span>Force Reconciliation Now</span>
                                        </button>
                                        <div id="reconcileResult" class="hidden"></div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('quickstart') %>
                                <section class="zr-module" id="sec-quickstart-auto-detect">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Quickstart auto-detect</h2>
                                    </div>
                                    <div class="zr-module__body zr-col zr-col--loose">
                                    <p class="zr-field__hint">Point at a local AI server (LM Studio, Ollama, or any OpenAI-compatible endpoint). Detection lists the running models and classifies them for AI analysis and OCR. These two fields drive the detection run only &mdash; what gets saved is what you apply to <a href="#ai-provider" class="zr-link zr-link--underline">AI provider</a> and <a href="#ocr" class="zr-link zr-link--underline">OCR fallback</a>.</p>
    <%
    /* Only the provider actually in use may prefill this field. config.OLLAMA_API_URL
       carries a default of http://localhost:11434 and is therefore never empty, so
       "whichever is set" would hand every OpenAI or Azure install a localhost URL it
       never configured. The stored key follows the same provider, and the route
       below only substitutes it when the detection targets that same server. */
    const quickstartProvider = String(config.AI_PROVIDER || '').toLowerCase();
    const quickstartUrl =
        quickstartProvider === 'ollama' ? (config.OLLAMA_API_URL || '')
        : quickstartProvider === 'custom' ? (config.CUSTOM_BASE_URL || '')
        : '';
    const quickstartKeyStored =
        quickstartProvider === 'ollama' ? Boolean(configuredSecrets.OLLAMA_API_KEY)
        : quickstartProvider === 'custom' ? Boolean(configuredSecrets.CUSTOM_API_KEY)
        : false;
    -%>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="settingsQuickstartUrl" class="zr-field__name">AI server URL</label>
                                        <input type="text" id="settingsQuickstartUrl" class="zr-input" value="<%= quickstartUrl %>" placeholder="http://192.168.1.5:1234">
                                        <% if (quickstartUrl) { %>
                                            <p class="zr-field__hint">Prefilled from the configured AI server</p>
                                        <% } %>
                                    </div>
                                    <div class="zr-field zr-field--stacked">
                                        <label for="settingsQuickstartApiKey" class="zr-field__name">API key (optional)</label>
                                        <input type="password" id="settingsQuickstartApiKey" class="zr-input" placeholder="<%= quickstartKeyStored ? 'Configured' : 'Optional' %>">
                                        <% if (quickstartKeyStored) { %>
                                            <p class="zr-field__hint">Leave empty to use the stored key for this server</p>
                                        <% } %>
                                    </div>
                                    <div class="zr-row zr-row--wrap">
                                        <button type="button" id="settingsQuickstartDetectBtn" class="zr-btn">
                                            <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-search"/></svg>
                                            <span>Detect models</span>
                                        </button>
                                        <span id="settingsQuickstartState" class="zr-field__hint">Not detected</span>
                                    </div>
                                    <div id="settingsQuickstartResults" class="zr-col zr-col--loose hidden">
                                        <p id="settingsQuickstartHint" class="zr-field__hint"></p>
                                        <div class="zr-formgrid">
                                            <div class="zr-field zr-field--stacked">
                                                <label for="settingsQuickstartAiModel" class="zr-field__name">Suggested AI model</label>
                                                <select id="settingsQuickstartAiModel" class="zr-input"></select>
                                            </div>
                                            <div class="zr-field zr-field--stacked">
                                                <label for="settingsQuickstartOcrModel" class="zr-field__name">OCR model</label>
                                                <select id="settingsQuickstartOcrModel" class="zr-input"></select>
                                            </div>
                                        </div>
                                        <div class="zr-row">
                                            <input type="checkbox" class="zr-toggle" id="settingsQuickstartEnableOcr">
                                            <label for="settingsQuickstartEnableOcr" class="zr-field__name">Use this service for OCR</label>
                                        </div>
                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" id="settingsQuickstartApplyBtn" class="zr-btn">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-wand"/></svg>
                                                <span>Apply to fields</span>
                                            </button>
                                            <button type="button" id="settingsQuickstartSaveBtn" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                                <span>Test models &amp; save</span>
                                            </button>
                                            <span id="settingsQuickstartApplyHint" class="zr-field__hint"></span>
                                        </div>
                                    </div>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('environment') %>
                                <section class="zr-module" id="sec-env-file" data-module="env-file">
                                    <div class="zr-module__head">
                                        <h2 class="zr-module__title">Configuration as a .env file</h2>
                                    </div>
                                    <div class="zr-module__body zr-col">
                                        <p class="zr-sm zr-muted">
                                            The running configuration as a <code>.env</code> file, grouped by topic and
                                            limited to what is set. Use it to move this instance or to carry its settings
                                            into a docker compose file.
                                        </p>

                                        <div class="zr-alert zr-alert--warn">
                                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-alert"/></svg>
                                            <div class="zr-alert__body">
                                                <p class="zr-sm">
                                                    It contains API tokens and keys in clear text. <code>JWT_SECRET</code>
                                                    is left out; a fresh instance generates its own.
                                                </p>
                                            </div>
                                        </div>

                                        <div class="zr-row zr-row--wrap">
                                            <button type="button" id="envFileShowBtn" class="zr-btn zr-btn--primary">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-code"/></svg>
                                                <span>Show configuration</span>
                                            </button>
                                            <button type="button" id="envFileCopyBtn" class="zr-btn hidden">
                                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-copy"/></svg>
                                                <span>Copy</span>
                                            </button>
                                            <span class="zr-sm zr-faint" id="envFileMeta"></span>
                                        </div>
    
                                        <textarea id="envFileOutput" class="zr-textarea zr-mono hidden" rows="18" readonly
                                            spellcheck="false" aria-label="Configuration as a .env file"></textarea>
                                    </div>
                                </section>
                        <%- entryClose() %>

                        <%- entryOpen('changelog') %>
                                <section class="zr-module__body zr-col zr-col--loose">
                                    <div class="changelog-header">
                                        <div>
                                            <h3 class="zr-module__title">Release History</h3>
                                            <p class="zr-field__hint">What changed in each release, newest first. The current release is expanded.</p>
                                        </div>
                                        <a href="https://github.com/admonstrator/zettelrobbe/releases" target="_blank" rel="noopener noreferrer" class="changelog-source-link">
                                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-github"/></svg>
                                            <span>Full release notes</span>
                                        </a>
                                    </div>
    
                                    <%
                                        const releaseList = Array.isArray(changelogReleases) ? changelogReleases : [];
                                        const categoryMeta = {
                                            new: { label: 'New', icon: 'i-plus' },
                                            fix: { label: 'Fix', icon: 'i-wrench' },
                                            improvement: { label: 'Improved', icon: 'i-arrow-up' },
                                            removed: { label: 'Removed', icon: 'i-minus' },
                                            security: { label: 'Security', icon: 'i-shield' },
                                            note: { label: 'Note', icon: 'i-info' }
                                        };
                                    %>
    
                                    <% if (releaseList.length === 0) { %>
                                        <p class="zr-sm zr-faint">No release history available.</p>
                                    <% } else { %>
                                        <ol class="changelog-timeline">
                                            <% releaseList.forEach(function (release, releaseIndex) { %>
                                                <li class="changelog-release<%= releaseIndex === 0 ? ' changelog-release--current' : '' %>">
                                                    <span class="changelog-dot" aria-hidden="true"></span>
                                                    <details class="changelog-details"<%= releaseIndex === 0 ? ' open' : '' %>>
                                                        <summary class="changelog-summary">
                                                            <span class="changelog-version"><%= release.version %></span>
                                                            <% if (releaseIndex === 0) { %>
                                                                <span class="changelog-current-pill">Current</span>
                                                            <% } %>
                                                            <span class="changelog-count"><%= release.entries.length %> change<%= release.entries.length === 1 ? '' : 's' %></span>
                                                            <svg class="zr-icon" aria-hidden="true"><use href="/icons.svg#i-chevron-down"/></svg>
                                                        </summary>
                                                        <ul class="changelog-entries">
                                                            <% release.entries.forEach(function (entry) { %>
                                                                <%
                                                                    const meta = categoryMeta[entry.category] || categoryMeta.note;
                                                                %>
                                                                <li class="changelog-entry">
                                                                    <span class="changelog-badge changelog-badge--<%= entry.category %>">
                                                                        <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#<%= meta.icon %>"/></svg>
                                                                        <%= meta.label %>
                                                                    </span>
                                                                    <%# Entries are authored in config/changelog.js and may contain links, so they render as HTML. %>
                                                                    <span class="changelog-text"><%- entry.text %></span>
                                                                </li>
                                                            <% }); %>
                                                        </ul>
                                                    </details>
                                                </li>
                                            <% }); %>
                                        </ol>
                                    <% } %>
                                </section>
                        <%- entryClose() %>

                        <div class="zr-actionbar" id="settingsSaveRow" data-el="actionbar" data-dirty="false">
                            <span class="zr-actionbar__status" data-el="status">All changes saved</span>
                            <span class="zr-badge zr-badge--warn hidden" data-el="restart">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-refresh"/></svg>
                                restart required
                            </span>
                            <button type="button" class="zr-btn" data-el="reset" disabled>Discard</button>
                            <button type="submit" class="zr-btn zr-btn--primary" data-el="save">
                                <svg class="zr-icon zr-icon--sm" aria-hidden="true"><use href="/icons.svg#i-save"/></svg>
                                Save configuration
                            </button>
                        </div>
                    </form>
                    </div>
                </div>
            </div>

    <%- include('partials/restart-overlay') %>
    <%- include('partials/model-test-overlay') %>

    <script>
        window.__SETTINGS_BOOTSTRAP__ = {
            aiProviderPresets: <%- JSON.stringify(Array.isArray(aiProviderPresets) ? aiProviderPresets : []).replace(/</g, '\\u003c') %>,
            anthropic: <%- JSON.stringify(anthropic).replace(/</g, '\\u003c') %>
        };
    </script>
    <%- include('partials/scripts/settings-scripts') %>
    <script src="/js/settings.js?v=<%= version || 'dev' %>"></script>
    <%- include('partials/shell/body-close') %>
